config {
  type: "operations",
  dependencies: ["dim_company"],
  tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const DimWeightScoreTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimWeightScoreTableRef = `${DimWeightScoreTable.database}.${DimWeightScoreTable.schema}.${DimWeightScoreTable.name}`;

    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;

    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: "mds_dataset",
        name: "mds_data_custgrade_weight_score_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
}

BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  SET max_sk = (SELECT IFNULL(MAX(WeightSK), 0) FROM `${DimWeightScoreTableRef}`);

  MERGE `${DimWeightScoreTableRef}` AS T
  USING (
    SELECT
      (CASE
        WHEN t3.WeightSK IS NOT NULL THEN t3.WeightSK
        WHEN t2.WeightSK IS NOT NULL THEN t2.WeightSK
        ELSE max_sk + ROW_NUMBER() OVER(
          PARTITION BY (CASE WHEN t2.WeightSK IS NULL AND t3.WeightSK IS NULL THEN 1 ELSE 0 END)
          ORDER BY
            ${databuffet.functionData.cleanString("t1.CompanyID")},
            ${databuffet.functionData.cleanString("t1.Typeeng")},
            ${databuffet.functionData.cleanString("t1.Typethai")},
            t1.StartDate,
            t1.EndDate
        )
      END) AS WeightSK,
      dim_com.CompanySK,
      ${databuffet.functionData.cleanString("t1.CompanyID")} AS CompanyID,
      ${databuffet.functionData.cleanString("t1.Typeeng")} AS Typeeng,
      ${databuffet.functionData.cleanString("t1.Typethai")} AS Typethai,
      ${databuffet.functionData.castFloat64("t1.weight")} AS weight,
      ${databuffet.functionData.cleanString("t1.Remark")} AS Remark,
      t1.StartDate AS StartDate,
      t1.EndDate AS EndDate,
      ${databuffet.functionData.cleanString("t1.id")} as MdsID
    FROM `${MdsSourceTableRef}` AS t1
    LEFT JOIN `${DimCompanyTableRef}` AS dim_com
      ON ${databuffet.functionData.cleanString("t1.CompanyID")} = dim_com.companyID
    LEFT JOIN `${DimWeightScoreTableRef}` AS t2
      ON ${databuffet.functionData.cleanString("t1.CompanyID")} = t2.CompanyID
      AND ${databuffet.functionData.cleanString("t1.Typeeng")} = t2.Typeeng
      AND ${databuffet.functionData.cleanString("t1.Typethai")} = t2.Typethai
      AND t1.StartDate = t2.StartDate
      AND t1.EndDate = t2.EndDate
    LEFT JOIN `${DimWeightScoreTableRef}` AS t3
      ON ${databuffet.functionData.cleanString("t1.id")} = t3.MdsID
    WHERE t1.is_active = TRUE
      AND DATE(t1.updated_at) >= DATE_SUB(
            CURRENT_DATE("Asia/Bangkok"),
            INTERVAL ${databuffet.MDS_BACKFILL_DAYS} DAY
          )
  ) AS S
  ON T.WeightSK = S.WeightSK

  WHEN MATCHED THEN
    UPDATE SET
      T.weight = S.weight,
      T.Remark = S.Remark,
      T.StartDate = S.StartDate,
      T.EndDate = S.EndDate,
      T.MdsID = S.MdsID

  WHEN NOT MATCHED THEN
    INSERT (
      WeightSK,
      CompanySK,
      CompanyID,
      Typeeng,
      Typethai,
      weight,
      Remark,
      StartDate,
      EndDate,
      MdsID
    )
    VALUES (
      S.WeightSK,
      S.CompanySK,
      S.CompanyID,
      S.Typeeng,
      S.Typethai,
      S.weight,
      S.Remark,
      S.StartDate,
      S.EndDate,
      S.MdsID
    );

  DELETE FROM `${DimWeightScoreTableRef}`
  WHERE MdsID IN (
    SELECT id FROM `${MdsSourceTableRef}` WHERE is_active = FALSE
  );
END;
