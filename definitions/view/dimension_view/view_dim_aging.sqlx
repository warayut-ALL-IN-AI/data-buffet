config {
  type: "view",
  schema: databuffet.DIMENSION_VIEW,
  dependencies: ["dim_aging", "view_dim_channel", "dim_sale_representative_last", "dim_aging_rang"],
  tags: [databuffet.TAG_VIEW],
}

js {
    const DimAgingTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_aging",
    };
    const DimAgingTableRef = `${DimAgingTable.database}.${DimAgingTable.schema}.${DimAgingTable.name}`;

    const ViewDimChannelTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_VIEW,
        name: "view_dim_channel",
    };
    const ViewDimChannelTableRef = `${ViewDimChannelTable.database}.${ViewDimChannelTable.schema}.${ViewDimChannelTable.name}`;

    const DimSaleRepresentativeLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_sale_representative_last",
    };
    const DimSaleRepresentativeLastTableRef = `${DimSaleRepresentativeLastTable.database}.${DimSaleRepresentativeLastTable.schema}.${DimSaleRepresentativeLastTable.name}`;

    const DimAgingRangTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_aging_rang",
    };
    const DimAgingRangTableRef = `${DimAgingRangTable.database}.${DimAgingRangTable.schema}.${DimAgingRangTable.name}`;
}

with dim_agin_raw as (
  select 
    -- cfs.cfsdateid,
    dim_channel.ChannelSK,
    dim_channel.ChannelFinanceSK,
    dim_channel.ChannelSaleSK,
    dim_channel.ChannelCostSK,
    -- dim_sale.SaleRepSK,
    -- dim_sale.DepartmentSK,
    -- dim_sale.SectionSK,
    -- dim_sale.SectionManagerSK,
    -- dim_sale.RegionSK,
    -- dim_sale.RegionManagerSK,
    -- dim_sale.DirectorSK,
    dim_aging.*,

    (CASE 
      WHEN dim_aging.flagComplete = 'Completed' THEN (DATE_DIFF(CURRENT_DATE('Asia/Bangkok'), DATE(dim_aging.MinReceiveDate), DAY) - CAST(dim_aging.calCreditTerm AS INT64)) 
      ELSE (DATE_DIFF(CURRENT_DATE('Asia/Bangkok'), DATE(dim_aging.invoiceDate), DAY) - CAST(dim_aging.calCreditTerm AS INT64)) 
    END) as DayRange,

    DATE(dim_aging.invoiceDate) as cfsDate,

    (CASE 
      WHEN dim_aging.flagComplete = 'Completed' THEN DATE(dim_aging.MinReceiveDate)
      ELSE CAST(NULL as DATE)
    END) as minReceiptDate,
    
    (CASE 
      WHEN dim_aging.flagComplete = 'Completed' THEN DATE(dim_aging.MaxReceiveDate) 
      ELSE CAST(NULL as DATE)
    END) as maxReceiptDate,

    (CASE 
      WHEN dim_aging.flagComplete = 'Completed' THEN DATE_DIFF(DATE(dim_aging.MaxReceiveDate), DATE(dim_aging.invoiceDate), DAY)
      ELSE NULL
    END) as ReceiptAgeDays,
  
  from `${DimAgingTableRef}` as dim_aging
  left join `${ViewDimChannelTableRef}` as dim_channel
    on dim_aging.CompanySK = dim_channel.CompanySK
    and dim_aging.cfsDep = dim_channel.DepCode
  -- left join `${DimSaleRepresentativeLastTableRef}` as dim_sale
  --   on dim_aging.CompanySK = dim_sale.CompanySK
  --   and dim_aging.cfsDep = dim_sale.DepartmentID
  --   and	dim_aging.cfsPer = dim_sale.EmployeeID
  where dim_aging.cfsvnosid != 'BFCN020/47'
    -- and debcode = '111000689'
)

select distinct
  raw.AgingSK,
  dim_aging_rang.AgingRangSK,

  raw.* except(AgingSK, ReceiptAgeDays), 

  FIRST_VALUE(raw.ReceiptAgeDays IGNORE NULLS) OVER(
    PARTITION BY raw.debcode ORDER BY raw.ReceiptAgeDays
    ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
  )as minCustomerReceiptAgeDay,

  LAST_VALUE(raw.ReceiptAgeDays IGNORE NULLS) OVER(
    PARTITION BY raw.debcode ORDER BY raw.ReceiptAgeDays
    ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
  ) as maxCustomerReceiptAgeDay,
  
  ReceiptAgeDays
from dim_agin_raw as raw
-- aging range ต้องเป็นของบริษัทตัวเอง (ของเดิมเขียน `raw.CompanySK = raw.CompanySK`
-- เทียบกับตัวเอง = TRUE เสมอ ทำให้ทุกบริษัทไปใช้ช่วงของ ag01)
-- ตอนนี้ mds มี range เฉพาะ ag01 → aa05/ab01/ac02/ak02 จะได้ AgingRangSK = NULL
-- จนกว่า mds จะเพิ่ม range ให้บริษัทเหล่านั้น
left join `${DimAgingRangTableRef}` as dim_aging_rang
  on raw.CompanySK = dim_aging_rang.CompanySK
  and DayRange between dim_aging_rang.AgingDayMin and dim_aging_rang.AgingDayMax
qualify row_number() over(partition by raw.AgingSK order by ReceiptAgeDays desc) = 1
