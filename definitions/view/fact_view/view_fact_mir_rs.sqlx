config {
  type: "view",
  schema: databuffet.FACT_VIEW,
  dependencies: ["fact_mir_rs", "dim_aging"],
  tags: [databuffet.TAG_VIEW],
}

js {
    const FactMirRsTable = {
        database: databuffet.DATABASE,
        schema: databuffet.FACT_TABLE,
        name: "fact_mir_rs",
    };
    const FactMirRsTableRef = `${FactMirRsTable.database}.${FactMirRsTable.schema}.${FactMirRsTable.name}`;

    const DimAgingTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_aging",
    };
    const DimAgingTableRef = `${DimAgingTable.database}.${DimAgingTable.schema}.${DimAgingTable.name}`;
}

with t3 as (
  select company_id, mihtype, mihvnos, mihcancel, mihstatus
  from ${ref(databuffet.CURATED_MAC5, "curated_mih")}

)

select t2.AgingSK, t1.*  ,t3.mihcancel , t3.mihstatus , ars.ar_snamet
from `${FactMirRsTableRef}` as t1
left join `${DimAgingTableRef}` as t2
  on t1.mirbinvno = t2.cfsvnosid
  and t1.company_id = t2.CompanyID

left join t3 on t3.mihvnos = t1.mirvnos
    and t3.mihtype = t1.mirtype
    and t3.company_id = t1.company_id
left join ${ref(databuffet.VALIDATED_MAC5, "ar_s")} ars on t3.mihstatus = ars.ar_scode
    and t3.company_id = ars.company_id

-- join ด้วย cfsvnosid อย่างเดียว แต่ dim_aging มีได้หลายแถวต่อใบ (cfsTypeID ต่างกัน)
-- ถ้าไม่กันไว้ view จะเกินมา 4 แถว แล้ว ReceiveSK ไม่ unique อีกต่อไป → SUM เบิ้ล
qualify row_number() over(partition by t1.ReceiveSK order by t2.AgingSK desc) = 1
