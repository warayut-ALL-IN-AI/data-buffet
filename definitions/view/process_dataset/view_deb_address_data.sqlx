config {
  type: "view",
  schema: databuffet.PROCESS_DATASET,
  dependencies: ["deb_address_data"],
  tags: [databuffet.TAG_VIEW],
}

js {
    const DebAddressDataTable = {
        database: databuffet.DATABASE,
        schema: databuffet.PROCESS_DATASET,
        name: "deb_address_data",
    };
    const DebAddressDataTableRef = `${DebAddressDataTable.database}.${DebAddressDataTable.schema}.${DebAddressDataTable.name}`;

    const DimSubDistrictsTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_sub_districts",
    };
    const DimSubDistrictsTableRef = `${DimSubDistrictsTable.database}.${DimSubDistrictsTable.schema}.${DimSubDistrictsTable.name}`;

    const DimDistrictsTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_districts",
    };
    const DimDistrictsTableRef = `${DimDistrictsTable.database}.${DimDistrictsTable.schema}.${DimDistrictsTable.name}`;

    const DimProvincesTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_provinces",
    };
    const DimProvincesTableRef = `${DimProvincesTable.database}.${DimProvincesTable.schema}.${DimProvincesTable.name}`;
}

WITH raw_data as (
  SELECT *
  FROM `${DebAddressDataTableRef}` 
  where company_id = 'ag01'

), sub_districts as (
  select 
    sd.SubDistrictSK, sd.DistrictSK, sd.ProvinceSK,
    sd.name_th as sub_district_name,
    d.name_th as district_name,
    p.name_th as province_name,
  from `${DimSubDistrictsTableRef}` as sd
  left join `${DimDistrictsTableRef}` as d
    on sd.DistrictSK = d.DistrictSK
  left join `${DimProvincesTableRef}` as p
    on sd.ProvinceSK = p.ProvinceSK

), districts as (
  select 
    d.DistrictSK, d.ProvinceSK,
    d.name_th as district_name,
    p.name_th as province_name,
  from `${DimDistrictsTableRef}` as d
  left join `${DimProvincesTableRef}` as p
    on d.ProvinceSK = p.ProvinceSK

), sub_district as (
  select 
    'sub_districts' as condition,
    t.* except(info),
    sd.ProvinceSK,
    sd.DistrictSK,
    sd.SubDistrictSK,
    t.info.SubDistrictTH,
    t.info.SubDistrictEN,
    t.info.DistrictTH,
    t.info.DistrictEN,
    t.info.ProvinceTH,
    t.info.ProvinceEN,
  from raw_data as t
  inner join sub_districts as sd
    on (CASE
    when t.info.ProvinceTH is not null and t.info.DistrictTH is not null and t.info.SubDistrictTH is not null
      then t.info.ProvinceTH = sd.province_name and t.info.DistrictTH = sd.district_name and t.info.SubDistrictTH = sd.sub_district_name
    when t.info.DistrictTH is not null and t.info.SubDistrictTH is not null
      then t.info.DistrictTH = sd.district_name and t.info.SubDistrictTH = sd.sub_district_name
    when t.info.SubDistrictTH is not null
      then t.info.SubDistrictTH = sd.sub_district_name
  END)
  
), district as (
  select 
    'districts' as condition,
    t.* except(info),
    d.ProvinceSK,
    d.DistrictSK,
    null as SubDistrictSK,
    t.info.SubDistrictTH,
    t.info.SubDistrictEN,
    t.info.DistrictTH,
    t.info.DistrictEN,
    t.info.ProvinceTH,
    t.info.ProvinceEN,
  from raw_data as t
  inner join districts as d
    on (CASE 
      WHEN t.info.ProvinceTH is not null and t.info.DistrictTH is not null
        then t.info.ProvinceTH = d.province_name and t.info.DistrictTH = d.district_name
      WHEN t.info.DistrictTH is not null
        then t.info.DistrictTH = d.district_name
    END)
  where not exists (select 1 from sub_district as t2 where t.debcode = t2.debcode)

), province as (
  select 
    'provinces' as condition,
    t.* except(info),
    p.ProvinceSK,
    null as DistrictSK,
    null as SubDistrictSK,
    t.info.SubDistrictTH,
    t.info.SubDistrictEN,
    t.info.DistrictTH,
    t.info.DistrictEN,
    t.info.ProvinceTH,
    t.info.ProvinceEN,
  from raw_data as t
  inner join `${DimProvincesTableRef}` as p
    on t.info.ProvinceTH = p.name_th
  where not exists (select 1 from sub_district as t2 where t.debcode = t2.debcode)
    and not exists (select 1 from district as t2 where t.debcode = t2.debcode)

), mix_table as (
  select * from sub_district
  union all
  select * from district
  union all
  select * from province

)
  select 'invoice' as address_type, *
  from mix_table
