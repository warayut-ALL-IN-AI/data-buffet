config {
    type: "incremental",
    schema: databuffet.PROCESS_DATASET,
    dependencies: [],
    tags: [databuffet.TAG_FACT_DAILY],
    uniqueKey: ["debcode"],
    bigquery: {
        // partitionBy: "asatdate",
        clusterBy: ["debcode"],
        // updatePartitionFilter: "asatdate >= CURRENT_DATE('Asia/Bangkok')-7"
    }
}

WITH raw_data AS (
  SELECT 
    d.debcode,
    TRIM(CONCAT(IFNULL(d.debadd1at, ''), ' ', IFNULL(d.debadd2at, ''), ' ', IFNULL(d.debadd3at, ''))) AS raw_address
  FROM ${ref(databuffet.VALIDATED_MAC5, 'deb')} AS d
  WHERE d.debcode IN (
    SELECT DISTINCT JSON_VALUE(pk_fields, '$.debcode')
    FROM ${ref(databuffet.CDC_DATESET, 'cdc_change_log')} 
    WHERE source_system = 'mac5'
      AND source_schema = 'validated_mac5'
      AND source_table = 'deb'
      AND asatdate = CURRENT_DATE('Asia/Bangkok')
  )
  AND TRIM(IFNULL(CONCAT(IFNULL(d.debadd1at, ''), ' ', IFNULL(d.debadd2at, ''), ' ', IFNULL(d.debadd3at, '')), '')) != ''
)
  SELECT
    debcode,
    raw_address,
    AI.GENERATE(
      PROMPT => CONCAT(
        '''
        Role: Expert Thai Geographic Data Extractor.
        Task: Extract address components from the input text into the specified structured format.

        Instructions:
        1. Correct misspellings.
        2. Extract ONLY the name: Remove prefixes like "จ.", "จังหวัด", "อ.", "อำเภอ", "เขต", "ต.", "ตำบล", "แขวง".
        3. Provide English translations using standard Romanization.
        4. Validate the Postal Code (if present) against the province.
        
        CRITICAL: Return the values matching the output schema fields. 
        Do NOT return a Markdown table. Return raw string values for each field.
        ''',
        '\nInput Text: ', raw_address
      ),
      endpoint => 'gemini-2.5-flash',
      model_params => JSON '{"generation_config":{"temperature": 0.1}}',
      output_schema => 'SubDistrictTH STRING, SubDistrictEN STRING, DistrictTH STRING, DistrictEN STRING, ProvinceTH STRING, ProvinceEN STRING'
    ) AS info
  FROM raw_data