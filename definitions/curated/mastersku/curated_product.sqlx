config {
    type: "incremental",
    schema: databuffet.CURATED_SCHEMA + "_" + databuffet.SOURCE_MASTERSKU,
    dependencies: ["product"],
    tags: [databuffet.TAG_CURATED],
    uniqueKey: ["prdSku"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["prdSku", "prdUniversalBarcode", "prdVendorId", "prdBrandId"],
        updatePartitionFilter: "asatdate >= CURRENT_DATE('Asia/Bangkok')-7"
    }
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MASTERSKU,
        name: "product",
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Define all columns in one place
    const columns = [
        { name: "prdId", type: "STRING", source: "prd_id" },
        { name: "prdSku", type: "STRING", source: "prd_sku" },
        { name: "prdDescription", type: "STRING", source: "prd_description" },
        { name: "prdD365Sku", type: "STRING", source: "prd_d365_sku" },
        { name: "prdItemText", type: "STRING", source: "prd_item_text" },
        { name: "prdItemCode", type: "STRING", source: "prd_item_code" },
        { name: "prdStoppedSate", type: "STRING", source: "prd_stopped_sate" },
        { name: "prdMadeToOrder", type: "STRING", source: "prd_made_to_order" },
        { name: "prdSaleUnite", type: "STRING", source: "prd_sale_unite" },
        { name: "prdTag", type: "STRING", source: "prd_tag" },
        { name: "prdUniversalBarcode", type: "STRING", source: "prd_universal_barcode" },
        { name: "prdInternalBarcode", type: "STRING", source: "prd_internal_barcode" },
        { name: "prdCatId", type: "STRING", source: "prd_cat_id" },
        { name: "prdFilter1", type: "STRING", source: "prd_filter1" },
        { name: "prdFilter2", type: "STRING", source: "prd_filter2" },
        { name: "prdBrandId", type: "STRING", source: "prd_brand_id" },
        { name: "prdSize", type: "STRING", source: "prd_size" },
        { name: "prdLine", type: "STRING", source: "prd_line" },
        { name: "prdColorTH", type: "STRING", source: "prd_color" },
        { name: "prdColorEN", type: "STRING", source: "prd_color" },
        { name: "prdModel", type: "STRING", source: "prd_model" },
        { name: "prdDimension1", type: "STRING", source: "prd_dimension1" },
        { name: "prdDimension2", type: "STRING", source: "prd_dimension2" },
        { name: "prdDimension3", type: "STRING", source: "prd_dimension3" },
        { name: "prdDimension4", type: "STRING", source: "prd_dimension4" },
        { name: "prdVendorId", type: "STRING", source: "prd_vendor_id" },
        { name: "prdIsActive", type: "BOOLEAN", source: "prd_is_active" },
        { name: "prdIsUse", type: "BOOLEAN", source: "prd_is_use" },
        { name: "prdCreatedDate", type: "DATETIME", source: "prd_created_date" },
        { name: "prdCreatedBy", type: "STRING", source: "prd_created_by" },
        { name: "prdUpdatedDate", type: "DATETIME", source: "prd_updated_date" },
        { name: "prdUpdatedBy", type: "STRING", source: "prd_updated_by" },
        { name: "prdPgId", type: "STRING", source: "prd_pg_id" },
        { name: "prdPsId", type: "STRING", source: "prd_ps_id" },
        { name: "prdIdSource", type: "STRING", source: "prd_id_source" },
        { name: "prdMcId", type: "STRING", source: "prd_mc_id" },
        { name: "prdDiminsionData", type: "STRING", source: "prd_diminsion_data" },
        { name: "prdPasId", type: "STRING", source: "prd_pas_id" },
        { name: "prdBarcode", type: "STRING", source: "prd_barcode" },
        { name: "prdRejectRemark", type: "STRING", source: "prd_reject_remark" },
        { name: "prdRefMpId", type: "STRING", source: "prd_ref_mp_id" },
        { name: "prdIsCombo", type: "BOOLEAN", source: "prd_is_combo" },
        { name: "prdComboPrice", type: "FLOAT", source: "prd_combo_price" },
        { name: "prdIsTime", type: "BOOLEAN", source: "prd_is_time" },
        { name: "prdComboStart", type: "DATETIME", source: "prd_combo_start" },
        { name: "prdComboEnd", type: "DATETIME", source: "prd_combo_end" },
        { name: "prdTotalComboPrice", type: "FLOAT", source: "prd_total_combo_price" },
        { name: "prdTotalCostComboPrice", type: "FLOAT", source: "prd_total_cost_combo_price" },
        { name: "prdBarcodeFormat", type: "STRING", source: "prd_barcode_format" },
        { name: "asatdate", type: "DATE", source: "asatdate" },
    ];

    // Generate SELECT column mappings
    const selectColumns = columns
        .map(col => `  ${col.source} as ${col.name}`)
        .join(",\n");
}

SELECT
${selectColumns}
FROM ${sourceTableRef}
${ when(incremental(), `WHERE asatdate >= CURRENT_DATE('Asia/Bangkok')-1`) }
QUALIFY row_number() over(partition by prdSku order by prdUpdatedDate desc) = 1


post_operations {
    UPDATE `databuffet-nonprd.curated_mastersku.curated_product` t
    SET 
    t.prdColorTH = src.prdColorTH,
    t.prdColorEN = src.prdColorEN,
    t.prdSize = src.prdSize
    FROM (
        with rows_product as (
            SELECT 
                prdSku,
                JSON_VALUE(dimField, '$.label') as dimField_label,
                JSON_VALUE(dimField, '$.value') as dimField_value,
                JSON_VALUE(SpeciFeild, '$.label') as SpeciFeild_label,
                JSON_VALUE(SpeciFeild, '$.value') as SpeciFeild_value,
            FROM `databuffet-nonprd.validated_mastersku.product_detail` as pd
            INNER JOIN `databuffet-nonprd.curated_mastersku.curated_product` as p
                ON p.prdId = pd.pd_prd_id
            , UNNEST (JSON_QUERY_ARRAY(prdDiminsionData, '$.dimFeild'))  as dimField
            , UNNEST (JSON_QUERY_ARRAY(pd_spacific_fields, '$.SpeciFeild'))  as SpeciFeild
            ${ when(incremental(), `WHERE p.asatdate >= CURRENT_DATE('Asia/Bangkok')-1`) }
            -- WHERE p.prdSku in ('MSKU1000091280', 'MSKU0000024500', 'MSKU0000024833')

            ), arge_data as (
            select prdSku, 
                max((case 
                when lower(dimField_label) in ('ขนาด', 'size') then dimField_value
                else null
                end)) as dimField_prdSize,
                
                max((case 
                when lower(dimField_label) in ('สี', 'color') then dimField_value
                else null
                end)) as dimField_prdColor,
                
                max((case 
                when lower(SpeciFeild_label) in ('ขนาด', 'size') then SpeciFeild_value
                else null
                end)) as SpeciFeild_prdSize,
                
                max((case 
                when lower(SpeciFeild_label) in ('สี', 'color') then SpeciFeild_value
                else null
                end)) as SpeciFeild_prdColor,
            from rows_product
            group by prdSku
            having dimField_prdSize is not null or dimField_prdColor is not null or SpeciFeild_prdSize is not null or SpeciFeild_prdColor is not null
            
            ), cleaning_data as (
            select 
                prdSku,
                IFNULL(dimField_prdSize, SpeciFeild_prdSize) as prdSize,
                IFNULL(dimField_prdColor, SpeciFeild_prdColor) as prdColor
            from arge_data

            )
            SELECT  
                prdSku, 
                prdSize,
                (CASE 
                    WHEN REGEXP_CONTAINS(SPLIT(prdColor, ' ')[SAFE_OFFSET(0)], r'[ก-๙]') 
                        THEN TRIM(REGEXP_EXTRACT(prdColor, r'^([ก-๙\s]+)'))
                    ELSE NULL
                END) AS prdColorTH,                
                (CASE 
                    WHEN NOT REGEXP_CONTAINS(SPLIT(prdColor, ' ')[SAFE_OFFSET(0)], r'[ก-๙]') 
                        THEN NULLIF(TRIM(prdColor), '')
                    ELSE TRIM(REGEXP_REPLACE(prdColor, r'^([ก-๙\s]+)', '')) 
                END) AS prdColorEN
            FROM cleaning_data
    ) src
    WHERE t.prdSku = src.prdSku;

}
