config {
    type: "incremental",
    schema: databuffet.CURATED_MAC5,
    dependencies: ["curated_schema_mac5"],
    tags: [databuffet.TAG_CURATED],
    uniqueKey: ["company_id", "running"],
    bigquery: {
        // partitionBy: "asatdate",
        clusterBy: ["company_id", "running", "cashstatus", "cancel"],
    }
}

select
    company_id as company_id,
    id as ID,
    running as Running,
    atten as Atten,
    address as Address,
    sdate as SDate,
    project as Project,
    tel as TelePhone,
    sale as Sale,
    price_validity as PriceValidity,
    termdelivery as TermDelivery,
    termpayment as TermPayment,
    uinsert as UInsert,
    dinsert as DInsert,
    uupdate as UUpdate,
    dupdate as Dupdate,
    agent1 as Agent1,
    agent2 as Agent2,
    period as Period,
    pos as Position,
    vat as Vat,
    disc as Disc,
    extrasum as ExtraSum,
    extradesc as ExtraDesc,
    date1st as DateStart1,
    date1end as DateEnd1,
    date2st as DateStart2,
    date2end as DateEnd2,
    cashstatus as CashStatus,
    note as Note,
    noteforapp as NoteForApp,
    memoforapp as MemoForApp,
    rev as Rev,
    typecus as TypeCus,
    channel as Channel,
    channel2 as Channel2,
    typeprice as TypePrice,
    fob as FOB,
    cancel as Cancel,
    apptype as AppType,
    typedeb as TypeDeb,
    saledep as SaleDep,
    typeproject as TypeProject,
    selectstatus as SelectStatus,
    conpostatus as ConpoStatus,
    lat as Lat,
    long as Long,
    mapnote as MapNote,
    fileupload as FileUpload,
    city as City,
    rdosend as RdoSend,
    cname as CustomerName,
    ctel as CustomerTelePhone,
    caddress as CustomerAddress,
    checknote as CheckNote,
    textnote as TextNote,
    statusspread as StatusSpread,
    chkbox as ChkBox,
    fobstt as FobStt,
    quotation_ref as QuotationRef,
    customer_id as CustomerId,
    customer_group as CustomerGroup,
    quotation_id as QuotationId,
    estatus as EStatus,
    area as Area,
    district as District,
    postcode as PostCode,
    qtstepprice as QtStepPrice,
    extradis as ExtraDis,
from ${ref(databuffet.VALIDATED_MAC5, "tbook_quotation")}
-- where company_id = 'ag01'
qualify row_number() over(partition by company_id, running order by rev desc, id desc) = 1

-- ${ when(incremental(), `WHERE mih.asatdate >= CURRENT_DATE('Asia/Bangkok')-1`) }
