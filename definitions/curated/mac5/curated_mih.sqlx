config {
    type: "incremental",
    schema: databuffet.CURATED_SCHEMA + "_" + databuffet.SOURCE_MAC5,
    dependencies: ["mih"],
    tags: [databuffet.TAG_CURATED],
    uniqueKey: ["mihDay", "mihMonth", "mihYear", "mihType", "mihVnos"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["mihVnos", "mihCus", "mihType", "mihYear"],
        updatePartitionFilter: "asatdate >= CURRENT_DATE('Asia/Bangkok')-7"
    }
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MAC5,
        name: "mih",
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

}

SELECT
    mihday as mihDay,
    mihmonth as mihMonth,
    mihyear as mihYear,
    mihtype as mihType,
    mihvnos as mihVnos,
    mihcus as mihCus,
    mihjob as mihJob,
    mihdep as mihDep,
    mihper as mihPer,
    mihdoc as mihDoc,
    mihmec as mihMec,
    mihvatno as mihVatno,
    mihdesc as mihDesc,
    mihmemo as mihMemo,
    mihnotes as mihNotes,
    mihref1 as mihRef1,
    mihref2 as mihRef2,
    mihref3 as mihRef3,
    mihdischt1 as mihDischt1,
    mihdischt2 as mihDischt2,
    mihdelvsite as mihDelvsite,
    mihdelvdate as mihDelvdate,
    mihstanding as mihStanding,
    mihlinkgl as mihLinkgl,
    mihnouplink as mihNouplink,
    mihnolist as mihNolist,
    mihcurc as mihCurc,
    mihvatinlist as mihVatinlist,
    mihlock as mihLock,
    mihprintn as mihPrintn,
    mihcheque as mihCheque,
    mihcancel as mihCancel,
    mihstatus as mihStatus,
    mihclearum as mihClearum,
    mihctermno as mihCtermno,
    mihcog as mihCog,
    mihvatsum as mihVatsum,
    mihnetsum as mihNetsum,
    mihdisclst as mihDisclst,
    mihdischf1 as mihDischf1,
    mihdischf2 as mihDischf2,
    mihexchg as mihExchg,
    mihextrasum as mihExtrasum,
    mihextravat as mihExtravat,
    mihextracut as mihExtracut,
    mihextramem as mihExtramem,
    mihrecno as mihRecno,
    mihrecdate as mihRecdate,
    mihsavetag as mihSavetag,
    mihkeyuser as mihKeyuser,
    mihkeydate as mihKeydate,
    mihdocrunno as mihDocrunno,
    mihdategl as mihDategl,
    mihduepo as mihDuepo,
    miheditlk as mihEditlk,
    mihiscf as mihIscf,
    mihissp as mihIssp,
    mihdates1 as mihDates1,
    mihdates2 as mihDates2,
    mihnumsi as mihNumsi,
    mihnumsc as mihNumsc,
    mihvatpc as mihVatpc,
    mihincluded as mihIncluded,
    mihtaxvnos as mihTaxvnos,
    mihtaxdate as mihTaxdate,
    mihtaxsum as mihTaxsum,
    mihload as mihLoad,
    mihpaiddate as mihPaiddate,
    mihbookordernum as mihBookordernum,
    mihsenddate as mihSenddate,
    mihbl as mihBl,
    mihrpv as mihRpv,
    mihclearcut as mihClearcut,
    mihsettlecut as mihSettlecut,
    rowguid as rowguid,
    moddate as moddate,
    mihmemo_new as mihMemoNew,
    memo_extract as memoExtract,
    asatdate as asatdate
FROM ${sourceTableRef}
${ when(incremental(), `WHERE asatdate >= CURRENT_DATE('Asia/Bangkok')-1`) }
