config {
    type: "incremental",
    schema: databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MAC5,
    dependencies: [...databuffet.dependencies[databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MAC5]],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_INCREMENTAL],
    uniqueKey: [...databuffet.primaryKeys[databuffet.SOURCE_MAC5]["mih2"]],
    bigquery: {
        clusterBy: []
    },
}

js {
    const project_id = databuffet.DATABASE
    const dataset_id = databuffet.RAW_SCHEMA + "_" + databuffet.SOURCE_MAC5
    const table_id = name()
    const pk_key = databuffet.primaryKeys[databuffet.SOURCE_MAC5]["mih2"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY ASATDATE DESC) = 1`;
        post_operations_statement = `ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
    ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  CAST(MIH2day AS INT64) AS mih2day,
  CAST(MIH2month AS INT64) AS mih2month,
  CAST(MIH2year AS INT64) AS mih2year,
  CAST(MIH2type AS STRING) AS mih2type,
  CAST(MIH2vnos AS STRING) AS mih2vnos,
  CAST(MIH2cus AS STRING) AS mih2cus,
  CAST(MIH2rev AS INT64) AS mih2rev,
  CAST(MIH2shpid AS INT64) AS mih2shpid,
  CAST(MIH2POnum AS STRING) AS mih2ponum,
  CAST(MIH2POstat AS INT64) AS mih2postat,
  CAST(MIH2PERpc AS STRING) AS mih2perpc,
  CAST(MIH2PER2 AS STRING) AS mih2per2,
  CAST(MIH2PER2pc AS STRING) AS mih2per2pc,
  CAST(MIH2POprice AS FLOAT64) AS mih2poprice,
  CAST(MIH2DiscExtraNo AS STRING) AS mih2discextrano,
  CAST(MIH2projectname AS STRING) AS mih2projectname,
  CAST(MIH2shipto_addr_no AS STRING) AS mih2shipto_addr_no,
  CAST(MIH2shipto_addr_soi AS STRING) AS mih2shipto_addr_soi,
  CAST(MIH2shipto_addr_road AS STRING) AS mih2shipto_addr_road,
  CAST(MIH2shipto_addr_tambol AS STRING) AS mih2shipto_addr_tambol,
  CAST(MIH2shipto_addr_amphur AS STRING) AS mih2shipto_addr_amphur,
  CAST(MIH2shipto_addr_province AS STRING) AS mih2shipto_addr_province,
  CAST(MIH2shipto_receiver1_name AS STRING) AS mih2shipto_receiver1_name,
  CAST(MIH2shipto_receiver1_tel AS STRING) AS mih2shipto_receiver1_tel,
  CAST(MIH2shipto_receiver2_name AS STRING) AS mih2shipto_receiver2_name,
  CAST(MIH2shipto_receiver2_tel AS STRING) AS mih2shipto_receiver2_tel,
  CAST(MIH2pos AS STRING) AS mih2pos,
  CAST(MIH2co_name AS STRING) AS mih2co_name,
  CAST(MIH2co_tel AS STRING) AS mih2co_tel,
  CAST(MIH2co_fax AS STRING) AS mih2co_fax,
  CAST(MIH2goods_receiver AS STRING) AS mih2goods_receiver,
  CAST(MIH2goods_receiver_pos AS STRING) AS mih2goods_receiver_pos,
  CAST(MIH2goods_to AS STRING) AS mih2goods_to,
  CAST(MIH2goods_to_tel AS STRING) AS mih2goods_to_tel,
  CAST(MIH2goods_to_fax AS STRING) AS mih2goods_to_fax,
  CAST(MIH2cus_type AS STRING) AS mih2cus_type,
  CAST(MIH2cus_tel AS STRING) AS mih2cus_tel,
  CAST(MIH2cus_fax AS STRING) AS mih2cus_fax,
  CAST(MIH2cus_addr AS STRING) AS mih2cus_addr,
  CAST(MIH2cus_com AS STRING) AS mih2cus_com,
  CAST(MIH2cus_name AS STRING) AS mih2cus_name,
  CAST(MIH2cushp_name AS STRING) AS mih2cushp_name,
  CAST(MIH2cus_code AS STRING) AS mih2cus_code,
  CAST(MIH2cus_com_stat AS STRING) AS mih2cus_com_stat,
  CAST(MIH2cus_b AS STRING) AS mih2cus_b,
  CAST(MIH2cusgrp AS STRING) AS mih2cusgrp,
  CAST(MIH2gp AS FLOAT64) AS mih2gp,
  CAST(MIH2gppercen AS STRING) AS mih2gppercen,
  CAST(MIH2install AS FLOAT64) AS mih2install,
  CAST(MIH2trans AS FLOAT64) AS mih2trans,
  CAST(MIH2sumarea AS STRING) AS mih2sumarea,
  CAST(MIH2sumquan AS STRING) AS mih2sumquan,
  CAST(MIH2notes AS STRING) AS mih2notes,
  CAST(MIH2hpstat AS STRING) AS mih2hpstat,
  CAST(MIH2comval AS FLOAT64) AS mih2comval,
  CAST(MIH2comper AS FLOAT64) AS mih2comper,
  CAST(MIH2cost AS STRING) AS mih2cost,
  CAST(MIH2projtype AS STRING) AS mih2projtype,
  CAST(MIH2projtype2 AS STRING) AS mih2projtype2,
  CAST(MIH2mip AS STRING) AS mih2mip,
  CAST(MIH2custype AS STRING) AS mih2custype,
  CAST(MIH2spc1 AS STRING) AS mih2spc1,
  CAST(MIH2spc2 AS STRING) AS mih2spc2,
  CAST(MIH2spc3 AS STRING) AS mih2spc3,
  CAST(MIH2spc4 AS STRING) AS mih2spc4,
  CAST(MIH2spc5 AS STRING) AS mih2spc5,
  CAST(MIH2spc6 AS STRING) AS mih2spc6,
  CAST(MIH2spc7 AS STRING) AS mih2spc7,
  CAST(MIH2spc8 AS STRING) AS mih2spc8,
  CAST(MIH2spc9 AS STRING) AS mih2spc9,
  CAST(MIH2spc10 AS STRING) AS mih2spc10,
  CAST(MIH2spc11 AS STRING) AS mih2spc11,
  CAST(MIH2spc12 AS STRING) AS mih2spc12,
  CAST(MIH2wty AS STRING) AS mih2wty,
  CAST(MIH2tenwhe AS STRING) AS mih2tenwhe,
  CAST(MIH2sixwhe AS STRING) AS mih2sixwhe,
  CAST(MIH2picup AS STRING) AS mih2picup,
  CAST(MIH2car AS STRING) AS mih2car,
  CAST(MIH2mtc AS STRING) AS mih2mtc,
  CAST(MIH2olddoor AS STRING) AS mih2olddoor,
  CAST(MIH2oldwall AS STRING) AS mih2oldwall,
  CAST(MIH2oldrang AS STRING) AS mih2oldrang,
  CAST(MIH2oldmotor AS STRING) AS mih2oldmotor,
  CAST(MIH2payment1 AS STRING) AS mih2payment1,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2paydate1, 1, 19)) AS mih2paydate1,
  CAST(MIH2payment2 AS STRING) AS mih2payment2,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2paydate2, 1, 19)) AS mih2paydate2,
  CAST(MIH2payment3 AS STRING) AS mih2payment3,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2paydate3, 1, 19)) AS mih2paydate3,
  CAST(MIH2payinstall AS STRING) AS mih2payinstall,
  CAST(MIH2billname AS STRING) AS mih2billname,
  CAST(MIH2accname AS STRING) AS mih2accname,
  CAST(MIH2foottel AS STRING) AS mih2foottel,
  CAST(MIH2footfax AS STRING) AS mih2footfax,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2billdate, 1, 19)) AS mih2billdate,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2chequedate, 1, 19)) AS mih2chequedate,
  CAST(MIH2employno AS STRING) AS mih2employno,
  CAST(MIH2foreman AS STRING) AS mih2foreman,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2sendto, 1, 19)) AS mih2sendto,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2complete, 1, 19)) AS mih2complete,
  CAST(MIH2employee AS STRING) AS mih2employee,
  CAST(MIH2empaddr AS STRING) AS mih2empaddr,
  CAST(MIH2plnhouse AS STRING) AS mih2plnhouse,
  CAST(MIH2lbl1 AS STRING) AS mih2lbl1,
  CAST(MIH2lbl2 AS STRING) AS mih2lbl2,
  CAST(MIH2lbl3 AS STRING) AS mih2lbl3,
  CAST(MIH2lbl4 AS STRING) AS mih2lbl4,
  CAST(MIH2lbl5 AS STRING) AS mih2lbl5,
  CAST(MIH2lbl6 AS STRING) AS mih2lbl6,
  CAST(MIH2txt1 AS FLOAT64) AS mih2txt1,
  CAST(MIH2txt2 AS FLOAT64) AS mih2txt2,
  CAST(MIH2txt3 AS FLOAT64) AS mih2txt3,
  CAST(MIH2txt4 AS FLOAT64) AS mih2txt4,
  CAST(MIH2txt5 AS FLOAT64) AS mih2txt5,
  CAST(MIH2txt6 AS FLOAT64) AS mih2txt6,
  CAST(MIH2txt7 AS FLOAT64) AS mih2txt7,
  CAST(MIH2txt8 AS FLOAT64) AS mih2txt8,
  CAST(MIH2txt9 AS FLOAT64) AS mih2txt9,
  CAST(MIH2txt10 AS FLOAT64) AS mih2txt10,
  CAST(MIH2status AS INT64) AS mih2status,
  CAST(MIH2hw1 AS INT64) AS mih2hw1,
  CAST(MIH2hw2 AS INT64) AS mih2hw2,
  CAST(MIH2hw3 AS INT64) AS mih2hw3,
  CAST(MIH2hw4 AS INT64) AS mih2hw4,
  CAST(MIH2hw5 AS INT64) AS mih2hw5,
  CAST(MIH2hw6 AS INT64) AS mih2hw6,
  CAST(MIH2hw7 AS INT64) AS mih2hw7,
  CAST(MIH2hw8 AS INT64) AS mih2hw8,
  CAST(MIH2hw9 AS INT64) AS mih2hw9,
  CAST(MIH2hw10 AS INT64) AS mih2hw10,
  CAST(MIH2hw11 AS INT64) AS mih2hw11,
  CAST(MIH2hw12 AS INT64) AS mih2hw12,
  CAST(MIH2hw13 AS INT64) AS mih2hw13,
  CAST(MIH2hw14 AS INT64) AS mih2hw14,
  CAST(MIH2hw15 AS INT64) AS mih2hw15,
  CAST(MIH2hwrem AS STRING) AS mih2hwrem,
  CAST(MIH2desc AS STRING) AS mih2desc,
  CAST(MIH2updateby AS STRING) AS mih2updateby,
  CAST(MIH2updatenameT AS STRING) AS mih2updatenamet,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2crdate, 1, 19)) AS mih2crdate,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2updatedate, 1, 19)) AS mih2updatedate,
  CAST(rowguid AS STRING) AS rowguid,
  CAST(PaymentStatus AS INT64) AS paymentstatus,
  CAST(CondPack AS INT64) AS condpack,
  CAST(InstallStatus AS STRING) AS installstatus,
  CAST(Inv_Percen AS FLOAT64) AS inv_percen,
  CAST(MaxRev AS INT64) AS maxrev,
  CAST(MIH2vnos_Core AS STRING) AS mih2vnos_core,
  CAST(PROJCODE AS STRING) AS projcode,
  CAST(TranStatus AS STRING) AS transtatus,
  CAST(PackStatus AS STRING) AS packstatus,
  CAST(BomInstallStatus AS STRING) AS bominstallstatus,
  CAST(MustInstall AS INT64) AS mustinstall,
  CAST(Direction AS INT64) AS direction,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(POexpireDate, 1, 19)) AS poexpiredate,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(InsFinishDate, 1, 19)) AS insfinishdate,
  CAST(SendCustHome AS INT64) AS sendcusthome,
  PARSE_DATE('%Y%m%d', ASATDATE) AS asatdate
FROM
  `${project_id}.${dataset_id}.${table_id}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

  -- pre_operations {}
post_operations {
    ${post_operations_statement}
}
