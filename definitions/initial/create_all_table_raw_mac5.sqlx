config {
  type: "operations",
  dependencies: ["drop_all_tables_raw_mac5"],
  tags: [databuffet.TAG_INITIAL],
}

CREATE SCHEMA IF NOT EXISTS `${databuffet.DATABASE}.${databuffet.RAW_SCHEMA}_${databuffet.SOURCE_MAC5}` OPTIONS(location="${databuffet.REGION}")
;


