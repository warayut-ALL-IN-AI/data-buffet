config {
  type: "operations",
  dependencies: ["curated_mih", "curated_mil"],
  tags: [databuffet.TAG_FACT_DAILY],
}

BEGIN
  CREATE OR REPLACE TEMP TABLE temp_fact_transaction 
  AS
  WITH raw_transction as (
    SELECT 
      *, 
      PARSE_DATE('%Y%m%d', CONCAT(milYear, FORMAT("%02d", milMonth), FORMAT("%02d", milDay))) as mix_date
    FROM databuffet-nonprd.onetime.Transaction_Data_Mart
    WHERE asatdate BETWEEN DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL 1 YEAR) AND CURRENT_DATE('Asia/Bangkok')
      -- AND milVnos = '6611006411'

  ), final as (
    select 
      -- Surrogate Key
      sale_sk.SaleRepSK,
      dep_sk.DepartmentSK,
      reg_sk.RegionSK,
      reg_m_sk.RegionManagerSK,
      sec_sk.SectionSK,
      sec_m_sk.SectionManagerSK,
      dir_sk.DirectorSK,

      -- Relation
      -- tran.milPer,
      -- sale_sk.EmployeeID,
      -- dep_sk.DepartmentID,
      -- reg_sk.RegionID,
      -- sec_sk.SectionID,
      -- dir_sk.DirectorID,
      -- reg_m_sk.RegionID,
      -- sec_m_sk.SectionID,

      -- DATA
      tran.*
    from raw_transction as tran
    -- SaleRepSK
    left join databuffet-nonprd.dimension_table.dim_sale_representative as sale_sk
      on mix_date between sale_sk.StartDate and sale_sk.EndDate
        and TRIM(tran.milPer) = TRIM(sale_sk.EmployeeID)

    -- DepartmentSK
    left join databuffet-nonprd.dimension_table.dim_department as dep_sk
      on mix_date between dep_sk.StartDate and dep_sk.EndDate
        and sale_sk.DepartmentID = dep_sk.DepartmentID

    -- RegionSK
    left join databuffet-nonprd.dimension_table.dim_region as reg_sk
      on mix_date between reg_sk.StartDate and reg_sk.EndDate
        and dep_sk.RegionID = reg_sk.RegionID

    -- RegionManagerSK
    left join databuffet-nonprd.dimension_table.dim_region_manager as reg_m_sk
      on mix_date between reg_m_sk.StartDate and reg_m_sk.EndDate
        and reg_sk.RegionID = reg_m_sk.RegionID

    -- SectionSK
    left join databuffet-nonprd.dimension_table.dim_section as sec_sk
      on mix_date between sec_sk.StartDate and sec_sk.EndDate
        and dep_sk.SectionID = sec_sk.SectionID

    -- SectionManagerSK
    left join databuffet-nonprd.dimension_table.dim_section_manager as sec_m_sk
      on mix_date between sec_m_sk.StartDate and sec_m_sk.EndDate
        and sec_sk.SectionID = sec_m_sk.SectionID

    -- DirectorSK
    left join databuffet-nonprd.dimension_table.dim_director as dir_sk
      on mix_date between dir_sk.StartDate and dir_sk.EndDate
        and reg_sk.DirectorID = dir_sk.DirectorID

  )
    select 
      *
    from final
  ;

  BEGIN    
    DELETE FROM `databuffet-nonprd.fact_table.fact_transaction` AS T
    WHERE EXISTS (
        SELECT 1 
        FROM temp_fact_transaction AS S 
        WHERE T.milDay = S.milDay
          AND T.milMonth = S.milMonth
          AND T.milYear = S.milYear
          AND T.milVnos = S.milVnos
          AND T.milType = S.milType
          AND T.milCus = S.milCus
          AND T.milPer = S.milPer
          AND T.milListno = S.milListno
    )
    ;
  END;

  BEGIN
    INSERT INTO `databuffet-nonprd.fact_table.fact_transaction` 
    SELECT * FROM temp_fact_transaction
    ;
  END;

END;

BEGIN
  DELETE FROM databuffet-nonprd.fact_table.fact_transaction
  WHERE mix_date < DATE_TRUNC(DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL 3 YEAR), YEAR)
  ;
END;