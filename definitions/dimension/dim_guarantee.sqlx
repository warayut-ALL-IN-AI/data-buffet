config {
  type: "operations",
  dependencies: ["dim_company"],
  tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const DimGuaranteeTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimGuaranteeTableRef = `${DimGuaranteeTable.database}.${DimGuaranteeTable.schema}.${DimGuaranteeTable.name}`;

    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;

    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: "mds_dataset",
        name: "mds_data_guarantee_document_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
}

BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  SET max_sk = (SELECT IFNULL(MAX(GuaranteeSK), 0) FROM `${DimGuaranteeTableRef}`);

  MERGE `${DimGuaranteeTableRef}` AS T
  USING (
    SELECT
      (CASE
        WHEN t2.GuaranteeSK IS NOT NULL THEN t2.GuaranteeSK
        ELSE max_sk + ROW_NUMBER() OVER(
          PARTITION BY (CASE WHEN t2.GuaranteeSK IS NULL THEN 1 ELSE 0 END)
          ORDER BY
            ${databuffet.functionData.cleanString("t1.CompanyID")},
            ${databuffet.functionData.cleanString("t1.CustomerCode")}
        )
      END) AS GuaranteeSK,
      dim_com.CompanySK,
      ${databuffet.functionData.cleanString("t1.CompanyID")} AS CompanyID,
      ${databuffet.functionData.cleanString("t1.Region")} AS Region,
      ${databuffet.functionData.cleanString("t1.CustomerCode")} AS CustomerCode,
      ${databuffet.functionData.cleanString("t1.CustomerName")} AS CustomerName,
      t1.ExpiryDate AS ExpiryDate,
      ${databuffet.functionData.cleanString("t1.BankName")} AS BankName,
      ${databuffet.functionData.castFloat64("t1.BG_Limit")} AS BG_Limit,
      ${databuffet.functionData.cleanString("t1.Renewal")} AS Renewal,
      ${databuffet.functionData.cleanString("t1.Remarks")} AS Remarks,
      ${databuffet.functionData.cleanString("t1.Address")} AS Address,
      ${databuffet.functionData.cleanString("t1.PhoneNumber")} AS PhoneNumber,
      ${databuffet.functionData.cleanString("t1.FAX")} AS FAX
    FROM `${MdsSourceTableRef}` AS t1
    LEFT JOIN `${DimCompanyTableRef}` AS dim_com
      ON ${databuffet.functionData.cleanString("t1.CompanyID")} = dim_com.companyID
    LEFT JOIN `${DimGuaranteeTableRef}` AS t2
      ON ${databuffet.functionData.cleanString("t1.CompanyID")} = t2.CompanyID
      AND ${databuffet.functionData.cleanString("t1.CustomerCode")} = t2.CustomerCode
    WHERE t1.is_active = TRUE
      AND DATE(t1.updated_at) >= DATE_SUB(
            CURRENT_DATE("Asia/Bangkok"),
            INTERVAL ${databuffet.MDS_BACKFILL_DAYS} DAY
          )
  ) AS S
  ON T.GuaranteeSK = S.GuaranteeSK

  WHEN MATCHED THEN
    UPDATE SET
      T.Region = S.Region,
      T.CustomerName = S.CustomerName,
      T.ExpiryDate = S.ExpiryDate,
      T.BankName = S.BankName,
      T.BG_Limit = S.BG_Limit,
      T.Renewal = S.Renewal,
      T.Remarks = S.Remarks,
      T.Address = S.Address,
      T.PhoneNumber = S.PhoneNumber,
      T.FAX = S.FAX

  WHEN NOT MATCHED THEN
    INSERT (
      GuaranteeSK,
      CompanySK,
      CompanyID,
      Region,
      CustomerCode,
      CustomerName,
      ExpiryDate,
      BankName,
      BG_Limit,
      Renewal,
      Remarks,
      Address,
      PhoneNumber,
      FAX
    )
    VALUES (
      S.GuaranteeSK,
      S.CompanySK,
      S.CompanyID,
      S.Region,
      S.CustomerCode,
      S.CustomerName,
      S.ExpiryDate,
      S.BankName,
      S.BG_Limit,
      S.Renewal,
      S.Remarks,
      S.Address,
      S.PhoneNumber,
      S.FAX
    );
END;
