config {
  type: "operations",
  dependencies: ["dim_order"],
  tags: [databuffet.TAG_DIM_DAILY],
  hasOutput: true
}

js {
    // Define table references
    const DimInvoiceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimInvoiceTableRef = `${DimInvoiceTable.database}.${DimInvoiceTable.schema}.${DimInvoiceTable.name}`;

    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;

    const DimOrderTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_order",
    };
    const DimOrderTableRef = `${DimOrderTable.database}.${DimOrderTable.schema}.${DimOrderTable.name}`;
    
}

-- 2. เริ่มกระบวนการ MERGE
MERGE `${DimInvoiceTableRef}` T
USING (
    WITH mih_raw as (
        SELECT
          mih.company_id,
          mihDay, mihMonth, mihYear, mihType, mihVnos, mihCus, mihRef1, mihRef2, mihPer, mihStatus,
          (CASE
            WHEN mihType in ('QS', 'PS', 'IS', 'AS', 'BS', 'VS', 'RS') THEN ar_snamet
            WHEN mihType in ('QP', 'PP', 'IP', 'AP', 'BP', 'VP', 'RP') THEN ap_snamet
            ELSE null
          END) as StatusDesc,
          mihCancel,mihDep,mihJob
        FROM ${ref(databuffet.CURATED_MAC5, 'curated_mih')} as mih
        left join ${ref(databuffet.VALIDATED_MAC5, 'ar_s')} as ar_s 
          on mih.mihStatus = ar_s.ar_scode 
          AND mih.company_id = ar_s.company_id
        left join ${ref(databuffet.VALIDATED_MAC5, 'ap_s')} as ap_s 
          on mih.mihStatus = ap_s.ap_scode 
          AND mih.company_id = ap_s.company_id
        WHERE mih.mihType = 'IS'
          and mih.mihRef1 is not null
          and mih.mihCancel <> -1
          and mih.asatdate >= current_date('Asia/Bangkok')-1
        --   and mih.company_id = 'ag01'
    ),
    mih_raw2 as (
        SELECT
          mih.company_id,
          mih.mihDay, mih.mihMonth, mih.mihYear, mih.mihType, mih.mihVnos, mih.mihCus, mih.mihRef1, mih.mihRef2, mih.mihPer, mih.mihStatus,
          (CASE
            WHEN mih.mihType in ('QS', 'PS', 'IS', 'AS', 'BS', 'VS', 'RS') THEN ar_s.ar_snamet
            WHEN mih.mihType in ('QP', 'PP', 'IP', 'AP', 'BP', 'VP', 'RP') THEN ap_s.ap_snamet
            ELSE null
          END) as StatusDesc,
          mih.mihCancel, mih.mihDep, mih.mihJob
        FROM ${ref(databuffet.CURATED_MAC5, 'curated_mih')} as mih
        left join ${ref(databuffet.VALIDATED_MAC5, 'ar_s')} as ar_s 
          on mih.mihStatus = ar_s.ar_scode 
          AND mih.company_id = ar_s.company_id
        left join ${ref(databuffet.VALIDATED_MAC5, 'ap_s')} as ap_s 
          on mih.mihStatus = ap_s.ap_scode 
          AND mih.company_id = ap_s.company_id
        WHERE mih.asatdate >= current_date('Asia/Bangkok')-1
            -- and mih.company_id = 'ag01'

    ), 
    filter_mih2 as (
        SELECT DISTINCT
          mih2.company_id,
          mih2vnos, mih2cus, mih2per2, mih2rev, mih2perpc,mih2per2pc,
          CAST(NULLIF(REPLACE(REGEXP_REPLACE(mih2perpc, r'[^0-9.%]', ''), '%', ''), '') AS FLOAT64) as per_sale1,
          CAST(NULLIF(REPLACE(REGEXP_REPLACE(mih2per2pc, r'[^0-9.%]', ''), '%', ''), '') AS FLOAT64) as per_sale2,
          row_number() over(partition by mih2vnos, mih2cus order by mih2rev desc) as chk_row
        FROM ${ref(databuffet.VALIDATED_MAC5, 'mih2')} as mih2
        WHERE mih2.company_id = 'ag01'
          and mih2cus is not null
          and mih2per2 is not null
          and mih2per2pc is not null
          and (mih2perpc <> '100%' and mih2perpc <> '00%')
          and EXISTS (
            SELECT 1 FROM mih_raw as mih 
            WHERE mih2.mih2type = 'PS'
              and mih2.mih2vnos = mih.mihref1
              and mih2.mih2cus = mih.mihcus
              and mih2.company_id = mih.company_id
          )
    ), 
    includ_mih as (
        SELECT
          mih.company_id,
          mihDay, mihMonth, mihYear, mihType, mihCus, mih.mihVnos, mihPer,
          per_sale1, mih2per2, per_sale2, 
          mihStatus, StatusDesc, mihCancel, mihRef1, mihRef2,
          mihDep,mihJob
        FROM mih_raw as mih
        INNER JOIN filter_mih2 as mih2
          ON mih.mihref1 = mih2.mih2vnos
            and mih.mihcus = mih2.mih2cus
            and mih.company_id = mih2.company_id
            and chk_row = 1
    ), 
    exclude_mil as (
        SELECT
          mih2.company_id,
          mih2.mihDay, mih2.mihMonth, mih2.mihYear, mih2.mihType, mih2.mihCus, mih2.mihVnos, mih2.mihPer,  
          100 as per_sale1,
          '0' as mih2per2,
          0 as per_sale2,
          mihStatus, StatusDesc, mihCancel, mihRef1, mihRef2,
          mihDep,mihJob
        FROM mih_raw2 as mih2
        WHERE NOT EXISTS (
          SELECT 1 
          FROM includ_mih as mil2
          WHERE mih2.mihType = mil2.mihType
            and mih2.mihVnos = mil2.mihVnos
            and mih2.company_id = mil2.company_id
        )
    ),
    source_combined as (
        select distinct
          PARSE_DATE('%Y%m%d', CONCAT(mihYear, FORMAT("%02d", mihMonth),  mihDay)) as mix_date,
          dim_com.CompanySK,
          dim_com.companyID,
          t.* except(company_id),
          (case when t.per_sale1 <> 100 then 'Yes' else 'No' end) as InvoiceSalesFlag,
          mil.milLinkVcno
        from (
            select * from exclude_mil
            UNION ALL
            SELECT * FROM includ_mih
        ) t
        inner join ${ref(databuffet.CURATED_MAC5, 'curated_mil')} as mil
          on t.mihYear = mil.milYear
            and t.mihMonth = mil.milMonth
            and t.mihDay = mil.milDay
            and t.mihType = mil.milType
            and t.mihVnos = mil.milVnos
            and t.mihCus = mil.milCus
            and t.company_id = mil.company_id
        left join `${DimCompanyTableRef}` as dim_com
            on t.company_id = dim_com.companyID 
        WHERE t.mihtype in ('IS', 'BS', 'AS', 'QS')
    ),
    -- ดึงค่า Max InvoiceSK ปัจจุบันจาก Target
    target_max AS (
        SELECT IFNULL(MAX(InvoiceSK), 0) as max_sk FROM `${DimInvoiceTableRef}`
    ),
    -- Join Source กับ Target เพื่อเตรียมข้อมูลสำหรับ Merge และ Gen SK
    prepared_source AS (
        SELECT 
            S.*,
            T.InvoiceSK as existing_sk,
            dim_order.OrderSK,
            -- คำนวณ Row Number เฉพาะกลุ่มที่เป็นข้อมูลใหม่ (Target เป็น Null)
            ROW_NUMBER() OVER (
              PARTITION BY (CASE WHEN T.mihVnos IS NULL THEN 1 ELSE 0 END) 
              ORDER BY S.CompanySK, S.mihYear, S.mihMonth, S.mihDay, S.mihVnos, S.mihCus, S.milLinkVcno
            ) as rn_new
        FROM source_combined S
        LEFT JOIN `${DimInvoiceTableRef}` T
            ON S.mihYear = T.mihYear 
            AND S.mihMonth = T.mihMonth 
            AND S.mihDay = T.mihDay 
            AND S.mihVnos = T.mihVnos 
            AND S.mihCus = T.mihCus
            AND S.milLinkVcno = T.milLinkVcno
            AND S.CompanySK = T.CompanySK
        left join (
            select OrderSK, mihVnos
            from `${DimOrderTableRef}`
            qualify row_number() over(partition by mihVnos order by OrderSK) = 1
        ) as dim_order
            on S.milLinkVcno = dim_order.mihVnos
    )

    SELECT
        src.*,
        -- ถ้ามี SK เดิม (Update) ให้ใช้ของเดิม
        -- ถ้าเป็นแถวใหม่ (Insert) ให้เอา Max + Running Number
        CASE
            WHEN existing_sk IS NOT NULL THEN existing_sk
            ELSE (SELECT max_sk FROM target_max) + rn_new
        END as final_InvoiceSK
    FROM prepared_source src
) S
ON S.mihType = T.mihType
  AND S.mihVnos = T.mihVnos 
  AND IFNULL(S.milLinkVcno, '') = IFNULL(T.milLinkVcno, '')
  AND S.CompanySk = T.CompanySK

-- กรณีเจอข้อมูลเดิม (Update)
WHEN MATCHED THEN
  UPDATE SET 
    T.OrderSK = S.OrderSK,
    T.mix_date = S.mix_date,
    T.mihDay = S.mihDay, 
    T.mihMonth = S.mihMonth, 
    T.mihYear = S.mihYear,
    T.mihCus = S.mihCus,
    T.mihPer = S.mihPer,
    T.per_sale1 = S.per_sale1,
    T.mih2per2 = S.mih2per2,
    T.per_sale2 = S.per_sale2,
    T.mihStatus = S.mihStatus,
    T.StatusDesc = S.StatusDesc,
    T.mihCancel = S.mihCancel,
    T.mihRef1 = S.mihRef1,
    T.mihRef2 = S.mihRef2,
    T.mihDep = S.mihDep,
    T.mihJob = S.mihJob,
    T.InvoiceSalesFlag = S.InvoiceSalesFlag
    -- ยกเว้น: OrderSK, InvoiceSK, QuotationSK ไม่ถูก update

-- กรณีไม่เจอข้อมูล (Insert)
WHEN NOT MATCHED THEN
  INSERT (
    InvoiceSK, CompanySK, OrderSK,
    companyID,
    mix_date, mihDay, mihMonth, mihYear,
    mihType, mihVnos, mihCus, milLinkVcno,
    mihRef1, mihRef2, mihPer, mihStatus, StatusDesc, mihCancel,
    per_sale1, mih2per2, per_sale2, mihDep, mihJob,
    InvoiceSalesFlag
  )
  VALUES (
    S.final_InvoiceSK, S.CompanySK, S.OrderSK,
    S.companyID,
    S.mix_date, S.mihDay, S.mihMonth, S.mihYear,
    S.mihType, S.mihVnos, S.mihCus, S.milLinkVcno,
    S.mihRef1, S.mihRef2, S.mihPer, S.mihStatus, S.StatusDesc, S.mihCancel,
    S.per_sale1, S.mih2per2, S.per_sale2, S.mihDep, S.mihJob,
    S.InvoiceSalesFlag
  );