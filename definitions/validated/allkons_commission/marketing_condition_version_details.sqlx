config {
    type: "incremental",
    schema: databuffet.VALIDATED_ALLKONS_COMMISSION,
    dependencies: ["validated_schema_allkons_commission", "create_all_table_raw_allkons_commission"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["id"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_ALLKONS_COMMISSION,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    ${databuffet.functionData.cleanString('code')} AS code,
    ${databuffet.functionData.cleanString('id')} AS id,
    ${databuffet.functionData.cleanString('marketing_condition_id')} AS marketing_condition_id,
    ${databuffet.functionData.castInt64('version_no')} AS version_no,
    ${databuffet.functionData.cleanString('condition_type')} AS condition_type,
    ${databuffet.functionData.cleanString('name')} AS name,
    ${databuffet.functionData.cleanString('type')} AS type,
    ${databuffet.functionData.cleanString('status')} AS status,
    ${databuffet.functionData.cleanString('sales_positions')} AS sales_positions,
    ${databuffet.functionData.cleanString('sales_channels')} AS sales_channels,
    ${databuffet.functionData.cleanString('territories')} AS territories,
    ${databuffet.functionData.cleanString('commission_payment_type')} AS commission_payment_type,
    ${databuffet.functionData.parseFlexibleDatetime('created_at')} AS created_at,
    ${databuffet.functionData.parseFlexibleDatetime('updated_at')} AS updated_at,
    ${databuffet.functionData.parseFlexibleDatetime('content_changed_at')} AS content_changed_at,
    ${databuffet.functionData.cleanString('accounting_period_type')} AS accounting_period_type,
    ${databuffet.functionData.cleanString('accounting_period_value')} AS accounting_period_value,
    ${databuffet.functionData.parseFlexibleDatetime('invoice_start_date')} AS invoice_start_date,
    ${databuffet.functionData.parseFlexibleDatetime('invoice_end_date')} AS invoice_end_date,
    ${databuffet.functionData.parseFlexibleDatetime('order_start_date')} AS order_start_date,
    ${databuffet.functionData.parseFlexibleDatetime('order_end_date')} AS order_end_date,
    ${databuffet.functionData.cleanString('additional_commission_conditions')} AS additional_commission_conditions,
    ${databuffet.functionData.cleanString('data')} AS data,
    ${databuffet.functionData.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE(\'Asia/Bangkok\'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
