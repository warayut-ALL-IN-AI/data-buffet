config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["company_id", "MIH2day","MIH2month","MIH2year","MIH2type","MIH2vnos","MIH2cus","MIH2rev"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "mih2type", "mih2vnos", "mih2cus"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "MIH2day","MIH2month","MIH2year","MIH2type","MIH2vnos","MIH2cus","MIH2rev"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    CAST(MIH2day AS INT64) AS mih2day,
    CAST(MIH2month AS INT64) AS mih2month,
    CAST(MIH2year AS INT64) AS mih2year,
    NULLIF(CAST(TRIM(MIH2type) AS STRING), '') AS mih2type,
    NULLIF(CAST(TRIM(MIH2vnos) AS STRING), '') AS mih2vnos,
    NULLIF(CAST(TRIM(MIH2cus) AS STRING), '') AS mih2cus,
    CAST(MIH2rev AS INT64) AS mih2rev,
    CAST(MIH2shpid AS INT64) AS mih2shpid,
    NULLIF(CAST(TRIM(MIH2POnum) AS STRING), '') AS mih2ponum,
    CAST(MIH2POstat AS INT64) AS mih2postat,
    NULLIF(CAST(TRIM(MIH2PERpc) AS STRING), '') AS mih2perpc,
    NULLIF(CAST(TRIM(MIH2PER2) AS STRING), '') AS mih2per2,
    NULLIF(CAST(TRIM(MIH2PER2pc) AS STRING), '') AS mih2per2pc,
    CAST(MIH2POprice AS FLOAT64) AS mih2poprice,
    NULLIF(CAST(TRIM(MIH2DiscExtraNo) AS STRING), '') AS mih2discextrano,
    NULLIF(CAST(TRIM(MIH2projectname) AS STRING), '') AS mih2projectname,
    NULLIF(CAST(TRIM(MIH2shipto_addr_no) AS STRING), '') AS mih2shipto_addr_no,
    NULLIF(CAST(TRIM(MIH2shipto_addr_soi) AS STRING), '') AS mih2shipto_addr_soi,
    NULLIF(CAST(TRIM(MIH2shipto_addr_road) AS STRING), '') AS mih2shipto_addr_road,
    NULLIF(CAST(TRIM(MIH2shipto_addr_tambol) AS STRING), '') AS mih2shipto_addr_tambol,
    NULLIF(CAST(TRIM(MIH2shipto_addr_amphur) AS STRING), '') AS mih2shipto_addr_amphur,
    NULLIF(CAST(TRIM(MIH2shipto_addr_province) AS STRING), '') AS mih2shipto_addr_province,
    NULLIF(CAST(TRIM(MIH2shipto_receiver1_name) AS STRING), '') AS mih2shipto_receiver1_name,
    NULLIF(CAST(TRIM(MIH2shipto_receiver1_tel) AS STRING), '') AS mih2shipto_receiver1_tel,
    NULLIF(CAST(TRIM(MIH2shipto_receiver2_name) AS STRING), '') AS mih2shipto_receiver2_name,
    NULLIF(CAST(TRIM(MIH2shipto_receiver2_tel) AS STRING), '') AS mih2shipto_receiver2_tel,
    NULLIF(CAST(TRIM(MIH2pos) AS STRING), '') AS mih2pos,
    NULLIF(CAST(TRIM(MIH2co_name) AS STRING), '') AS mih2co_name,
    NULLIF(CAST(TRIM(MIH2co_tel) AS STRING), '') AS mih2co_tel,
    NULLIF(CAST(TRIM(MIH2co_fax) AS STRING), '') AS mih2co_fax,
    NULLIF(CAST(TRIM(MIH2goods_receiver) AS STRING), '') AS mih2goods_receiver,
    NULLIF(CAST(TRIM(MIH2goods_receiver_pos) AS STRING), '') AS mih2goods_receiver_pos,
    NULLIF(CAST(TRIM(MIH2goods_to) AS STRING), '') AS mih2goods_to,
    NULLIF(CAST(TRIM(MIH2goods_to_tel) AS STRING), '') AS mih2goods_to_tel,
    NULLIF(CAST(TRIM(MIH2goods_to_fax) AS STRING), '') AS mih2goods_to_fax,
    NULLIF(CAST(TRIM(MIH2cus_type) AS STRING), '') AS mih2cus_type,
    NULLIF(CAST(TRIM(MIH2cus_tel) AS STRING), '') AS mih2cus_tel,
    NULLIF(CAST(TRIM(MIH2cus_fax) AS STRING), '') AS mih2cus_fax,
    NULLIF(CAST(TRIM(MIH2cus_addr) AS STRING), '') AS mih2cus_addr,
    NULLIF(CAST(TRIM(MIH2cus_com) AS STRING), '') AS mih2cus_com,
    NULLIF(CAST(TRIM(MIH2cus_name) AS STRING), '') AS mih2cus_name,
    NULLIF(CAST(TRIM(MIH2cushp_name) AS STRING), '') AS mih2cushp_name,
    NULLIF(CAST(TRIM(MIH2cus_code) AS STRING), '') AS mih2cus_code,
    NULLIF(CAST(TRIM(MIH2cus_com_stat) AS STRING), '') AS mih2cus_com_stat,
    NULLIF(CAST(TRIM(MIH2cus_b) AS STRING), '') AS mih2cus_b,
    NULLIF(CAST(TRIM(MIH2cusgrp) AS STRING), '') AS mih2cusgrp,
    CAST(MIH2gp AS FLOAT64) AS mih2gp,
    NULLIF(CAST(TRIM(MIH2gppercen) AS STRING), '') AS mih2gppercen,
    CAST(MIH2install AS FLOAT64) AS mih2install,
    CAST(MIH2trans AS FLOAT64) AS mih2trans,
    NULLIF(CAST(TRIM(MIH2sumarea) AS STRING), '') AS mih2sumarea,
    NULLIF(CAST(TRIM(MIH2sumquan) AS STRING), '') AS mih2sumquan,
    NULLIF(CAST(TRIM(MIH2notes) AS STRING), '') AS mih2notes,
    NULLIF(CAST(TRIM(MIH2hpstat) AS STRING), '') AS mih2hpstat,
    CAST(MIH2comval AS FLOAT64) AS mih2comval,
    CAST(MIH2comper AS FLOAT64) AS mih2comper,
    NULLIF(CAST(TRIM(MIH2cost) AS STRING), '') AS mih2cost,
    NULLIF(CAST(TRIM(MIH2projtype) AS STRING), '') AS mih2projtype,
    NULLIF(CAST(TRIM(MIH2projtype2) AS STRING), '') AS mih2projtype2,
    NULLIF(CAST(TRIM(MIH2mip) AS STRING), '') AS mih2mip,
    NULLIF(CAST(TRIM(MIH2custype) AS STRING), '') AS mih2custype,
    NULLIF(CAST(TRIM(MIH2spc1) AS STRING), '') AS mih2spc1,
    NULLIF(CAST(TRIM(MIH2spc2) AS STRING), '') AS mih2spc2,
    NULLIF(CAST(TRIM(MIH2spc3) AS STRING), '') AS mih2spc3,
    NULLIF(CAST(TRIM(MIH2spc4) AS STRING), '') AS mih2spc4,
    NULLIF(CAST(TRIM(MIH2spc5) AS STRING), '') AS mih2spc5,
    NULLIF(CAST(TRIM(MIH2spc6) AS STRING), '') AS mih2spc6,
    NULLIF(CAST(TRIM(MIH2spc7) AS STRING), '') AS mih2spc7,
    NULLIF(CAST(TRIM(MIH2spc8) AS STRING), '') AS mih2spc8,
    NULLIF(CAST(TRIM(MIH2spc9) AS STRING), '') AS mih2spc9,
    NULLIF(CAST(TRIM(MIH2spc10) AS STRING), '') AS mih2spc10,
    NULLIF(CAST(TRIM(MIH2spc11) AS STRING), '') AS mih2spc11,
    NULLIF(CAST(TRIM(MIH2spc12) AS STRING), '') AS mih2spc12,
    NULLIF(CAST(TRIM(MIH2wty) AS STRING), '') AS mih2wty,
    NULLIF(CAST(TRIM(MIH2tenwhe) AS STRING), '') AS mih2tenwhe,
    NULLIF(CAST(TRIM(MIH2sixwhe) AS STRING), '') AS mih2sixwhe,
    NULLIF(CAST(TRIM(MIH2picup) AS STRING), '') AS mih2picup,
    NULLIF(CAST(TRIM(MIH2car) AS STRING), '') AS mih2car,
    NULLIF(CAST(TRIM(MIH2mtc) AS STRING), '') AS mih2mtc,
    NULLIF(CAST(TRIM(MIH2olddoor) AS STRING), '') AS mih2olddoor,
    NULLIF(CAST(TRIM(MIH2oldwall) AS STRING), '') AS mih2oldwall,
    NULLIF(CAST(TRIM(MIH2oldrang) AS STRING), '') AS mih2oldrang,
    NULLIF(CAST(TRIM(MIH2oldmotor) AS STRING), '') AS mih2oldmotor,
    NULLIF(CAST(TRIM(MIH2payment1) AS STRING), '') AS mih2payment1,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(MIH2paydate1, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2paydate1, 1, 19))
    ) AS mih2paydate1,
    NULLIF(CAST(TRIM(MIH2payment2) AS STRING), '') AS mih2payment2,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(MIH2paydate2, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2paydate2, 1, 19))
    ) AS mih2paydate2,
    NULLIF(CAST(TRIM(MIH2payment3) AS STRING), '') AS mih2payment3,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(MIH2paydate3, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2paydate3, 1, 19))
    ) AS mih2paydate3,
    NULLIF(CAST(TRIM(MIH2payinstall) AS STRING), '') AS mih2payinstall,
    NULLIF(CAST(TRIM(MIH2billname) AS STRING), '') AS mih2billname,
    NULLIF(CAST(TRIM(MIH2accname) AS STRING), '') AS mih2accname,
    NULLIF(CAST(TRIM(MIH2foottel) AS STRING), '') AS mih2foottel,
    NULLIF(CAST(TRIM(MIH2footfax) AS STRING), '') AS mih2footfax,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(MIH2billdate, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2billdate, 1, 19))
    ) AS mih2billdate,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(MIH2chequedate, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2chequedate, 1, 19))
    ) AS mih2chequedate,
    NULLIF(CAST(TRIM(MIH2employno) AS STRING), '') AS mih2employno,
    NULLIF(CAST(TRIM(MIH2foreman) AS STRING), '') AS mih2foreman,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(MIH2sendto, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2sendto, 1, 19))
    ) AS mih2sendto,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(MIH2complete, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2complete, 1, 19))
    ) AS mih2complete,
    NULLIF(CAST(TRIM(MIH2employee) AS STRING), '') AS mih2employee,
    NULLIF(CAST(TRIM(MIH2empaddr) AS STRING), '') AS mih2empaddr,
    NULLIF(CAST(TRIM(MIH2plnhouse) AS STRING), '') AS mih2plnhouse,
    NULLIF(CAST(TRIM(MIH2lbl1) AS STRING), '') AS mih2lbl1,
    NULLIF(CAST(TRIM(MIH2lbl2) AS STRING), '') AS mih2lbl2,
    NULLIF(CAST(TRIM(MIH2lbl3) AS STRING), '') AS mih2lbl3,
    NULLIF(CAST(TRIM(MIH2lbl4) AS STRING), '') AS mih2lbl4,
    NULLIF(CAST(TRIM(MIH2lbl5) AS STRING), '') AS mih2lbl5,
    NULLIF(CAST(TRIM(MIH2lbl6) AS STRING), '') AS mih2lbl6,
    CAST(MIH2txt1 AS FLOAT64) AS mih2txt1,
    CAST(MIH2txt2 AS FLOAT64) AS mih2txt2,
    CAST(MIH2txt3 AS FLOAT64) AS mih2txt3,
    CAST(MIH2txt4 AS FLOAT64) AS mih2txt4,
    CAST(MIH2txt5 AS FLOAT64) AS mih2txt5,
    CAST(MIH2txt6 AS FLOAT64) AS mih2txt6,
    CAST(MIH2txt7 AS FLOAT64) AS mih2txt7,
    CAST(MIH2txt8 AS FLOAT64) AS mih2txt8,
    CAST(MIH2txt9 AS FLOAT64) AS mih2txt9,
    CAST(MIH2txt10 AS FLOAT64) AS mih2txt10,
    CAST(MIH2status AS INT64) AS mih2status,
    CAST(MIH2hw1 AS INT64) AS mih2hw1,
    CAST(MIH2hw2 AS INT64) AS mih2hw2,
    CAST(MIH2hw3 AS INT64) AS mih2hw3,
    CAST(MIH2hw4 AS INT64) AS mih2hw4,
    CAST(MIH2hw5 AS INT64) AS mih2hw5,
    CAST(MIH2hw6 AS INT64) AS mih2hw6,
    CAST(MIH2hw7 AS INT64) AS mih2hw7,
    CAST(MIH2hw8 AS INT64) AS mih2hw8,
    CAST(MIH2hw9 AS INT64) AS mih2hw9,
    CAST(MIH2hw10 AS INT64) AS mih2hw10,
    CAST(MIH2hw11 AS INT64) AS mih2hw11,
    CAST(MIH2hw12 AS INT64) AS mih2hw12,
    CAST(MIH2hw13 AS INT64) AS mih2hw13,
    CAST(MIH2hw14 AS INT64) AS mih2hw14,
    CAST(MIH2hw15 AS INT64) AS mih2hw15,
    NULLIF(CAST(TRIM(MIH2hwrem) AS STRING), '') AS mih2hwrem,
    NULLIF(CAST(TRIM(MIH2desc) AS STRING), '') AS mih2desc,
    NULLIF(CAST(TRIM(MIH2updateby) AS STRING), '') AS mih2updateby,
    NULLIF(CAST(TRIM(MIH2updatenameT) AS STRING), '') AS mih2updatenamet,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(MIH2crdate, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2crdate, 1, 19))
    ) AS mih2crdate,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(MIH2updatedate, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIH2updatedate, 1, 19))
    ) AS mih2updatedate,
    CAST(PaymentStatus AS INT64) AS paymentstatus,
    CAST(CondPack AS INT64) AS condpack,
    NULLIF(CAST(TRIM(InstallStatus) AS STRING), '') AS installstatus,
    CAST(Inv_Percen AS FLOAT64) AS inv_percen,
    CAST(MaxRev AS INT64) AS maxrev,
    NULLIF(CAST(TRIM(MIH2vnos_Core) AS STRING), '') AS mih2vnos_core,
    NULLIF(CAST(TRIM(PROJCODE) AS STRING), '') AS projcode,
    NULLIF(CAST(TRIM(TranStatus) AS STRING), '') AS transtatus,
    NULLIF(CAST(TRIM(PackStatus) AS STRING), '') AS packstatus,
    NULLIF(CAST(TRIM(BomInstallStatus) AS STRING), '') AS bominstallstatus,
    CAST(MustInstall AS INT64) AS mustinstall,
    CAST(Direction AS INT64) AS direction,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(POexpireDate, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(POexpireDate, 1, 19))
    ) AS poexpiredate,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(InsFinishDate, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(InsFinishDate, 1, 19))
    ) AS insfinishdate,
    CAST(SendCustHome AS INT64) AS sendcusthome,
    PARSE_DATE('%Y%m%d', ASATDATE) AS asatdate
  FROM
    `${sourceTableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
