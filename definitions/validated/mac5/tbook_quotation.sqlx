config {
    type: "table",
    schema: databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MAC5,
    dependencies: ["validated_schema_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["id"],
    bigquery: {
        clusterBy: ["id"]
    },
}

js {
    const project_id = databuffet.DATABASE
    const dataset_id = databuffet.RAW_SCHEMA + "_" + databuffet.SOURCE_MAC5
    const table_id = name()
    const pk_key = ["id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY extradesc desc, cname desc) = 1`;
        post_operations_statement = `BEGIN
    EXECUTE IMMEDIATE 'ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS';
    EXECUTE IMMEDIATE 'ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED';
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    CAST(id AS INT64) as id,
    NULLIF(CAST(TRIM(running) AS STRING), '') as running,
    NULLIF(CAST(TRIM(atten) AS STRING), '') as atten,
    NULLIF(CAST(TRIM(address) AS STRING), '') as address,
    NULLIF(CAST(TRIM(sdate) AS STRING), '') as sdate,
    NULLIF(CAST(TRIM(project) AS STRING), '') as project,
    NULLIF(CAST(TRIM(tel) AS STRING), '') as tel,
    NULLIF(CAST(TRIM(sale) AS STRING), '') as sale,
    NULLIF(CAST(TRIM(price_validity) AS STRING), '') as price_validity,
    NULLIF(CAST(TRIM(termdelivery) AS STRING), '') as termdelivery,
    NULLIF(CAST(TRIM(termpayment) AS STRING), '') as termpayment,
    NULLIF(CAST(TRIM(uinsert) AS STRING), '') as uinsert,
    NULLIF(CAST(TRIM(dinsert) AS STRING), '') as dinsert,
    NULLIF(CAST(TRIM(uupdate) AS STRING), '') as uupdate,
    NULLIF(CAST(TRIM(dupdate) AS STRING), '') as dupdate,
    NULLIF(CAST(TRIM(agent1) AS STRING), '') as agent1,
    NULLIF(CAST(TRIM(agent2) AS STRING), '') as agent2,
    NULLIF(CAST(TRIM(period) AS STRING), '') as period,
    NULLIF(CAST(TRIM(pos) AS STRING), '') as pos,
    CAST(vat AS INT64) as vat,
    CAST(disc AS INT64) as disc,
    CAST(extrasum AS INT64) as extrasum,
    NULLIF(CAST(TRIM(extradesc) AS STRING), '') as extradesc,
    NULLIF(CAST(TRIM(date1st) AS STRING), '') as date1st,
    NULLIF(CAST(TRIM(date1end) AS STRING), '') as date1end,
    NULLIF(CAST(TRIM(date2st) AS STRING), '') as date2st,
    NULLIF(CAST(TRIM(date2end) AS STRING), '') as date2end,
    CAST(cashstatus AS INT64) as cashstatus,
    NULLIF(CAST(TRIM(note) AS STRING), '') as note,
    NULLIF(CAST(TRIM(noteforapp) AS STRING), '') as noteforapp,
    NULLIF(CAST(TRIM(memoforapp) AS STRING), '') as memoforapp,
    CAST(rev AS INT64) as rev,
    CAST(typecus AS INT64) as typecus,
    NULLIF(CAST(TRIM(channel) AS STRING), '') as channel,
    NULLIF(CAST(TRIM(channel2) AS STRING), '') as channel2,
    CAST(typeprice AS INT64) as typeprice,
    CAST(fob AS INT64) as fob,
    CAST(cancel AS INT64) as cancel,
    CAST(apptype AS INT64) as apptype,
    NULLIF(CAST(TRIM(typedeb) AS STRING), '') as typedeb,
    NULLIF(CAST(TRIM(saledep) AS STRING), '') as saledep,
    NULLIF(CAST(TRIM(typeproject) AS STRING), '') as typeproject,
    CAST(selectstatus AS INT64) as selectstatus,
    CAST(conpostatus AS INT64) as conpostatus,
    NULLIF(CAST(TRIM(lat) AS STRING), '') as lat,
    NULLIF(CAST(TRIM(long) AS STRING), '') as long,
    NULLIF(CAST(TRIM(mapnote) AS STRING), '') as mapnote,
    NULLIF(CAST(TRIM(fileupload) AS STRING), '') as fileupload,
    NULLIF(CAST(TRIM(city) AS STRING), '') as city,
    CAST(rdosend AS INT64) as rdosend,
    NULLIF(CAST(TRIM(cname) AS STRING), '') as cname,
    NULLIF(CAST(TRIM(ctel) AS STRING), '') as ctel,
    NULLIF(CAST(TRIM(caddress) AS STRING), '') as caddress,
    NULLIF(CAST(TRIM(checknote) AS STRING), '') as checknote,
    NULLIF(CAST(TRIM(textnote) AS STRING), '') as textnote,
    CAST(statusspread AS INT64) as statusspread,
    CAST(chkbox AS INT64) as chkbox,
    CAST(fobstt AS INT64) as fobstt,
    CAST(quotation_ref AS INT64) as quotation_ref,
    CAST(customer_id AS INT64) as customer_id,
    CAST(customer_group AS INT64) as customer_group,
    CAST(quotation_id AS INT64) as quotation_id,
    CAST(estatus AS INT64) as estatus,
    NULLIF(CAST(TRIM(area) AS STRING), '') as area,
    NULLIF(CAST(TRIM(district) AS STRING), '') as district,
    NULLIF(CAST(TRIM(postcode) AS STRING), '') as postcode,
    CAST(qtstepprice AS INT64) as qtstepprice,
    NULLIF(CAST(TRIM(extradis) AS STRING), '') as extradis

FROM
  `${project_id}.${dataset_id}.${table_id}`
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
