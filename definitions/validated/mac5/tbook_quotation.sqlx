config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "id"],
    bigquery: {
        clusterBy: ["company_id", "id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY extradesc desc, cname desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.castInt64('id')} as id,
    ${databuffet.cleanString('running')} as running,
    ${databuffet.cleanString('atten')} as atten,
    ${databuffet.cleanString('address')} as address,
    PARSE_DATE('%Y-%m-%d', ${databuffet.cleanString('sdate')}) as sdate,
    ${databuffet.cleanString('project')} as project,
    ${databuffet.cleanString('tel')} is not null as tel,
    ${databuffet.cleanString('sale')} is not null as sale,
    ${databuffet.cleanString('price_validity')} as price_validity,
    ${databuffet.cleanString('termdelivery')} as termdelivery,
    ${databuffet.cleanString('termpayment')} as termpayment,
    ${databuffet.cleanString('uinsert')} as uinsert,
    ${databuffet.cleanString('dinsert')} as dinsert,
    ${databuffet.cleanString('uupdate')} as uupdate,
    ${databuffet.cleanString('dupdate')} as dupdate,
    ${databuffet.cleanString('agent1')} as agent1,
    ${databuffet.cleanString('agent2')} as agent2,
    ${databuffet.cleanString('period')} as period,
    ${databuffet.cleanString('pos')} as pos,
    ${databuffet.castInt64('vat')} as vat,
    ${databuffet.castInt64('disc')} as disc,
    ${databuffet.castInt64('extrasum')} as extrasum,
    ${databuffet.cleanString('extradesc')} as extradesc,
    ${databuffet.cleanString('date1st')} as date1st,
    ${databuffet.cleanString('date1end')} as date1end,
    ${databuffet.cleanString('date2st')} as date2st,
    ${databuffet.cleanString('date2end')} as date2end,
    ${databuffet.castInt64('cashstatus')} as cashstatus,
    ${databuffet.cleanString('note')} as note,
    REGEXP_REPLACE(
        ${databuffet.cleanString('noteforapp')}, 
        r'\b(0\d{1,2}[- ]?\d{3}[- ]?\d{3,4})\b',
        'xxx-xxx-xxxx'
    ) as noteforapp,
    ${databuffet.cleanString('memoforapp')} as memoforapp,
    ${databuffet.castInt64('rev')} as rev,
    ${databuffet.castInt64('typecus')} as typecus,
    ${databuffet.cleanString('channel')} as channel,
    ${databuffet.cleanString('channel2')} as channel2,
    ${databuffet.castInt64('typeprice')} as typeprice,
    ${databuffet.castInt64('fob')} as fob,
    ${databuffet.castInt64('cancel')} as cancel,
    ${databuffet.castInt64('apptype')} as apptype,
    ${databuffet.cleanString('typedeb')} as typedeb,
    ${databuffet.cleanString('saledep')} as saledep,
    ${databuffet.cleanString('typeproject')} as typeproject,
    ${databuffet.castInt64('selectstatus')} as selectstatus,
    ${databuffet.castInt64('conpostatus')} as conpostatus,
    ${databuffet.cleanString('lat')} as lat,
    ${databuffet.cleanString('long')} as long,
    ${databuffet.cleanString('mapnote')} as mapnote,
    ${databuffet.cleanString('fileupload')} as fileupload,
    ${databuffet.cleanString('city')} as city,
    ${databuffet.castInt64('rdosend')} as rdosend,
    ${databuffet.cleanString('cname')} is not null as cname,
    ${databuffet.cleanString('ctel')} is not null as ctel,
    ${databuffet.cleanString('caddress')} as caddress,
    ${databuffet.cleanString('checknote')} as checknote,
    ${databuffet.cleanString('textnote')} as textnote,
    ${databuffet.castInt64('statusspread')} as statusspread,
    ${databuffet.castInt64('chkbox')} as chkbox,
    ${databuffet.castInt64('fobstt')} as fobstt,
    ${databuffet.castInt64('quotation_ref')} as quotation_ref,
    ${databuffet.castInt64('customer_id')} as customer_id,
    ${databuffet.castInt64('customer_group')} as customer_group,
    ${databuffet.castInt64('quotation_id')} as quotation_id,
    ${databuffet.castInt64('estatus')} as estatus,
    ${databuffet.cleanString('area')} as area,
    ${databuffet.cleanString('district')} as district,
    ${databuffet.cleanString('postcode')} as postcode,
    ${databuffet.castInt64('qtstepprice')} as qtstepprice,
    ${databuffet.cleanString('extradis')} as extradis

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
