config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: [],
    bigquery: {
        clusterBy: ["company_id", "cppstkid"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = []

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY cppdateid desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.cleanString('cppstkid')} as cppstkid,
    ${databuffet.castInt64('cpplinkid')} as cpplinkid,
    ${databuffet.cleanString('cppvnosid')} as cppvnosid,
    ${databuffet.parseFlexibleDatetime('cppdateid')} AS cppdateid,
    ${databuffet.cleanString('cppcusid')} as cppcusid,
    ${databuffet.cleanString('cppjob')} as cppjob,
    ${databuffet.cleanString('cppdep')} as cppdep,
    ${databuffet.cleanString('cppper')} as cppper,
    ${databuffet.cleanString('cppdoc')} as cppdoc,
    ${databuffet.cleanString('cppmec')} as cppmec,
    ${databuffet.cleanString('cppsto')} as cppsto,
    ${databuffet.castFloat64('cppstkreq')} as cppstkreq,
    ${databuffet.castFloat64('cppstkcut1')} as cppstkcut1,
    ${databuffet.castFloat64('cppstkcut2')} as cppstkcut2,
    ${databuffet.castFloat64('cppsumreq')} as cppsumreq,
    ${databuffet.castFloat64('cppsumcut1')} as cppsumcut1,
    ${databuffet.castFloat64('cppsumcut2')} as cppsumcut2,
    ${databuffet.castInt64('cppclearstk')} as cppclearstk,
    ${databuffet.castInt64('cppclearsum')} as cppclearsum,
    ${databuffet.castInt64('cppclearuser')} as cppclearuser,
    ${databuffet.castInt64('cppclearall')} as cppclearall,
    ${databuffet.castInt64('cppcurc')} as cppcurc,
    ${databuffet.castFloat64('cppexchg')} as cppexchg,
    ${databuffet.castInt64('cppcut')} as cppcut,
    ${databuffet.parseFlexibleDatetime('cppdelvdate')} AS cppdelvdate,
    ${databuffet.castInt64('cpplistno')} as cpplistno

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
