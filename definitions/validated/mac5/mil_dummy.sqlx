config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["company_id", "MILday","MILmonth","MILyear","MILtype","MILvnos","MILcus","MILlistNo"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "miltype", "milvnos", "milcus"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "MILday","MILmonth","MILyear","MILtype","MILvnos","MILcus","MILlistNo"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.castInt64('MILday')} AS milday,
    ${databuffet.functionData.castInt64('MILmonth')} AS milmonth,
    ${databuffet.functionData.castInt64('MILyear')} AS milyear,
    ${databuffet.functionData.cleanString('MILtype')} AS miltype,
    ${databuffet.functionData.cleanString('MILvnos')} AS milvnos,
    ${databuffet.functionData.cleanString('MILcus')} AS milcus,
    ${databuffet.functionData.cleanCode('MILstk')} AS milstk,
    ${databuffet.functionData.cleanString('MILjob')} AS miljob,
    ${databuffet.functionData.cleanString('MILdep')} AS mildep,
    ${databuffet.functionData.cleanString('MILper')} AS milper,
    ${databuffet.functionData.cleanString('MILdoc')} AS mildoc,
    ${databuffet.functionData.cleanString('MILmec')} AS milmec,
    ${databuffet.functionData.cleanString('MILsto')} AS milsto,
    ${databuffet.functionData.cleanString('MILstoMT')} AS milstomt,
    ${databuffet.functionData.castInt64('MILlistNo')} AS millistno,
    ${databuffet.functionData.castFloat64('MILquan')} AS milquan,
    ${databuffet.functionData.castFloat64('MILquanP2')} AS milquanp2,
    ${databuffet.functionData.castFloat64('MILadisc')} AS miladisc,
    ${databuffet.functionData.castFloat64('MILcog')} AS milcog,
    ${databuffet.functionData.castFloat64('MILconv')} AS milconv,
    ${databuffet.functionData.castFloat64('MILdiscA')} AS mildisca,
    ${databuffet.functionData.cleanString('MILdiscT')} AS mildisct,
    ${databuffet.functionData.castFloat64('MILvat')} AS milvat,
    ${databuffet.functionData.castFloat64('MILsum')} AS milsum,
    ${databuffet.functionData.castInt64('MILcut')} AS milcut,
    ${databuffet.functionData.castInt64('MILstype')} AS milstype,
    ${databuffet.functionData.cleanString('MILuname')} AS miluname,
    ${databuffet.functionData.cleanString('MILdesc')} AS mildesc,
    ${databuffet.functionData.cleanString('MILvCol1')} AS milvcol1,
    ${databuffet.functionData.cleanString('MILvCol2')} AS milvcol2,
    ${databuffet.functionData.cleanString('MILvCol3')} AS milvcol3,
    ${databuffet.functionData.cleanString('MILvCol4')} AS milvcol4,
    ${databuffet.functionData.castInt64('MILcurC')} AS milcurc,
    ${databuffet.functionData.castFloat64('MILexchg')} AS milexchg,
    ${databuffet.functionData.castFloat64('MILacost')} AS milacost,
    ${databuffet.functionData.castInt64('MILpqm')} AS milpqm,
    ${databuffet.functionData.castInt64('MILpmFrom')} AS milpmfrom,
    ${databuffet.functionData.castInt64('MILpmTo')} AS milpmto,
    ${databuffet.functionData.castInt64('MILtag')} AS miltag,
    ${databuffet.functionData.cleanString('MILlinkVCno')} AS millinkvcno,
    ${databuffet.functionData.parseFlexibleDatetime('MILlinkVCdate')} AS millinkvcdate,
    ${databuffet.functionData.cleanString('MILlinkVCtype')} AS millinkvctype,
    ${databuffet.functionData.cleanString('MILlinkVCdeposit')} AS millinkvcdeposit,
    ${databuffet.functionData.castInt64('MILlinkVCid')} AS millinkvcid,
    ${databuffet.functionData.castInt64('MILclearUM')} AS milclearum,
    ${databuffet.functionData.parseFlexibleDatetime('MILexpDATE')} AS milexpdate,
    ${databuffet.functionData.cleanString('MILnotes')} AS milnotes,
    ${databuffet.functionData.castInt64('MILnotKL')} AS milnotkl,
    ${databuffet.functionData.parseFlexibleDatetime('MILdelvDT')} AS mildelvdt,
    ${databuffet.functionData.parseFlexibleDatetime('MILdateSP')} AS mildatesp,
    ${databuffet.functionData.castFloat64('MILnumCSP')} AS milnumcsp,
    ${databuffet.functionData.castInt64('MILnumISP')} AS milnumisp,
    ${databuffet.functionData.castFloat64('MILcost')} AS milcost,
    ${databuffet.functionData.castFloat64('MILucost')} AS milucost,
    ${databuffet.functionData.castFloat64('MILuprice')} AS miluprice,
    ${databuffet.functionData.castInt64('MILuseQuanP')} AS milusequanp,
    ${databuffet.functionData.cleanString('MILvCol5')} AS milvcol5,
    ${databuffet.functionData.castInt64('MILfitem')} AS milfitem,
    ${databuffet.functionData.parseAsatDate()} AS asatdate
  FROM
    `${sourceTableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
