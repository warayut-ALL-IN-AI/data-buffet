config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "meccode"],
    bigquery: {
        clusterBy: ["company_id", "meccode"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "meccode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY meceditdt desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.cleanString('meccode')} as meccode,
    ${databuffet.functionData.castInt64('mectpl')} as mectpl,
    ${databuffet.functionData.castInt64('mectoctype')} as mectoctype,
    ${databuffet.functionData.cleanString('mectocode')} as mectocode,
    ${databuffet.functionData.cleanString('mect1')} as mect1,
    ${databuffet.functionData.cleanString('mect2')} as mect2,
    ${databuffet.functionData.cleanString('mect3')} as mect3,
    ${databuffet.functionData.cleanString('mect4')} as mect4,
    ${databuffet.functionData.cleanString('mect5')} as mect5,
    ${databuffet.functionData.parseFlexibleDatetime('mecd1')} AS mecd1,
    ${databuffet.functionData.parseFlexibleDatetime('mecd2')} AS mecd2,
    ${databuffet.functionData.parseFlexibleDatetime('mecd3')} AS mecd3,
    ${databuffet.functionData.castInt64('meci1')} as meci1,
    ${databuffet.functionData.castInt64('meci2')} as meci2,
    ${databuffet.functionData.castFloat64('mecc1')} as mecc1,
    ${databuffet.functionData.castFloat64('mecc2')} as mecc2,
    ${databuffet.functionData.castFloat64('mecc3')} as mecc3,
    ${databuffet.functionData.castFloat64('mecc4')} as mecc4,
    ${databuffet.functionData.castFloat64('mecc5')} as mecc5,
    ${databuffet.functionData.cleanString('mecm1')} as mecm1,
    ${databuffet.functionData.cleanString('mecm2')} as mecm2,
    ${databuffet.functionData.cleanString('mecm3')} as mecm3,
    ${databuffet.functionData.cleanString('mecm4')} as mecm4,
    ${databuffet.functionData.cleanString('mecm5')} as mecm5,
    ${databuffet.functionData.cleanString('mecm6')} as mecm6,
    ${databuffet.functionData.cleanString('mecm7')} as mecm7,
    ${databuffet.functionData.cleanString('mecm8')} as mecm8,
    ${databuffet.functionData.cleanString('mecm9')} as mecm9,
    ${databuffet.functionData.cleanString('mecdesc')} as mecdesc,
    ${databuffet.functionData.castInt64('mechide')} as mechide,
    ${databuffet.functionData.castInt64('meclock')} as meclock,
    ${databuffet.functionData.parseFlexibleDatetime('meceditlk')} AS meceditlk,
    ${databuffet.functionData.cleanString('mecrefwe')} as mecrefwe,
    ${databuffet.functionData.cleanString('mecsortn')} as mecsortn,
    ${databuffet.functionData.cleanString('mect6')} as mect6,
    ${databuffet.functionData.cleanString('mect7')} as mect7,
    ${databuffet.functionData.cleanString('mect8')} as mect8,
    ${databuffet.functionData.cleanString('mect9')} as mect9,
    ${databuffet.functionData.cleanString('mect10')} as mect10,
    ${databuffet.functionData.parseFlexibleDatetime('meceditdt')} AS meceditdt,
    ${databuffet.functionData.cleanString('meceditmf')} as meceditmf

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
