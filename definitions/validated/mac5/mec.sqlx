config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["meccode"],
    bigquery: {
        clusterBy: ["meccode"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["meccode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY meceditdt desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    NULLIF(CAST(TRIM(meccode) AS STRING), '') as meccode,
    CAST(mectpl AS INT64) as mectpl,
    CAST(mectoctype AS INT64) as mectoctype,
    NULLIF(CAST(TRIM(mectocode) AS STRING), '') as mectocode,
    NULLIF(CAST(TRIM(mect1) AS STRING), '') as mect1,
    NULLIF(CAST(TRIM(mect2) AS STRING), '') as mect2,
    NULLIF(CAST(TRIM(mect3) AS STRING), '') as mect3,
    NULLIF(CAST(TRIM(mect4) AS STRING), '') as mect4,
    NULLIF(CAST(TRIM(mect5) AS STRING), '') as mect5,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(mecd1, 1, 19)) AS mecd1,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(mecd2, 1, 19)) AS mecd2,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(mecd3, 1, 19)) AS mecd3,
    CAST(meci1 AS INT64) as meci1,
    CAST(meci2 AS INT64) as meci2,
    CAST(mecc1 AS FLOAT64) as mecc1,
    CAST(mecc2 AS FLOAT64) as mecc2,
    CAST(mecc3 AS FLOAT64) as mecc3,
    CAST(mecc4 AS FLOAT64) as mecc4,
    CAST(mecc5 AS FLOAT64) as mecc5,
    NULLIF(CAST(TRIM(mecm1) AS STRING), '') as mecm1,
    NULLIF(CAST(TRIM(mecm2) AS STRING), '') as mecm2,
    NULLIF(CAST(TRIM(mecm3) AS STRING), '') as mecm3,
    NULLIF(CAST(TRIM(mecm4) AS STRING), '') as mecm4,
    NULLIF(CAST(TRIM(mecm5) AS STRING), '') as mecm5,
    NULLIF(CAST(TRIM(mecm6) AS STRING), '') as mecm6,
    NULLIF(CAST(TRIM(mecm7) AS STRING), '') as mecm7,
    NULLIF(CAST(TRIM(mecm8) AS STRING), '') as mecm8,
    NULLIF(CAST(TRIM(mecm9) AS STRING), '') as mecm9,
    NULLIF(CAST(TRIM(mecdesc) AS STRING), '') as mecdesc,
    CAST(mechide AS INT64) as mechide,
    CAST(meclock AS INT64) as meclock,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(meceditlk, 1, 19)) AS meceditlk,
    NULLIF(CAST(TRIM(mecrefwe) AS STRING), '') as mecrefwe,
    NULLIF(CAST(TRIM(mecsortn) AS STRING), '') as mecsortn,
    NULLIF(CAST(TRIM(mect6) AS STRING), '') as mect6,
    NULLIF(CAST(TRIM(mect7) AS STRING), '') as mect7,
    NULLIF(CAST(TRIM(mect8) AS STRING), '') as mect8,
    NULLIF(CAST(TRIM(mect9) AS STRING), '') as mect9,
    NULLIF(CAST(TRIM(mect10) AS STRING), '') as mect10,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(meceditdt, 1, 19)) AS meceditdt,
    NULLIF(CAST(TRIM(meceditmf) AS STRING), '') as meceditmf,
    NULLIF(CAST(TRIM(rowguid) AS STRING), '') as rowguid

FROM
  `${sourceTableRef}`
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
