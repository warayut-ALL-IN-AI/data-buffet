config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["company_id", "CSTdate","CSTtype","CSTvnos","CSTcus","CSTstk","CSTsto","CSTio","CSTlist"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "cstdate", "cstcus", "cststk"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "CSTdate","CSTtype","CSTvnos","CSTcus","CSTstk","CSTsto","CSTio","CSTlist"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.parseFlexibleDatetime('CSTdate')} AS cstdate,
    ${databuffet.functionData.cleanString('CSTtype')} AS csttype,
    ${databuffet.functionData.cleanString('CSTvnos')} AS cstvnos,
    ${databuffet.functionData.cleanString('CSTcus')} AS cstcus,
    ${databuffet.functionData.cleanString('CSTstk')} AS cststk,
    ${databuffet.functionData.cleanString('CSTjob')} AS cstjob,
    ${databuffet.functionData.cleanString('CSTdep')} AS cstdep,
    ${databuffet.functionData.cleanString('CSTper')} AS cstper,
    ${databuffet.functionData.cleanString('CSTdoc')} AS cstdoc,
    ${databuffet.functionData.cleanString('CSTmec')} AS cstmec,
    ${databuffet.functionData.cleanString('CSTsto')} AS cststo,
    ${databuffet.functionData.castFloat64('CSTquan')} AS cstquan,
    ${databuffet.functionData.castFloat64('CSTquanP2')} AS cstquanp2,
    ${databuffet.functionData.castFloat64('CSTcogSP')} AS cstcogsp,
    ${databuffet.functionData.parseFlexibleDatetime('CSTexpDATE')} AS cstexpdate,
    ${databuffet.functionData.cleanString('CSTlinkVC')} AS cstlinkvc,
    ${databuffet.functionData.castInt64('CSTlinkVCid')} AS cstlinkvcid,
    ${databuffet.functionData.castInt64('CSTio')} AS cstio,
    ${databuffet.functionData.castInt64('CSTioZW')} AS cstiozw,
    ${databuffet.functionData.castInt64('CSTlist')} AS cstlist,
    ${databuffet.functionData.castFloat64('CSTcostA')} AS cstcosta,
    ${databuffet.functionData.castFloat64('CSTcostF')} AS cstcostf,
    ${databuffet.functionData.castFloat64('CSTcostL')} AS cstcostl,
    ${databuffet.functionData.parseAsatDate()} AS asatdate
  FROM
    `${sourceTableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
