config {
    type: "incremental",
    schema: databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MAC5,
    dependencies: ["validated_schema_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["CSTdate","CSTtype","CSTvnos","CSTcus","CSTstk","CSTsto","CSTio","CSTlist"],
    bigquery: {
        clusterBy: []
    },
}

js {
    const project_id = databuffet.DATABASE
    const dataset_id = databuffet.RAW_SCHEMA + "_" + databuffet.SOURCE_MAC5
    const table_id = name()
    const pk_key = ["CSTdate","CSTtype","CSTvnos","CSTcus","CSTstk","CSTsto","CSTio","CSTlist"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY ASATDATE DESC) = 1`;
        post_operations_statement = `ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
    ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(CSTdate, 1, 19)) AS cstdate,
  NULLIF(CAST(TRIM(CSTtype) AS STRING), '') AS csttype,
  NULLIF(CAST(TRIM(CSTvnos) AS STRING), '') AS cstvnos,
  NULLIF(CAST(TRIM(CSTcus) AS STRING), '') AS cstcus,
  NULLIF(CAST(TRIM(CSTstk) AS STRING), '') AS cststk,
  NULLIF(CAST(TRIM(CSTjob) AS STRING), '') AS cstjob,
  NULLIF(CAST(TRIM(CSTdep) AS STRING), '') AS cstdep,
  NULLIF(CAST(TRIM(CSTper) AS STRING), '') AS cstper,
  NULLIF(CAST(TRIM(CSTdoc) AS STRING), '') AS cstdoc,
  NULLIF(CAST(TRIM(CSTmec) AS STRING), '') AS cstmec,
  NULLIF(CAST(TRIM(CSTsto) AS STRING), '') AS cststo,
  CAST(CSTquan AS FLOAT64) AS cstquan,
  CAST(CSTquanP2 AS FLOAT64) AS cstquanp2,
  CAST(CSTcogSP AS FLOAT64) AS cstcogsp,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(CSTexpDATE, 1, 19)) AS cstexpdate,
  NULLIF(CAST(TRIM(CSTlinkVC) AS STRING), '') AS cstlinkvc,
  CAST(CSTlinkVCid AS INT64) AS cstlinkvcid,
  CAST(CSTio AS INT64) AS cstio,
  CAST(CSTioZW AS INT64) AS cstiozw,
  CAST(CSTlist AS INT64) AS cstlist,
  CAST(CSTcostA AS FLOAT64) AS cstcosta,
  CAST(CSTcostF AS FLOAT64) AS cstcostf,
  CAST(CSTcostL AS FLOAT64) AS cstcostl,
  NULLIF(CAST(TRIM(rowguid) AS STRING), '') AS rowguid,
  PARSE_DATE('%Y%m%d', ASATDATE) AS asatdate
FROM
  `${project_id}.${dataset_id}.${table_id}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
