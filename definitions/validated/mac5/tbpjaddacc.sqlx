config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "id"],
    bigquery: {
        clusterBy: ["company_id", "id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY insertdate desc, accname desc, conname desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.castInt64('id')} as id,
    ${databuffet.cleanString('pjid')} as pjid,
    ${databuffet.cleanString('accid')} as accid,
    ${databuffet.cleanString('accname')} as accname,
    ${databuffet.cleanString('acctype')} as acctype,
    ${databuffet.cleanString('acctype2')} as acctype2,
    ${databuffet.cleanString('accpow')} as accpow,
    ${databuffet.cleanString('conid')} as conid,
    ${databuffet.cleanString('conname')} as conname,
    ${databuffet.cleanString('contel')} as contel,
    ${databuffet.cleanString('condetail')} as condetail,
    ${databuffet.cleanString('uinsert')} as uinsert,
    PARSE_DATE('%Y-%m-%d', SUBSTR(insertdate, 1, 10)) AS insertdate,
    ${databuffet.cleanString('textnote')} as textnote,
    ${databuffet.cleanString('nickname')} as nickname,
    ${databuffet.cleanString('religion')} as religion,
    PARSE_DATE('%Y-%m-%d', SUBSTR(birthdate, 1, 10)) AS birthdate,
    ${databuffet.cleanString('lineidper')} as lineidper,
    ${databuffet.cleanString('emailper')} as emailper,
    ${databuffet.cleanString('idcardper')} as idcardper,
    ${databuffet.cleanString('addressper')} as addressper,
    ${databuffet.cleanString('country')} as country,
    ${databuffet.cleanString('province')} as province,
    ${databuffet.cleanString('district')} as district,
    ${databuffet.cleanString('sub_district')} as sub_district,
    ${databuffet.cleanString('zipcode')} as zipcode,
    ${databuffet.cleanString('spousefullname')} as spousefullname,
    PARSE_DATE('%Y-%m-%d', SUBSTR(birthdatespouse, 1, 10)) AS birthdatespouse,
    ${databuffet.cleanString('numberofchildren')} as numberofchildren,
    ${databuffet.cleanString('favoriteactivity')} as favoriteactivity,
    ${databuffet.cleanString('unfavoriteactivity')} as unfavoriteactivity,
    ${databuffet.cleanString('trait')} as trait

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
