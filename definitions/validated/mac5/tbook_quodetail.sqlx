config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "id"],
    bigquery: {
        clusterBy: ["company_id", "id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY stkdesc desc, cname desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.castInt64('id')} as id,
    ${databuffet.functionData.castInt64('linkid')} as linkid,
    ${databuffet.functionData.cleanString('stkcode')} as stkcode,
    ${databuffet.functionData.cleanString('stkdesc')} as stkdesc,
    ${databuffet.functionData.castFloat64('quantity')} as quantity,
    ${databuffet.functionData.castFloat64('lp')} as lp,
    ${databuffet.functionData.castFloat64('nd')} as nd,
    ${databuffet.functionData.castFloat64('sd1')} as sd1,
    ${databuffet.functionData.castFloat64('sd2')} as sd2,
    ${databuffet.functionData.castFloat64('sd3')} as sd3,
    ${databuffet.functionData.castFloat64('dispercent')} as dispercent,
    ${databuffet.functionData.castFloat64('crc')} as crc,
    ${databuffet.functionData.castFloat64('price')} as price,
    ${databuffet.functionData.castFloat64('total')} as total,
    ${databuffet.functionData.castFloat64('priceforag')} as priceforag,
    ${databuffet.functionData.castFloat64('com')} as com,
    ${databuffet.functionData.castInt64('setcb')} as setcb,
    ${databuffet.functionData.cleanString('type')} as type,
    ${databuffet.functionData.cleanString('status')} as status,
    ${databuffet.functionData.cleanString('sent')} as sent,
    ${databuffet.functionData.cleanString('datepart')} as datepart,
    ${databuffet.functionData.cleanString('fg')} as fg,
    ${databuffet.functionData.cleanString('pic')} as pic,
    ${databuffet.functionData.cleanString('productcp')} as productcp,
    ${databuffet.functionData.castFloat64('pricecp')} as pricecp,
    ${databuffet.functionData.cleanString('uinsert')} as uinsert,
    ${databuffet.functionData.cleanString('uupdate')} as uupdate,
    ${databuffet.functionData.cleanString('dinsert')} as dinsert,
    ${databuffet.functionData.cleanString('dupdate')} as dupdate,
    ${databuffet.functionData.cleanString('giveaway')} as giveaway,
    ${databuffet.functionData.cleanString('givestk')} as givestk,
    ${databuffet.functionData.castFloat64('bgcount')} as bgcount,
    ${databuffet.functionData.castInt64('orderno')} as orderno,
    ${databuffet.functionData.cleanString('lat')} as lat,
    ${databuffet.functionData.cleanString('long')} as long,
    ${databuffet.functionData.cleanString('mapnote')} as mapnote,
    ${databuffet.functionData.cleanString('fileupload')} as fileupload,
    ${databuffet.functionData.cleanString('city')} as city,
    ${databuffet.functionData.castInt64('rdosend')} as rdosend,
    ${databuffet.functionData.cleanString('cname')} as cname,
    ${databuffet.functionData.cleanString('ctel')} as ctel,
    ${databuffet.functionData.cleanString('caddress')} as caddress,
    ${databuffet.functionData.cleanString('checknote')} as checknote,
    ${databuffet.functionData.cleanString('textnote')} as textnote,
    ${databuffet.functionData.castInt64('ref_quodetail')} as ref_quodetail,
    ${databuffet.functionData.castInt64('productgrade')} as productgrade,
    ${databuffet.functionData.castFloat64('fobprice')} as fobprice,
    ${databuffet.functionData.castInt64('isshow')} as isshow

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
