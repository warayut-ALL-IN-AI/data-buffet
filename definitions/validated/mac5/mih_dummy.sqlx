config {
    type: "incremental",
    schema: databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MAC5,
    dependencies: [...databuffet.dependencies[databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MAC5]],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: [...databuffet.primaryKeys[databuffet.SOURCE_MAC5]["mih_dummy"]],
    bigquery: {
        clusterBy: []
    },
}

js {
    const project_id = databuffet.DATABASE
    const dataset_id = databuffet.RAW_SCHEMA + "_" + databuffet.SOURCE_MAC5
    const table_id = name()
    const pk_key = databuffet.primaryKeys[databuffet.SOURCE_MAC5]["mih_dummy"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY ASATDATE DESC) = 1`;
        post_operations_statement = `ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
    ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  CAST(MIHday AS INT64) AS mihday,
  CAST(MIHmonth AS INT64) AS mihmonth,
  CAST(MIHyear AS INT64) AS mihyear,
  CAST(TRIM(MIHtype) AS STRING) AS mihtype,
  CAST(TRIM(MIHvnos) AS STRING) AS mihvnos,
  CAST(TRIM(MIHcus) AS STRING) AS mihcus,
  CAST(TRIM(MIHjob) AS STRING) AS mihjob,
  CAST(TRIM(MIHdep) AS STRING) AS mihdep,
  CAST(TRIM(MIHper) AS STRING) AS mihper,
  CAST(TRIM(MIHdoc) AS STRING) AS mihdoc,
  CAST(TRIM(MIHmec) AS STRING) AS mihmec,
  CAST(TRIM(MIHvatNO) AS STRING) AS mihvatno,
  CAST(TRIM(MIHdesc) AS STRING) AS mihdesc,
  CAST(TRIM(MIHmemo) AS STRING) AS mihmemo,
  CAST(TRIM(MIHnotes) AS STRING) AS mihnotes,
  CAST(TRIM(MIHref1) AS STRING) AS mihref1,
  CAST(TRIM(MIHref2) AS STRING) AS mihref2,
  CAST(TRIM(MIHref3) AS STRING) AS mihref3,
  CAST(TRIM(MIHdiscHT1) AS STRING) AS mihdischt1,
  CAST(TRIM(MIHdiscHT2) AS STRING) AS mihdischt2,
  CAST(TRIM(MIHdelvSite) AS STRING) AS mihdelvsite,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHdelvDate, 1, 19)) AS mihdelvdate,
  CAST(MIHstanding AS INT64) AS mihstanding,
  CAST(MIHlinkGL AS INT64) AS mihlinkgl,
  CAST(MIHnoUPLINK AS INT64) AS mihnouplink,
  CAST(MIHnolist AS INT64) AS mihnolist,
  CAST(MIHcurC AS INT64) AS mihcurc,
  CAST(MIHvatInList AS INT64) AS mihvatinlist,
  CAST(MIHlock AS INT64) AS mihlock,
  CAST(MIHprintN AS INT64) AS mihprintn,
  CAST(MIHcheque AS INT64) AS mihcheque,
  CAST(MIHcancel AS INT64) AS mihcancel,
  CAST(MIHstatus AS INT64) AS mihstatus,
  CAST(MIHclearUM AS INT64) AS mihclearum,
  CAST(MIHctermNO AS INT64) AS mihctermno,
  CAST(MIHcog AS FLOAT64) AS mihcog,
  CAST(MIHvatSUM AS FLOAT64) AS mihvatsum,
  CAST(MIHnetSUM AS FLOAT64) AS mihnetsum,
  CAST(MIHdiscLST AS FLOAT64) AS mihdisclst,
  CAST(MIHdiscHF1 AS FLOAT64) AS mihdischf1,
  CAST(MIHdiscHF2 AS FLOAT64) AS mihdischf2,
  CAST(MIHexchg AS FLOAT64) AS mihexchg,
  CAST(MIHextraSUM AS FLOAT64) AS mihextrasum,
  CAST(MIHextraVAT AS FLOAT64) AS mihextravat,
  CAST(MIHextraCUT AS INT64) AS mihextracut,
  CAST(TRIM(MIHextraMEM) AS STRING) AS mihextramem,
  CAST(TRIM(MIHrecNO) AS STRING) AS mihrecno,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHrecDATE, 1, 19)) AS mihrecdate,
  CAST(TRIM(MIHsaveTAG) AS STRING) AS mihsavetag,
  CAST(TRIM(MIHkeyUser) AS STRING) AS mihkeyuser,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHkeyDate, 1, 19)) AS mihkeydate,
  CAST(TRIM(MIHdocRunNo) AS STRING) AS mihdocrunno,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHdateGL, 1, 19)) AS mihdategl,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHduePO, 1, 19)) AS mihduepo,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHeditLK, 1, 19)) AS miheditlk,
  CAST(MIHisCF AS INT64) AS mihiscf,
  CAST(MIHisSP AS INT64) AS mihissp,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHdateS1, 1, 19)) AS mihdates1,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHdateS2, 1, 19)) AS mihdates2,
  CAST(MIHnumSI AS INT64) AS mihnumsi,
  CAST(MIHnumSC AS FLOAT64) AS mihnumsc,
  CAST(MIHvatPC AS FLOAT64) AS mihvatpc,
  CAST(MIHincluded AS INT64) AS mihincluded,
  CAST(TRIM(MIHtaxvnos) AS STRING) AS mihtaxvnos,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHtaxdate, 1, 19)) AS mihtaxdate,
  CAST(MIHtaxsum AS FLOAT64) AS mihtaxsum,
  CAST(MIHload AS INT64) AS mihload,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHpaidDate, 1, 19)) AS mihpaiddate,
  CAST(TRIM(MIHbookOrderNum) AS STRING) AS mihbookordernum,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(MIHsendDate, 1, 19)) AS mihsenddate,
  CAST(MIHbl AS INT64) AS mihbl,
  CAST(MIHrpv AS INT64) AS mihrpv,
  CAST(MIHclearCUT AS INT64) AS mihclearcut,
  CAST(MIHsettleCUT AS INT64) AS mihsettlecut,
  CAST(TRIM(rowguid) AS STRING) AS rowguid,
  PARSE_DATE('%Y%m%d', ASATDATE) AS asatdate
FROM
  `${project_id}.${dataset_id}.${table_id}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
