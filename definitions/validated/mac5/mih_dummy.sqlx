config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["company_id", "MIHday","MIHmonth","MIHyear","MIHtype","MIHvnos","MIHcus"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "mihtype", "mihvnos", "mihcus"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "MIHday","MIHmonth","MIHyear","MIHtype","MIHvnos","MIHcus"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.castInt64('MIHday')} AS mihday,
    ${databuffet.castInt64('MIHmonth')} AS mihmonth,
    ${databuffet.castInt64('MIHyear')} AS mihyear,
    ${databuffet.cleanString('MIHtype')} AS mihtype,
    ${databuffet.cleanString('MIHvnos')} AS mihvnos,
    ${databuffet.cleanString('MIHcus')} AS mihcus,
    ${databuffet.cleanString('MIHjob')} AS mihjob,
    ${databuffet.cleanString('MIHdep')} AS mihdep,
    ${databuffet.cleanString('MIHper')} AS mihper,
    ${databuffet.cleanString('MIHdoc')} AS mihdoc,
    ${databuffet.cleanString('MIHmec')} AS mihmec,
    ${databuffet.cleanString('MIHvatNO')} AS mihvatno,
    ${databuffet.cleanString('MIHdesc')} AS mihdesc,
    ${databuffet.cleanString('MIHmemo')} AS mihmemo,
    ${databuffet.cleanString('MIHnotes')} AS mihnotes,
    ${databuffet.cleanString('MIHref1')} AS mihref1,
    ${databuffet.cleanString('MIHref2')} AS mihref2,
    ${databuffet.cleanString('MIHref3')} AS mihref3,
    ${databuffet.cleanString('MIHdiscHT1')} AS mihdischt1,
    ${databuffet.cleanString('MIHdiscHT2')} AS mihdischt2,
    ${databuffet.cleanString('MIHdelvSite')} AS mihdelvsite,
    ${databuffet.parseFlexibleDatetime('MIHdelvDate')} AS mihdelvdate,
    ${databuffet.castInt64('MIHstanding')} AS mihstanding,
    ${databuffet.castInt64('MIHlinkGL')} AS mihlinkgl,
    ${databuffet.castInt64('MIHnoUPLINK')} AS mihnouplink,
    ${databuffet.castInt64('MIHnolist')} AS mihnolist,
    ${databuffet.castInt64('MIHcurC')} AS mihcurc,
    ${databuffet.castInt64('MIHvatInList')} AS mihvatinlist,
    ${databuffet.castInt64('MIHlock')} AS mihlock,
    ${databuffet.castInt64('MIHprintN')} AS mihprintn,
    ${databuffet.castInt64('MIHcheque')} AS mihcheque,
    ${databuffet.castInt64('MIHcancel')} AS mihcancel,
    ${databuffet.castInt64('MIHstatus')} AS mihstatus,
    ${databuffet.castInt64('MIHclearUM')} AS mihclearum,
    ${databuffet.castInt64('MIHctermNO')} AS mihctermno,
    ${databuffet.castFloat64('MIHcog')} AS mihcog,
    ${databuffet.castFloat64('MIHvatSUM')} AS mihvatsum,
    ${databuffet.castFloat64('MIHnetSUM')} AS mihnetsum,
    ${databuffet.castFloat64('MIHdiscLST')} AS mihdisclst,
    ${databuffet.castFloat64('MIHdiscHF1')} AS mihdischf1,
    ${databuffet.castFloat64('MIHdiscHF2')} AS mihdischf2,
    ${databuffet.castFloat64('MIHexchg')} AS mihexchg,
    ${databuffet.castFloat64('MIHextraSUM')} AS mihextrasum,
    ${databuffet.castFloat64('MIHextraVAT')} AS mihextravat,
    ${databuffet.castInt64('MIHextraCUT')} AS mihextracut,
    ${databuffet.cleanString('MIHextraMEM')} AS mihextramem,
    ${databuffet.cleanString('MIHrecNO')} AS mihrecno,
    ${databuffet.parseFlexibleDatetime('MIHrecDATE')} AS mihrecdate,
    ${databuffet.cleanString('MIHsaveTAG')} AS mihsavetag,
    ${databuffet.cleanString('MIHkeyUser')} AS mihkeyuser,
    ${databuffet.parseFlexibleDatetime('MIHkeyDate')} AS mihkeydate,
    ${databuffet.cleanString('MIHdocRunNo')} AS mihdocrunno,
    ${databuffet.parseFlexibleDatetime('MIHdateGL')} AS mihdategl,
    ${databuffet.parseFlexibleDatetime('MIHduePO')} AS mihduepo,
    ${databuffet.parseFlexibleDatetime('MIHeditLK')} AS miheditlk,
    ${databuffet.castInt64('MIHisCF')} AS mihiscf,
    ${databuffet.castInt64('MIHisSP')} AS mihissp,
    ${databuffet.parseFlexibleDatetime('MIHdateS1')} AS mihdates1,
    ${databuffet.parseFlexibleDatetime('MIHdateS2')} AS mihdates2,
    ${databuffet.castInt64('MIHnumSI')} AS mihnumsi,
    ${databuffet.castFloat64('MIHnumSC')} AS mihnumsc,
    ${databuffet.castFloat64('MIHvatPC')} AS mihvatpc,
    ${databuffet.castInt64('MIHincluded')} AS mihincluded,
    ${databuffet.cleanString('MIHtaxvnos')} AS mihtaxvnos,
    ${databuffet.parseFlexibleDatetime('MIHtaxdate')} AS mihtaxdate,
    ${databuffet.castFloat64('MIHtaxsum')} AS mihtaxsum,
    ${databuffet.castInt64('MIHload')} AS mihload,
    ${databuffet.parseFlexibleDatetime('MIHpaidDate')} AS mihpaiddate,
    ${databuffet.cleanString('MIHbookOrderNum')} AS mihbookordernum,
    ${databuffet.parseFlexibleDatetime('MIHsendDate')} AS mihsenddate,
    ${databuffet.castInt64('MIHbl')} AS mihbl,
    ${databuffet.castInt64('MIHrpv')} AS mihrpv,
    ${databuffet.castInt64('MIHclearCUT')} AS mihclearcut,
    ${databuffet.castInt64('MIHsettleCUT')} AS mihsettlecut,
    ${databuffet.parseAsatDate()} AS asatdate
  FROM
    `${sourceTableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
