config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "frun", "fcode"],
    bigquery: {
        clusterBy: ["company_id", "frun", "fcode"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "frun", "fcode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY fdate desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }

}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.cleanString('frun')} as frun,
    ${databuffet.functionData.cleanString('fmaster')} as fmaster,
    ${databuffet.functionData.cleanString('fcode')} as fcode,
    ${databuffet.functionData.cleanString('fdate')} as fdate,
    ${databuffet.functionData.cleanString('fvehicle')} as fvehicle,
    ${databuffet.functionData.cleanString('fother')} as fother,
    ${databuffet.functionData.castInt64('fprice')} as fprice,
    ${databuffet.functionData.castInt64('fbuddy')} as fbuddy,
    ${databuffet.functionData.cleanString('fdeduct_detail')} as fdeduct_detail,
    ${databuffet.functionData.castFloat64('fdeduct_monkey')} as fdeduct_monkey,
    ${databuffet.functionData.castFloat64('fdeduct_money')} as fdeduct_money,
    ${databuffet.functionData.cleanString('ftype')} as ftype,
    ${databuffet.functionData.cleanString('fcomplete')} as fcomplete,
    ${databuffet.functionData.cleanString('foil')} as foil,
    ${databuffet.functionData.cleanString('fpass_date')} as fpass_date,
    ${databuffet.functionData.cleanString('fpay')} as fpay,
    ${databuffet.functionData.castInt64('foil_deduct')} as foil_deduct,
    ${databuffet.functionData.castInt64('loadip')} as loadip,
    ${databuffet.functionData.cleanString('loadvnos')} as loadvnos,
    ${databuffet.functionData.cleanString('fremark')} as fremark,
    ${databuffet.functionData.castFloat64('flitre_price')} as flitre_price,
    ${databuffet.functionData.castFloat64('flitre')} as flitre,
    ${databuffet.functionData.castFloat64('fcubic')} as fcubic
  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources

${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
