config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "cfsvnosid","cfsdateid","cfscusid","cfstypeid"],
    bigquery: {
        clusterBy: ["company_id", "cfsvnosid"]
    },
}

js {
    const pk_key = ["company_id", "cfsvnosid","cfsdateid","cfscusid","cfstypeid"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY company_id, cfsvnosid,cfsdateid,cfscusid,cfstypeid ORDER BY cfsdateid desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    NULLIF(CAST(TRIM(cfsvnosid) AS STRING), '') as cfsvnosid,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(cfsdateid, 1, 19)) AS cfsdateid,
    NULLIF(CAST(TRIM(cfscusid) AS STRING), '') as cfscusid,
    NULLIF(CAST(TRIM(cfstypeid) AS STRING), '') as cfstypeid,
    NULLIF(CAST(TRIM(cfsjob) AS STRING), '') as cfsjob,
    NULLIF(CAST(TRIM(cfsdep) AS STRING), '') as cfsdep,
    NULLIF(CAST(TRIM(cfsper) AS STRING), '') as cfsper,
    NULLIF(CAST(TRIM(cfsdoc) AS STRING), '') as cfsdoc,
    NULLIF(CAST(TRIM(cfsmec) AS STRING), '') as cfsmec,
    CAST(cfssumreq AS FLOAT64) as cfssumreq,
    CAST(cfssumcut1 AS FLOAT64) as cfssumcut1,
    CAST(cfssumcut2 AS FLOAT64) as cfssumcut2,
    CAST(cfsclearsum AS INT64) as cfsclearsum,
    CAST(cfsclearuser AS INT64) as cfsclearuser,
    CAST(cfsclearall AS INT64) as cfsclearall,
    CAST(cfscurc AS INT64) as cfscurc,
    CAST(cfsexchg AS FLOAT64) as cfsexchg,
    CAST(cfsbillcut AS FLOAT64) as cfsbillcut,
    CAST(cfsbillclr AS INT64) as cfsbillclr
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AG01}.cfs`
  UNION ALL
  SELECT 'aa05' AS company_id,
    NULLIF(CAST(TRIM(cfsvnosid) AS STRING), '') as cfsvnosid,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(cfsdateid, 1, 19)) AS cfsdateid,
    NULLIF(CAST(TRIM(cfscusid) AS STRING), '') as cfscusid,
    NULLIF(CAST(TRIM(cfstypeid) AS STRING), '') as cfstypeid,
    NULLIF(CAST(TRIM(cfsjob) AS STRING), '') as cfsjob,
    NULLIF(CAST(TRIM(cfsdep) AS STRING), '') as cfsdep,
    NULLIF(CAST(TRIM(cfsper) AS STRING), '') as cfsper,
    NULLIF(CAST(TRIM(cfsdoc) AS STRING), '') as cfsdoc,
    NULLIF(CAST(TRIM(cfsmec) AS STRING), '') as cfsmec,
    CAST(cfssumreq AS FLOAT64) as cfssumreq,
    CAST(cfssumcut1 AS FLOAT64) as cfssumcut1,
    CAST(cfssumcut2 AS FLOAT64) as cfssumcut2,
    CAST(cfsclearsum AS INT64) as cfsclearsum,
    CAST(cfsclearuser AS INT64) as cfsclearuser,
    CAST(cfsclearall AS INT64) as cfsclearall,
    CAST(cfscurc AS INT64) as cfscurc,
    CAST(cfsexchg AS FLOAT64) as cfsexchg,
    CAST(cfsbillcut AS FLOAT64) as cfsbillcut,
    CAST(cfsbillclr AS INT64) as cfsbillclr
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AA05}.cfs`
  UNION ALL
  SELECT 'ab01' AS company_id,
    NULLIF(CAST(TRIM(cfsvnosid) AS STRING), '') as cfsvnosid,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(cfsdateid, 1, 19)) AS cfsdateid,
    NULLIF(CAST(TRIM(cfscusid) AS STRING), '') as cfscusid,
    NULLIF(CAST(TRIM(cfstypeid) AS STRING), '') as cfstypeid,
    NULLIF(CAST(TRIM(cfsjob) AS STRING), '') as cfsjob,
    NULLIF(CAST(TRIM(cfsdep) AS STRING), '') as cfsdep,
    NULLIF(CAST(TRIM(cfsper) AS STRING), '') as cfsper,
    NULLIF(CAST(TRIM(cfsdoc) AS STRING), '') as cfsdoc,
    NULLIF(CAST(TRIM(cfsmec) AS STRING), '') as cfsmec,
    CAST(cfssumreq AS FLOAT64) as cfssumreq,
    CAST(cfssumcut1 AS FLOAT64) as cfssumcut1,
    CAST(cfssumcut2 AS FLOAT64) as cfssumcut2,
    CAST(cfsclearsum AS INT64) as cfsclearsum,
    CAST(cfsclearuser AS INT64) as cfsclearuser,
    CAST(cfsclearall AS INT64) as cfsclearall,
    CAST(cfscurc AS INT64) as cfscurc,
    CAST(cfsexchg AS FLOAT64) as cfsexchg,
    CAST(cfsbillcut AS FLOAT64) as cfsbillcut,
    CAST(cfsbillclr AS INT64) as cfsbillclr
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AB01}.cfs`
  UNION ALL
  SELECT 'ac02' AS company_id,
    NULLIF(CAST(TRIM(cfsvnosid) AS STRING), '') as cfsvnosid,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(cfsdateid, 1, 19)) AS cfsdateid,
    NULLIF(CAST(TRIM(cfscusid) AS STRING), '') as cfscusid,
    NULLIF(CAST(TRIM(cfstypeid) AS STRING), '') as cfstypeid,
    NULLIF(CAST(TRIM(cfsjob) AS STRING), '') as cfsjob,
    NULLIF(CAST(TRIM(cfsdep) AS STRING), '') as cfsdep,
    NULLIF(CAST(TRIM(cfsper) AS STRING), '') as cfsper,
    NULLIF(CAST(TRIM(cfsdoc) AS STRING), '') as cfsdoc,
    NULLIF(CAST(TRIM(cfsmec) AS STRING), '') as cfsmec,
    CAST(cfssumreq AS FLOAT64) as cfssumreq,
    CAST(cfssumcut1 AS FLOAT64) as cfssumcut1,
    CAST(cfssumcut2 AS FLOAT64) as cfssumcut2,
    CAST(cfsclearsum AS INT64) as cfsclearsum,
    CAST(cfsclearuser AS INT64) as cfsclearuser,
    CAST(cfsclearall AS INT64) as cfsclearall,
    CAST(cfscurc AS INT64) as cfscurc,
    CAST(cfsexchg AS FLOAT64) as cfsexchg,
    CAST(cfsbillcut AS FLOAT64) as cfsbillcut,
    CAST(cfsbillclr AS INT64) as cfsbillclr
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AC02}.cfs`
  UNION ALL
  SELECT 'ak02' AS company_id,
    NULLIF(CAST(TRIM(cfsvnosid) AS STRING), '') as cfsvnosid,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(cfsdateid, 1, 19)) AS cfsdateid,
    NULLIF(CAST(TRIM(cfscusid) AS STRING), '') as cfscusid,
    NULLIF(CAST(TRIM(cfstypeid) AS STRING), '') as cfstypeid,
    NULLIF(CAST(TRIM(cfsjob) AS STRING), '') as cfsjob,
    NULLIF(CAST(TRIM(cfsdep) AS STRING), '') as cfsdep,
    NULLIF(CAST(TRIM(cfsper) AS STRING), '') as cfsper,
    NULLIF(CAST(TRIM(cfsdoc) AS STRING), '') as cfsdoc,
    NULLIF(CAST(TRIM(cfsmec) AS STRING), '') as cfsmec,
    CAST(cfssumreq AS FLOAT64) as cfssumreq,
    CAST(cfssumcut1 AS FLOAT64) as cfssumcut1,
    CAST(cfssumcut2 AS FLOAT64) as cfssumcut2,
    CAST(cfsclearsum AS INT64) as cfsclearsum,
    CAST(cfsclearuser AS INT64) as cfsclearuser,
    CAST(cfsclearall AS INT64) as cfsclearall,
    CAST(cfscurc AS INT64) as cfscurc,
    CAST(cfsexchg AS FLOAT64) as cfsexchg,
    CAST(cfsbillcut AS FLOAT64) as cfsbillcut,
    CAST(cfsbillclr AS INT64) as cfsbillclr
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AK02}.cfs`

)
SELECT * FROM all_sources
QUALIFY ROW_NUMBER() OVER(PARTITION BY company_id, cfsvnosid,cfsdateid,cfscusid,cfstypeid ORDER BY cfsdateid desc) = 1

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
