config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["id"],
    bigquery: {
        clusterBy: ["id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY contactname desc, contactdesc desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    NULLIF(CAST(TRIM(id) AS STRING), '') as id,
    NULLIF(CAST(TRIM(contactpersonal) AS STRING), '') as contactpersonal,
    NULLIF(CAST(TRIM(contactcompany) AS STRING), '') as contactcompany,
    NULLIF(CAST(TRIM(contactcop) AS STRING), '') as contactcop,
    NULLIF(CAST(TRIM(contactsegment) AS STRING), '') as contactsegment,
    NULLIF(CAST(TRIM(contactchannel) AS STRING), '') as contactchannel,
    NULLIF(CAST(TRIM(contactstatus) AS STRING), '') as contactstatus,
    NULLIF(CAST(TRIM(contacttitle) AS STRING), '') as contacttitle,
    NULLIF(CAST(TRIM(contactname) AS STRING), '') as contactname,
    NULLIF(CAST(TRIM(contactnick) AS STRING), '') as contactnick,
    NULLIF(CAST(TRIM(contactaddress) AS STRING), '') as contactaddress,
    NULLIF(CAST(TRIM(contactaddress1) AS STRING), '') as contactaddress1,
    NULLIF(CAST(TRIM(contactaddress2) AS STRING), '') as contactaddress2,
    NULLIF(CAST(TRIM(contactaddress3) AS STRING), '') as contactaddress3,
    NULLIF(CAST(TRIM(contactaddress4) AS STRING), '') as contactaddress4,
    NULLIF(CAST(TRIM(contactaddress5) AS STRING), '') as contactaddress5,
    NULLIF(CAST(TRIM(contactaddress6) AS STRING), '') as contactaddress6,
    NULLIF(CAST(TRIM(contacttel) AS STRING), '') as contacttel,
    NULLIF(CAST(TRIM(contactmail) AS STRING), '') as contactmail,
    NULLIF(CAST(TRIM(contacttype) AS STRING), '') as contacttype,
    PARSE_DATE('%Y-%m-%d', SUBSTR(contactbday, 1, 10)) AS contactbday,
    NULLIF(CAST(TRIM(contactage) AS STRING), '') as contactage,
    NULLIF(CAST(TRIM(contactbyear) AS STRING), '') as contactbyear,
    NULLIF(CAST(TRIM(contacthob) AS STRING), '') as contacthob,
    NULLIF(CAST(TRIM(contactstudy) AS STRING), '') as contactstudy,
    NULLIF(CAST(TRIM(contactmag) AS STRING), '') as contactmag,
    NULLIF(CAST(TRIM(contactme) AS STRING), '') as contactme,
    NULLIF(CAST(TRIM(contactcolor) AS STRING), '') as contactcolor,
    NULLIF(CAST(TRIM(contactfood) AS STRING), '') as contactfood,
    NULLIF(CAST(TRIM(contactlife) AS STRING), '') as contactlife,
    NULLIF(CAST(TRIM(contactact) AS STRING), '') as contactact,
    NULLIF(CAST(TRIM(contactsday) AS STRING), '') as contactsday,
    NULLIF(CAST(TRIM(contactdesc) AS STRING), '') as contactdesc,
    NULLIF(CAST(TRIM(contactlove) AS STRING), '') as contactlove,
    NULLIF(CAST(TRIM(contactson) AS STRING), '') as contactson,
    NULLIF(CAST(TRIM(contactcntson) AS STRING), '') as contactcntson,
    NULLIF(CAST(TRIM(contactcntgirl) AS STRING), '') as contactcntgirl,
    NULLIF(CAST(TRIM(contactsonname1) AS STRING), '') as contactsonname1,
    NULLIF(CAST(TRIM(contactsonage1) AS STRING), '') as contactsonage1,
    NULLIF(CAST(TRIM(contactsonstudy1) AS STRING), '') as contactsonstudy1,
    NULLIF(CAST(TRIM(contactsonname2) AS STRING), '') as contactsonname2,
    NULLIF(CAST(TRIM(contactsonage2) AS STRING), '') as contactsonage2,
    NULLIF(CAST(TRIM(contactsonstudy2) AS STRING), '') as contactsonstudy2,
    NULLIF(CAST(TRIM(contactsonname3) AS STRING), '') as contactsonname3,
    NULLIF(CAST(TRIM(contactsonage3) AS STRING), '') as contactsonage3,
    NULLIF(CAST(TRIM(contactsonstudy3) AS STRING), '') as contactsonstudy3,
    NULLIF(CAST(TRIM(contactposition) AS STRING), '') as contactposition,
    NULLIF(CAST(TRIM(contactpower) AS STRING), '') as contactpower,
    NULLIF(CAST(TRIM(projectcode) AS STRING), '') as projectcode,
    NULLIF(CAST(TRIM(contactpp1) AS STRING), '') as contactpp1,
    NULLIF(CAST(TRIM(contactpp2) AS STRING), '') as contactpp2,
    NULLIF(CAST(TRIM(contactpp3) AS STRING), '') as contactpp3,
    NULLIF(CAST(TRIM(contactpp4) AS STRING), '') as contactpp4,
    NULLIF(CAST(TRIM(contactpp5) AS STRING), '') as contactpp5,
    NULLIF(CAST(TRIM(contactpp6) AS STRING), '') as contactpp6,
    NULLIF(CAST(TRIM(insertby) AS STRING), '') as insertby,
    NULLIF(CAST(TRIM(insertwhen) AS STRING), '') as insertwhen,
    NULLIF(CAST(TRIM(lastupdate) AS STRING), '') as lastupdate,
    NULLIF(CAST(TRIM(contactpath20) AS STRING), '') as contactpath20,
    NULLIF(CAST(TRIM(contactdebcode) AS STRING), '') as contactdebcode,
    CAST(activestatus AS INT64) as activestatus,
    NULLIF(CAST(TRIM(lineidcorp) AS STRING), '') as lineidcorp

FROM
  `${sourceTableRef}`
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
