config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "id"],
    bigquery: {
        clusterBy: ["company_id", "id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY contactname desc, contactdesc desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.cleanString('id')} as id,
    ${databuffet.cleanString('contactpersonal')} as contactpersonal,
    ${databuffet.cleanString('contactcompany')} as contactcompany,
    ${databuffet.cleanString('contactcop')} as contactcop,
    ${databuffet.cleanString('contactsegment')} as contactsegment,
    ${databuffet.cleanString('contactchannel')} as contactchannel,
    ${databuffet.cleanString('contactstatus')} as contactstatus,
    ${databuffet.cleanString('contacttitle')} as contacttitle,
    ${databuffet.cleanString('contactname')} as contactname,
    ${databuffet.cleanString('contactnick')} as contactnick,
    ${databuffet.cleanString('contactaddress')} as contactaddress,
    ${databuffet.cleanString('contactaddress1')} as contactaddress1,
    ${databuffet.cleanString('contactaddress2')} as contactaddress2,
    ${databuffet.cleanString('contactaddress3')} as contactaddress3,
    ${databuffet.cleanString('contactaddress4')} as contactaddress4,
    ${databuffet.cleanString('contactaddress5')} as contactaddress5,
    ${databuffet.cleanString('contactaddress6')} as contactaddress6,
    ${databuffet.cleanString('contacttel')} as contacttel,
    ${databuffet.cleanString('contactmail')} as contactmail,
    ${databuffet.cleanString('contacttype')} as contacttype,
    PARSE_DATE('%Y-%m-%d', SUBSTR(contactbday, 1, 10)) AS contactbday,
    ${databuffet.cleanString('contactage')} as contactage,
    ${databuffet.cleanString('contactbyear')} as contactbyear,
    ${databuffet.cleanString('contacthob')} as contacthob,
    ${databuffet.cleanString('contactstudy')} as contactstudy,
    ${databuffet.cleanString('contactmag')} as contactmag,
    ${databuffet.cleanString('contactme')} as contactme,
    ${databuffet.cleanString('contactcolor')} as contactcolor,
    ${databuffet.cleanString('contactfood')} as contactfood,
    ${databuffet.cleanString('contactlife')} as contactlife,
    ${databuffet.cleanString('contactact')} as contactact,
    ${databuffet.cleanString('contactsday')} as contactsday,
    ${databuffet.cleanString('contactdesc')} as contactdesc,
    ${databuffet.cleanString('contactlove')} as contactlove,
    ${databuffet.cleanString('contactson')} as contactson,
    ${databuffet.cleanString('contactcntson')} as contactcntson,
    ${databuffet.cleanString('contactcntgirl')} as contactcntgirl,
    ${databuffet.cleanString('contactsonname1')} as contactsonname1,
    ${databuffet.cleanString('contactsonage1')} as contactsonage1,
    ${databuffet.cleanString('contactsonstudy1')} as contactsonstudy1,
    ${databuffet.cleanString('contactsonname2')} as contactsonname2,
    ${databuffet.cleanString('contactsonage2')} as contactsonage2,
    ${databuffet.cleanString('contactsonstudy2')} as contactsonstudy2,
    ${databuffet.cleanString('contactsonname3')} as contactsonname3,
    ${databuffet.cleanString('contactsonage3')} as contactsonage3,
    ${databuffet.cleanString('contactsonstudy3')} as contactsonstudy3,
    ${databuffet.cleanString('contactposition')} as contactposition,
    ${databuffet.cleanString('contactpower')} as contactpower,
    ${databuffet.cleanString('projectcode')} as projectcode,
    ${databuffet.cleanString('contactpp1')} as contactpp1,
    ${databuffet.cleanString('contactpp2')} as contactpp2,
    ${databuffet.cleanString('contactpp3')} as contactpp3,
    ${databuffet.cleanString('contactpp4')} as contactpp4,
    ${databuffet.cleanString('contactpp5')} as contactpp5,
    ${databuffet.cleanString('contactpp6')} as contactpp6,
    ${databuffet.cleanString('insertby')} as insertby,
    ${databuffet.cleanString('insertwhen')} as insertwhen,
    ${databuffet.cleanString('lastupdate')} as lastupdate,
    ${databuffet.cleanString('contactpath20')} as contactpath20,
    ${databuffet.cleanString('contactdebcode')} as contactdebcode,
    ${databuffet.castInt64('activestatus')} as activestatus,
    ${databuffet.cleanString('lineidcorp')} as lineidcorp

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
