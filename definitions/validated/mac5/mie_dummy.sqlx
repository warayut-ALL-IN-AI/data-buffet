config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["company_id", "MIEday","MIEmonth","MIEyear","MIEtype","MIEvnos","MIEcus"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "mietype", "mievnos", "miecus"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "MIEday","MIEmonth","MIEyear","MIEtype","MIEvnos","MIEcus"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.castInt64('MIEday')} AS mieday,
    ${databuffet.functionData.castInt64('MIEmonth')} AS miemonth,
    ${databuffet.functionData.castInt64('MIEyear')} AS mieyear,
    ${databuffet.functionData.cleanString('MIEtype')} AS mietype,
    ${databuffet.functionData.cleanString('MIEvnos')} AS mievnos,
    ${databuffet.functionData.cleanString('MIEcus')} AS miecus,
    ${databuffet.functionData.castFloat64('MIErecDT3')} AS mierecdt3,
    ${databuffet.functionData.castFloat64('MIErecDT53')} AS mierecdt53,
    ${databuffet.functionData.castFloat64('MIErecDRND')} AS mierecdrnd,
    ${databuffet.functionData.castFloat64('MIErecDEXG')} AS mierecdexg,
    ${databuffet.functionData.castFloat64('MIErecDCSH')} AS mierecdcsh,
    ${databuffet.functionData.castFloat64('MIErecDOTH')} AS mierecdoth,
    ${databuffet.functionData.castFloat64('MIErecPLUS')} AS mierecplus,
    ${databuffet.functionData.castFloat64('MIErecCASH')} AS miereccash,
    ${databuffet.functionData.castFloat64('MIErecCQRD')} AS miereccqrd,
    ${databuffet.functionData.cleanString('MIEctermCX')} AS miectermcx,
    ${databuffet.functionData.cleanString('MIEctermPX')} AS miectermpx,
    ${databuffet.functionData.cleanString('MIEctermAX')} AS miectermax,
    ${databuffet.functionData.cleanString('MIEctermDX')} AS miectermdx,
    ${databuffet.functionData.castInt64('MIEtag')} AS mietag,
    ${databuffet.functionData.castFloat64('MIEbaseDT3')} AS miebasedt3,
    ${databuffet.functionData.castFloat64('MIEbaseDT53')} AS miebasedt53,
    ${databuffet.functionData.cleanString('MIEdescDT3')} AS miedescdt3,
    ${databuffet.functionData.cleanString('MIEdescDT53')} AS miedescdt53,
    ${databuffet.functionData.castInt64('MIEconDT3')} AS miecondt3,
    ${databuffet.functionData.castInt64('MIEconDT53')} AS miecondt53,
    ${databuffet.functionData.cleanString('MIErecFC')} AS mierecfc,
    ${databuffet.functionData.castFloat64('MIErecDT32')} AS mierecdt32,
    ${databuffet.functionData.castFloat64('MIErecDT532')} AS mierecdt532,
    ${databuffet.functionData.castFloat64('MIEbaseDT32')} AS miebasedt32,
    ${databuffet.functionData.castFloat64('MIEbaseDT532')} AS miebasedt532,
    ${databuffet.functionData.cleanString('MIEdescDT32')} AS miedescdt32,
    ${databuffet.functionData.cleanString('MIEdescDT532')} AS miedescdt532,
    ${databuffet.functionData.castInt64('MIEconDT32')} AS miecondt32,
    ${databuffet.functionData.castInt64('MIEconDT532')} AS miecondt532,
    ${databuffet.functionData.castFloat64('MIEperDT3')} AS mieperdt3,
    ${databuffet.functionData.castFloat64('MIEperDT32')} AS mieperdt32,
    ${databuffet.functionData.castFloat64('MIEperDT53')} AS mieperdt53,
    ${databuffet.functionData.castFloat64('MIEperDT532')} AS mieperdt532,
    ${databuffet.functionData.cleanString('MIEtaxpayNo')} AS mietaxpayno,
    ${databuffet.functionData.parseAsatDate()} AS asatdate
  FROM
    `${sourceTableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
