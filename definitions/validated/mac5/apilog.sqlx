config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "logid"],
    bigquery: {
        clusterBy: ["company_id", "logid"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "logid"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY company_id, ${pk_key.slice(1)} ORDER BY completedat desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.castInt64('logid')} as logid,
    ${databuffet.functionData.parseFlexibleDatetime('runat')} AS runat,
    ${databuffet.functionData.parseFlexibleDatetime('completedat')} AS completedat,
    ${databuffet.functionData.castInt64('issuccess')} as issuccess,
    ${databuffet.functionData.cleanString('errormessage')} as errormessage,
    ${databuffet.functionData.cleanString('resultjson')} as resultjson

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
QUALIFY ROW_NUMBER() OVER(PARTITION BY company_id, logid ORDER BY completedat desc) = 1

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
