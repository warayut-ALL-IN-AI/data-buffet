config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["mirday","mirmonth","miryear","mirtype","mirvnos","mircus","mirlistno"],
    bigquery: {
        clusterBy: ["mirtype", "mirvnos", "mircus", "mirlistno"]
    },
}

js {
    const project_id = databuffet.DATABASE
    const dataset_id = databuffet.RAW_MAC5
    const table_id = name()
    const pk_key = ["mirday","mirmonth","miryear","mirtype","mirvnos","mircus","mirlistno"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY mirbinvdate desc, mirdesc desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    CAST(mirday AS INT64) as mirday,
    CAST(mirmonth AS INT64) as mirmonth,
    CAST(miryear AS INT64) as miryear,
    NULLIF(CAST(TRIM(mirtype) AS STRING), '') as mirtype,
    NULLIF(CAST(TRIM(mirvnos) AS STRING), '') as mirvnos,
    NULLIF(CAST(TRIM(mircus) AS STRING), '') as mircus,
    CAST(mirlistno AS INT64) as mirlistno,
    NULLIF(CAST(TRIM(mirbinvno) AS STRING), '') as mirbinvno,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(mirbinvdate, 1, 19)) AS mirbinvdate,
    NULLIF(CAST(TRIM(mirbinvtype) AS STRING), '') as mirbinvtype,
    NULLIF(CAST(TRIM(mirdesc) AS STRING), '') as mirdesc,
    CAST(mircog AS FLOAT64) as mircog,
    CAST(mirvat AS FLOAT64) as mirvat,
    CAST(mirsum AS FLOAT64) as mirsum,
    CAST(mircurc AS INT64) as mircurc,
    CAST(mirexchg AS FLOAT64) as mirexchg,
    CAST(mirtag AS INT64) as mirtag,
    NULLIF(CAST(TRIM(mirnotes) AS STRING), '') as mirnotes,
    NULLIF(CAST(TRIM(miraccount) AS STRING), '') as miraccount

FROM
  `${project_id}.${dataset_id}.${table_id}`
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
