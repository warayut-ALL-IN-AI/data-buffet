config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "mirtype","mirvnos","mirlistno"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "mirtype", "mirvnos", "mircus"]
    },
}

js {
    const pk_key = ["company_id", "mirtype","mirvnos","mirlistno"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY mirbinvdate desc, mirdesc desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.castInt64('mirday')} as mirday,
    ${databuffet.castInt64('mirmonth')} as mirmonth,
    ${databuffet.castInt64('miryear')} as miryear,
    ${databuffet.cleanString('mirtype')} as mirtype,
    ${databuffet.cleanString('mirvnos')} as mirvnos,
    ${databuffet.cleanString('mircus')} as mircus,
    ${databuffet.castInt64('mirlistno')} as mirlistno,
    ${databuffet.cleanString('mirbinvno')} as mirbinvno,
    ${databuffet.parseFlexibleDatetime('mirbinvdate')} AS mirbinvdate,
    ${databuffet.cleanString('mirbinvtype')} as mirbinvtype,
    ${databuffet.cleanString('mirdesc')} as mirdesc,
    ${databuffet.castFloat64('mircog')} as mircog,
    ${databuffet.castFloat64('mirvat')} as mirvat,
    ${databuffet.castFloat64('mirsum')} as mirsum,
    ${databuffet.castInt64('mircurc')} as mircurc,
    ${databuffet.castFloat64('mirexchg')} as mirexchg,
    ${databuffet.castInt64('mirtag')} as mirtag,
    ${databuffet.cleanString('mirnotes')} as mirnotes,
    ${databuffet.cleanString('miraccount')} as miraccount,
    ${databuffet.parseAsatDate()} as asatdate

  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AG01}.mir`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }

  UNION ALL
  SELECT 'aa05' AS company_id,
    ${databuffet.castInt64('mirday')} as mirday,
    ${databuffet.castInt64('mirmonth')} as mirmonth,
    ${databuffet.castInt64('miryear')} as miryear,
    ${databuffet.cleanString('mirtype')} as mirtype,
    ${databuffet.cleanString('mirvnos')} as mirvnos,
    ${databuffet.cleanString('mircus')} as mircus,
    ${databuffet.castInt64('mirlistno')} as mirlistno,
    ${databuffet.cleanString('mirbinvno')} as mirbinvno,
    ${databuffet.parseFlexibleDatetime('mirbinvdate')} AS mirbinvdate,
    ${databuffet.cleanString('mirbinvtype')} as mirbinvtype,
    ${databuffet.cleanString('mirdesc')} as mirdesc,
    ${databuffet.castFloat64('mircog')} as mircog,
    ${databuffet.castFloat64('mirvat')} as mirvat,
    ${databuffet.castFloat64('mirsum')} as mirsum,
    ${databuffet.castInt64('mircurc')} as mircurc,
    ${databuffet.castFloat64('mirexchg')} as mirexchg,
    ${databuffet.castInt64('mirtag')} as mirtag,
    ${databuffet.cleanString('mirnotes')} as mirnotes,
    ${databuffet.cleanString('miraccount')} as miraccount,
    ${databuffet.parseAsatDate()} as asatdate

  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AA05}.mir`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }

  UNION ALL
  SELECT 'ab01' AS company_id,
    ${databuffet.castInt64('mirday')} as mirday,
    ${databuffet.castInt64('mirmonth')} as mirmonth,
    ${databuffet.castInt64('miryear')} as miryear,
    ${databuffet.cleanString('mirtype')} as mirtype,
    ${databuffet.cleanString('mirvnos')} as mirvnos,
    ${databuffet.cleanString('mircus')} as mircus,
    ${databuffet.castInt64('mirlistno')} as mirlistno,
    ${databuffet.cleanString('mirbinvno')} as mirbinvno,
    ${databuffet.parseFlexibleDatetime('mirbinvdate')} AS mirbinvdate,
    ${databuffet.cleanString('mirbinvtype')} as mirbinvtype,
    ${databuffet.cleanString('mirdesc')} as mirdesc,
    ${databuffet.castFloat64('mircog')} as mircog,
    ${databuffet.castFloat64('mirvat')} as mirvat,
    ${databuffet.castFloat64('mirsum')} as mirsum,
    ${databuffet.castInt64('mircurc')} as mircurc,
    ${databuffet.castFloat64('mirexchg')} as mirexchg,
    ${databuffet.castInt64('mirtag')} as mirtag,
    ${databuffet.cleanString('mirnotes')} as mirnotes,
    ${databuffet.cleanString('miraccount')} as miraccount,
    ${databuffet.parseAsatDate()} as asatdate

  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AB01}.mir`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }

  UNION ALL
  SELECT 'ac02' AS company_id,
    ${databuffet.castInt64('mirday')} as mirday,
    ${databuffet.castInt64('mirmonth')} as mirmonth,
    ${databuffet.castInt64('miryear')} as miryear,
    ${databuffet.cleanString('mirtype')} as mirtype,
    ${databuffet.cleanString('mirvnos')} as mirvnos,
    ${databuffet.cleanString('mircus')} as mircus,
    ${databuffet.castInt64('mirlistno')} as mirlistno,
    ${databuffet.cleanString('mirbinvno')} as mirbinvno,
    ${databuffet.parseFlexibleDatetime('mirbinvdate')} AS mirbinvdate,
    ${databuffet.cleanString('mirbinvtype')} as mirbinvtype,
    ${databuffet.cleanString('mirdesc')} as mirdesc,
    ${databuffet.castFloat64('mircog')} as mircog,
    ${databuffet.castFloat64('mirvat')} as mirvat,
    ${databuffet.castFloat64('mirsum')} as mirsum,
    ${databuffet.castInt64('mircurc')} as mircurc,
    ${databuffet.castFloat64('mirexchg')} as mirexchg,
    ${databuffet.castInt64('mirtag')} as mirtag,
    ${databuffet.cleanString('mirnotes')} as mirnotes,
    ${databuffet.cleanString('miraccount')} as miraccount,
    ${databuffet.parseAsatDate()} as asatdate

  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AC02}.mir`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }

  UNION ALL
  SELECT 'ak02' AS company_id,
    ${databuffet.castInt64('mirday')} as mirday,
    ${databuffet.castInt64('mirmonth')} as mirmonth,
    ${databuffet.castInt64('miryear')} as miryear,
    ${databuffet.cleanString('mirtype')} as mirtype,
    ${databuffet.cleanString('mirvnos')} as mirvnos,
    ${databuffet.cleanString('mircus')} as mircus,
    ${databuffet.castInt64('mirlistno')} as mirlistno,
    ${databuffet.cleanString('mirbinvno')} as mirbinvno,
    ${databuffet.parseFlexibleDatetime('mirbinvdate')} AS mirbinvdate,
    ${databuffet.cleanString('mirbinvtype')} as mirbinvtype,
    ${databuffet.cleanString('mirdesc')} as mirdesc,
    ${databuffet.castFloat64('mircog')} as mircog,
    ${databuffet.castFloat64('mirvat')} as mirvat,
    ${databuffet.castFloat64('mirsum')} as mirsum,
    ${databuffet.castInt64('mircurc')} as mircurc,
    ${databuffet.castFloat64('mirexchg')} as mirexchg,
    ${databuffet.castInt64('mirtag')} as mirtag,
    ${databuffet.cleanString('mirnotes')} as mirnotes,
    ${databuffet.cleanString('miraccount')} as miraccount,
    ${databuffet.parseAsatDate()} as asatdate

  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AK02}.mir`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }

)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
