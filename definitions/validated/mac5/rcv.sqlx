config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["company_id", "serial"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "serial"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "serial"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.cleanString('serial')} AS serial,
    ${databuffet.cleanString('rcvdate')} AS rcvdate,
    ${databuffet.castInt64('rcvtype')} AS rcvtype,
    ${databuffet.cleanString('rcvvnos')} AS rcvvnos,
    ${databuffet.cleanString('rcvstk')} AS rcvstk,
    ${databuffet.cleanString('descT1')} AS desct1,
    ${databuffet.cleanString('qty')} AS qty,
    ${databuffet.cleanString('unit')} AS unit,
    ${databuffet.cleanString('rcvsto')} AS rcvsto,
    ${databuffet.cleanString('username')} AS username,
    ${databuffet.cleanString('remark')} AS remark,
    ${databuffet.cleanString('rcvtime')} AS rcvtime,
    ${databuffet.cleanString('Fdatetime2')} AS fdatetime2,
    ${databuffet.cleanString('rcvStatus')} AS rcvstatus,
    ${databuffet.cleanString('rcvtypeFG')} AS rcvtypefg,
    ${databuffet.cleanString('rcvstatusMR')} AS rcvstatusmr,
    ${databuffet.cleanString('rcvzone')} AS rcvzone,
    ${databuffet.cleanString('rcvOrder')} AS rcvorder,
    ${databuffet.cleanString('rcvCommand')} AS rcvcommand,
    ${databuffet.cleanString('rcvExtCode')} AS rcvextcode,
    ${databuffet.cleanString('mixVnos')} AS mixvnos,
    ${databuffet.parseFlexibleDatetime('mixDate')} AS mixdate,
    ${databuffet.cleanString('rcvTranCode')} AS rcvtrancode,
    ${databuffet.castInt64('rcvCancel')} AS rcvcancel,
    ${databuffet.cleanString('rcvOrder_Pack')} AS rcvorder_pack,
    ${databuffet.cleanString('adjVnos')} AS adjvnos,
    ${databuffet.cleanString('PackDate')} AS packdate,
    ${databuffet.cleanString('PackTime')} AS packtime,
    ${databuffet.castInt64('rcvConvert')} AS rcvconvert,
    ${databuffet.cleanString('Odate')} AS odate,
    ${databuffet.cleanString('Ouser')} AS ouser,
    ${databuffet.castInt64('FMIL2LISTNO')} AS fmil2listno,
    ${databuffet.cleanString('Ostatus')} AS ostatus,
    ${databuffet.parseAsatDate()} AS asatdate
  FROM
    `${sourceTableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
