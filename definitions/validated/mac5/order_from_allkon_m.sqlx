config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "id"],
    bigquery: {
        clusterBy: ["company_id", "id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY update_date desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.castInt64('id')} as id,
    ${databuffet.functionData.cleanString('order_no')} as order_no,
    ${databuffet.functionData.cleanString('status')} as status,
    ${databuffet.functionData.parseFlexibleDatetime('create_date')} AS create_date,
    ${databuffet.functionData.cleanString('promotion_type')} as promotion_type,
    ${databuffet.functionData.cleanString('notes')} as notes,
    ${databuffet.functionData.cleanString('sub_order')} as sub_order,
    ${databuffet.functionData.cleanString('made_from')} as made_from,
    ${databuffet.functionData.parseFlexibleDatetime('datetime')} AS datetime,
    ${databuffet.functionData.cleanString('deliverystatus')} as deliverystatus,
    ${databuffet.functionData.cleanString('cancelstatus')} as cancelstatus,
    ${databuffet.functionData.cleanString('confirmstatus')} as confirmstatus,
    ${databuffet.functionData.cleanString('order_source')} as order_source,
    ${databuffet.functionData.castInt64('is_complete')} as is_complete,
    ${databuffet.functionData.parseFlexibleDatetime('update_date')} AS update_date

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
