config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "crecode"],
    bigquery: {
        clusterBy: ["company_id", "crecode"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "crecode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY crenamet desc, crenamee desc, credate desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.cleanString('crecode')} as crecode,
    ${databuffet.cleanString('cregroup')} as cregroup,
    ${databuffet.cleanString('crenamet')} as crenamet,
    ${databuffet.cleanString('crenamee')} as crenamee,
    ${databuffet.cleanString('crecontactt')} as crecontactt,
    ${databuffet.cleanString('crecontacte')} as crecontacte,
    ${databuffet.cleanString('creadd1at')} as creadd1at,
    ${databuffet.cleanString('creadd2at')} as creadd2at,
    ${databuffet.cleanString('creadd3at')} as creadd3at,
    ${databuffet.cleanString('creadd1ae')} as creadd1ae,
    ${databuffet.cleanString('creadd2ae')} as creadd2ae,
    ${databuffet.cleanString('creadd3ae')} as creadd3ae,
    ${databuffet.cleanString('cretel')} as cretel,
    ${databuffet.cleanString('cretaxnos')} as cretaxnos,
    ${databuffet.cleanString('crezone')} as crezone,
    ${databuffet.cleanString('cregrade')} as cregrade,
    ${databuffet.castFloat64('crelimit')} as crelimit,
    ${databuffet.castFloat64('cretaxclass')} as cretaxclass,
    ${databuffet.castInt64('cregoodsdef')} as cregoodsdef,
    ${databuffet.castInt64('crecreditterm')} as crecreditterm,
    ${databuffet.parseFlexibleDatetime('credate')} AS credate,
    ${databuffet.castInt64('crehide')} as crehide,
    ${databuffet.cleanString('crefax')} as crefax,
    ${databuffet.cleanString('creemail')} as creemail,
    ${databuffet.castFloat64('cretarget')} as cretarget,
    ${databuffet.cleanString('crememo')} as crememo,
    ${databuffet.cleanString('creac')} as creac,
    ${databuffet.castInt64('crelock')} as crelock,
    ${databuffet.cleanString('creoname')} as creoname,
    ${databuffet.cleanString('creprice')} as creprice,
    ${databuffet.parseFlexibleDatetime('creeditlk')} AS creeditlk,
    ${databuffet.cleanString('crerefwe')} as crerefwe,
    ${databuffet.cleanString('cresortnt')} as cresortnt,
    ${databuffet.cleanString('cresortne')} as cresortne,
    ${databuffet.cleanString('crecardid')} as crecardid,
    ${databuffet.parseFlexibleDatetime('creeditdt')} AS creeditdt,
    ${databuffet.cleanString('creeditmf')} as creeditmf,
    ${databuffet.castInt64('cretaxtype')} as cretaxtype,
    ${databuffet.castInt64('creinex')} as creinex,
    ${databuffet.cleanString('crebranch')} as crebranch

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
