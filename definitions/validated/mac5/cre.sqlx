config {
    type: "table",
    schema: databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MAC5,
    dependencies: ["validated_schema_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["crecode"],
    bigquery: {
        clusterBy: ["crecode"]
    },
}

js {
    const project_id = databuffet.DATABASE
    const dataset_id = databuffet.RAW_SCHEMA + "_" + databuffet.SOURCE_MAC5
    const table_id = name()
    const pk_key = ["crecode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY crenamet desc, crenamee desc, credate desc) = 1`;
        post_operations_statement = `ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
    ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    NULLIF(CAST(TRIM(crecode) AS STRING), '') as crecode,
    NULLIF(CAST(TRIM(cregroup) AS STRING), '') as cregroup,
    NULLIF(CAST(TRIM(crenamet) AS STRING), '') as crenamet,
    NULLIF(CAST(TRIM(crenamee) AS STRING), '') as crenamee,
    NULLIF(CAST(TRIM(crecontactt) AS STRING), '') as crecontactt,
    NULLIF(CAST(TRIM(crecontacte) AS STRING), '') as crecontacte,
    NULLIF(CAST(TRIM(creadd1at) AS STRING), '') as creadd1at,
    NULLIF(CAST(TRIM(creadd2at) AS STRING), '') as creadd2at,
    NULLIF(CAST(TRIM(creadd3at) AS STRING), '') as creadd3at,
    NULLIF(CAST(TRIM(creadd1ae) AS STRING), '') as creadd1ae,
    NULLIF(CAST(TRIM(creadd2ae) AS STRING), '') as creadd2ae,
    NULLIF(CAST(TRIM(creadd3ae) AS STRING), '') as creadd3ae,
    NULLIF(CAST(TRIM(cretel) AS STRING), '') as cretel,
    NULLIF(CAST(TRIM(cretaxnos) AS STRING), '') as cretaxnos,
    NULLIF(CAST(TRIM(crezone) AS STRING), '') as crezone,
    NULLIF(CAST(TRIM(cregrade) AS STRING), '') as cregrade,
    CAST(crelimit AS FLOAT64) as crelimit,
    CAST(cretaxclass AS FLOAT64) as cretaxclass,
    CAST(cregoodsdef AS INT64) as cregoodsdef,
    CAST(crecreditterm AS INT64) as crecreditterm,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(credate, 1, 19)) AS credate,
    CAST(crehide AS INT64) as crehide,
    NULLIF(CAST(TRIM(crefax) AS STRING), '') as crefax,
    NULLIF(CAST(TRIM(creemail) AS STRING), '') as creemail,
    CAST(cretarget AS FLOAT64) as cretarget,
    NULLIF(CAST(TRIM(crememo) AS STRING), '') as crememo,
    NULLIF(CAST(TRIM(creac) AS STRING), '') as creac,
    CAST(crelock AS INT64) as crelock,
    NULLIF(CAST(TRIM(creoname) AS STRING), '') as creoname,
    NULLIF(CAST(TRIM(creprice) AS STRING), '') as creprice,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(creeditlk, 1, 19)) AS creeditlk,
    NULLIF(CAST(TRIM(crerefwe) AS STRING), '') as crerefwe,
    NULLIF(CAST(TRIM(cresortnt) AS STRING), '') as cresortnt,
    NULLIF(CAST(TRIM(cresortne) AS STRING), '') as cresortne,
    NULLIF(CAST(TRIM(crecardid) AS STRING), '') as crecardid,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(creeditdt, 1, 19)) AS creeditdt,
    NULLIF(CAST(TRIM(creeditmf) AS STRING), '') as creeditmf,
    CAST(cretaxtype AS INT64) as cretaxtype,
    CAST(creinex AS INT64) as creinex,
    NULLIF(CAST(TRIM(crebranch) AS STRING), '') as crebranch

FROM
  `${project_id}.${dataset_id}.${table_id}`
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
