config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: [],
    bigquery: {
        clusterBy: ["company_id", "vendorno"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = []

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY vendorname desc, sitename desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.cleanString('crdate')} as crdate,
    ${databuffet.cleanString('vendorno')} as vendorno,
    ${databuffet.cleanString('vendorname')} as vendorname,
    ${databuffet.cleanString('newpo')} as newpo,
    ${databuffet.cleanString('pono')} as pono,
    ${databuffet.cleanString('podate')} as podate,
    ${databuffet.cleanString('potype')} as potype,
    ${databuffet.cleanString('deliverydate')} as deliverydate,
    ${databuffet.cleanString('siteno')} as siteno,
    ${databuffet.cleanString('sitename')} as sitename,
    ${databuffet.cleanString('siteaddress')} as siteaddress,
    ${databuffet.cleanString('totalqty')} as totalqty,
    ${databuffet.cleanString('totalamount')} as totalamount,
    ${databuffet.cleanString('totalitem')} as totalitem,
    ${databuffet.cleanString('cancelpo')} as cancelpo,
    ${databuffet.cleanString('termcode')} as termcode,
    ${databuffet.cleanString('poremark')} as poremark,
    ${databuffet.cleanString('quotationno')} as quotationno,
    ${databuffet.cleanString('quotationdate')} as quotationdate,
    ${databuffet.cleanString('poitemno')} as poitemno,
    ${databuffet.cleanString('artno')} as artno,
    ${databuffet.cleanString('artdesc')} as artdesc,
    ${databuffet.cleanString('hpeancode')} as hpeancode,
    ${databuffet.cleanString('vdeancode')} as vdeancode,
    ${databuffet.cleanString('vdproductname')} as vdproductname,
    ${databuffet.cleanString('qty')} as qty,
    ${databuffet.cleanString('purchunit')} as purchunit,
    ${databuffet.cleanString('price')} as price,
    ${databuffet.cleanString('qtyperunit')} as qtyperunit,
    ${databuffet.cleanString('priceperunit')} as priceperunit,
    ${databuffet.cleanString('priceunit')} as priceunit,
    ${databuffet.cleanString('packsize')} as packsize,
    ${databuffet.cleanString('articleremark')} as articleremark,
    ${databuffet.cleanString('freegoodsflag')} as freegoodsflag,
    ${databuffet.cleanString('stk')} as stk,
    ${databuffet.cleanString('novat')} as novat,
    ${databuffet.cleanString('attfile')} as attfile,
    ${databuffet.cleanString('statusticket')} as statusticket,
    ${databuffet.cleanString('duedate')} as duedate,
    ${databuffet.cleanString('reciver')} as reciver,
    ${databuffet.cleanString('deladd')} as deladd,
    ${databuffet.cleanString('que')} as que,
    ${databuffet.cleanString('delvname')} as delvname,
    ${databuffet.cleanString('delvtel')} as delvtel,
    ${databuffet.cleanString('credit')} as credit,
    ${databuffet.parseFlexibleDatetime('dinsert')} as dinsert
  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
