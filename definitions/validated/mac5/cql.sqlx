config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5", "create_all_table_raw_mac5_aa05", "create_all_table_raw_mac5_ab01", "create_all_table_raw_mac5_ac02", "create_all_table_raw_mac5_ak02"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["company_id", "cqlbank", "cqlno", "cqlsys", "cqlday", "cqlmonth", "cqlyear", "cqlautono"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "cqlbank", "cqlyear", "cqlmonth"]
    },
}

js {
    const pk_key = ["company_id", "cqlbank", "cqlno", "cqlsys", "cqlday", "cqlmonth", "cqlyear", "cqlautono"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT
    'ag01' AS company_id,
    ${databuffet.functionData.parseFlexibleDatetime('CQLdate')} AS cqldate,
    ${databuffet.functionData.cleanString('CQLbank')} AS cqlbank,
    ${databuffet.functionData.cleanString('CQLno')} AS cqlno,
    ${databuffet.functionData.castInt64('CQLsys')} AS cqlsys,
    ${databuffet.functionData.castInt64('CQLday')} AS cqlday,
    ${databuffet.functionData.castInt64('CQLmonth')} AS cqlmonth,
    ${databuffet.functionData.castInt64('CQLyear')} AS cqlyear,
    ${databuffet.functionData.castInt64('CQLbook')} AS cqlbook,
    ${databuffet.functionData.cleanString('CQLvnos')} AS cqlvnos,
    ${databuffet.functionData.castFloat64('CQLsumL')} AS cqlsuml,
    ${databuffet.functionData.cleanString('CQLmivt')} AS cqlmivt,
    ${databuffet.functionData.cleanString('CQLcus')} AS cqlcus,
    ${databuffet.functionData.castInt64('CQLtag')} AS cqltag,
    ${databuffet.functionData.castInt64('CQLAutoNO')} AS cqlautono,
    ${databuffet.functionData.parseAsatDate()} AS asatdate
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AG01}.cql`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }

  UNION ALL

  SELECT
    'aa05' AS company_id,
    ${databuffet.functionData.parseFlexibleDatetime('CQLdate')} AS cqldate,
    ${databuffet.functionData.cleanString('CQLbank')} AS cqlbank,
    ${databuffet.functionData.cleanString('CQLno')} AS cqlno,
    ${databuffet.functionData.castInt64('CQLsys')} AS cqlsys,
    ${databuffet.functionData.castInt64('CQLday')} AS cqlday,
    ${databuffet.functionData.castInt64('CQLmonth')} AS cqlmonth,
    ${databuffet.functionData.castInt64('CQLyear')} AS cqlyear,
    ${databuffet.functionData.castInt64('CQLbook')} AS cqlbook,
    ${databuffet.functionData.cleanString('CQLvnos')} AS cqlvnos,
    ${databuffet.functionData.castFloat64('CQLsumL')} AS cqlsuml,
    ${databuffet.functionData.cleanString('CQLmivt')} AS cqlmivt,
    ${databuffet.functionData.cleanString('CQLcus')} AS cqlcus,
    ${databuffet.functionData.castInt64('CQLtag')} AS cqltag,
    ${databuffet.functionData.castInt64('CQLAutoNO')} AS cqlautono,
    ${databuffet.functionData.parseAsatDate()} AS asatdate
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AA05}.cql`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }

  UNION ALL

  SELECT
    'ab01' AS company_id,
    ${databuffet.functionData.parseFlexibleDatetime('CQLdate')} AS cqldate,
    ${databuffet.functionData.cleanString('CQLbank')} AS cqlbank,
    ${databuffet.functionData.cleanString('CQLno')} AS cqlno,
    ${databuffet.functionData.castInt64('CQLsys')} AS cqlsys,
    ${databuffet.functionData.castInt64('CQLday')} AS cqlday,
    ${databuffet.functionData.castInt64('CQLmonth')} AS cqlmonth,
    ${databuffet.functionData.castInt64('CQLyear')} AS cqlyear,
    ${databuffet.functionData.castInt64('CQLbook')} AS cqlbook,
    ${databuffet.functionData.cleanString('CQLvnos')} AS cqlvnos,
    ${databuffet.functionData.castFloat64('CQLsumL')} AS cqlsuml,
    ${databuffet.functionData.cleanString('CQLmivt')} AS cqlmivt,
    ${databuffet.functionData.cleanString('CQLcus')} AS cqlcus,
    ${databuffet.functionData.castInt64('CQLtag')} AS cqltag,
    ${databuffet.functionData.castInt64('CQLAutoNO')} AS cqlautono,
    ${databuffet.functionData.parseAsatDate()} AS asatdate
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AB01}.cql`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }

  UNION ALL

  SELECT
    'ac02' AS company_id,
    ${databuffet.functionData.parseFlexibleDatetime('CQLdate')} AS cqldate,
    ${databuffet.functionData.cleanString('CQLbank')} AS cqlbank,
    ${databuffet.functionData.cleanString('CQLno')} AS cqlno,
    ${databuffet.functionData.castInt64('CQLsys')} AS cqlsys,
    ${databuffet.functionData.castInt64('CQLday')} AS cqlday,
    ${databuffet.functionData.castInt64('CQLmonth')} AS cqlmonth,
    ${databuffet.functionData.castInt64('CQLyear')} AS cqlyear,
    ${databuffet.functionData.castInt64('CQLbook')} AS cqlbook,
    ${databuffet.functionData.cleanString('CQLvnos')} AS cqlvnos,
    ${databuffet.functionData.castFloat64('CQLsumL')} AS cqlsuml,
    ${databuffet.functionData.cleanString('CQLmivt')} AS cqlmivt,
    ${databuffet.functionData.cleanString('CQLcus')} AS cqlcus,
    ${databuffet.functionData.castInt64('CQLtag')} AS cqltag,
    ${databuffet.functionData.castInt64('CQLAutoNO')} AS cqlautono,
    ${databuffet.functionData.parseAsatDate()} AS asatdate
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AC02}.cql`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }

  UNION ALL

  SELECT
    'ak02' AS company_id,
    ${databuffet.functionData.parseFlexibleDatetime('CQLdate')} AS cqldate,
    ${databuffet.functionData.cleanString('CQLbank')} AS cqlbank,
    ${databuffet.functionData.cleanString('CQLno')} AS cqlno,
    ${databuffet.functionData.castInt64('CQLsys')} AS cqlsys,
    ${databuffet.functionData.castInt64('CQLday')} AS cqlday,
    ${databuffet.functionData.castInt64('CQLmonth')} AS cqlmonth,
    ${databuffet.functionData.castInt64('CQLyear')} AS cqlyear,
    ${databuffet.functionData.castInt64('CQLbook')} AS cqlbook,
    ${databuffet.functionData.cleanString('CQLvnos')} AS cqlvnos,
    ${databuffet.functionData.castFloat64('CQLsumL')} AS cqlsuml,
    ${databuffet.functionData.cleanString('CQLmivt')} AS cqlmivt,
    ${databuffet.functionData.cleanString('CQLcus')} AS cqlcus,
    ${databuffet.functionData.castInt64('CQLtag')} AS cqltag,
    ${databuffet.functionData.castInt64('CQLAutoNO')} AS cqlautono,
    ${databuffet.functionData.parseAsatDate()} AS asatdate
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AK02}.cql`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }
)

SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
