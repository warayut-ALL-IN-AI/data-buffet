config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["stkcode"],
    bigquery: {
        clusterBy: ["stkcode"]
    },
}

js {
    const project_id = databuffet.DATABASE
    const dataset_id = databuffet.RAW_MAC5
    const table_id = name()
    const pk_key = ["stkcode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY stkdesct1 DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    NULLIF(CAST(TRIM(stkcode) AS STRING), '') as stkcode,
    NULLIF(CAST(TRIM(stkgroup) AS STRING), '') as stkgroup,
    NULLIF(CAST(TRIM(stkdesct1) AS STRING), '') as stkdesct1,
    NULLIF(CAST(TRIM(zgroup1) AS STRING), '') as zgroup1,
    NULLIF(CAST(TRIM(zgroup2) AS STRING), '') as zgroup2,
    NULLIF(CAST(TRIM(zsize) AS STRING), '') as zsize,
    NULLIF(CAST(TRIM(zcolor) AS STRING), '') as zcolor,
    NULLIF(CAST(TRIM(zgroup3) AS STRING), '') as zgroup3,
    NULLIF(CAST(TRIM(zgroup4) AS STRING), '') as zgroup4,
    NULLIF(CAST(TRIM(zgroup5) AS STRING), '') as zgroup5,
    NULLIF(CAST(TRIM(zgroup6) AS STRING), '') as zgroup6,
    NULLIF(CAST(TRIM(zgroup7) AS STRING), '') as zgroup7
FROM
  `${project_id}.${dataset_id}.${table_id}`
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
