config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: [],
    bigquery: {
        clusterBy: ["company_id", "mihtype", "mihvnos", "mihcus"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = []

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY mihkeydate desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.castInt64('mihday')} as mihday,
    ${databuffet.functionData.castInt64('mihmonth')} as mihmonth,
    ${databuffet.functionData.castInt64('mihyear')} as mihyear,
    ${databuffet.functionData.cleanString('mihtype')} as mihtype,
    ${databuffet.functionData.cleanString('mihvnos')} as mihvnos,
    ${databuffet.functionData.cleanString('mihcus')} as mihcus,
    ${databuffet.functionData.cleanString('mihjob')} as mihjob,
    ${databuffet.functionData.cleanString('mihdep')} as mihdep,
    ${databuffet.functionData.cleanString('mihper')} as mihper,
    ${databuffet.functionData.cleanString('mihdoc')} as mihdoc,
    ${databuffet.functionData.cleanString('mihmec')} as mihmec,
    ${databuffet.functionData.cleanString('mihvatno')} as mihvatno,
    ${databuffet.functionData.cleanString('mihdesc')} as mihdesc,
    ${databuffet.functionData.cleanString('mihmemo')} as mihmemo,
    ${databuffet.functionData.cleanString('mihnotes')} as mihnotes,
    ${databuffet.functionData.cleanString('mihref1')} as mihref1,
    ${databuffet.functionData.cleanString('mihref2')} as mihref2,
    ${databuffet.functionData.cleanString('mihref3')} as mihref3,
    ${databuffet.functionData.cleanString('mihdischt1')} as mihdischt1,
    ${databuffet.functionData.cleanString('mihdischt2')} as mihdischt2,
    ${databuffet.functionData.cleanString('mihdelvsite')} as mihdelvsite,
    ${databuffet.functionData.parseFlexibleDatetime('mihdelvdate')} AS mihdelvdate,
    ${databuffet.functionData.castInt64('mihstanding')} as mihstanding,
    ${databuffet.functionData.castInt64('mihlinkgl')} as mihlinkgl,
    ${databuffet.functionData.castInt64('mihnouplink')} as mihnouplink,
    ${databuffet.functionData.castInt64('mihnolist')} as mihnolist,
    ${databuffet.functionData.castInt64('mihcurc')} as mihcurc,
    ${databuffet.functionData.castInt64('mihvatinlist')} as mihvatinlist,
    ${databuffet.functionData.castInt64('mihlock')} as mihlock,
    ${databuffet.functionData.castInt64('mihprintn')} as mihprintn,
    ${databuffet.functionData.castInt64('mihcheque')} as mihcheque,
    ${databuffet.functionData.castInt64('mihcancel')} as mihcancel,
    ${databuffet.functionData.castInt64('mihstatus')} as mihstatus,
    ${databuffet.functionData.castInt64('mihclearum')} as mihclearum,
    ${databuffet.functionData.castInt64('mihctermno')} as mihctermno,
    ${databuffet.functionData.castFloat64('mihcog')} as mihcog,
    ${databuffet.functionData.castFloat64('mihvatsum')} as mihvatsum,
    ${databuffet.functionData.castFloat64('mihnetsum')} as mihnetsum,
    ${databuffet.functionData.castFloat64('mihdisclst')} as mihdisclst,
    ${databuffet.functionData.castFloat64('mihdischf1')} as mihdischf1,
    ${databuffet.functionData.castFloat64('mihdischf2')} as mihdischf2,
    ${databuffet.functionData.castFloat64('mihexchg')} as mihexchg,
    ${databuffet.functionData.castFloat64('mihextrasum')} as mihextrasum,
    ${databuffet.functionData.castFloat64('mihextravat')} as mihextravat,
    ${databuffet.functionData.castInt64('mihextracut')} as mihextracut,
    ${databuffet.functionData.cleanString('mihextramem')} as mihextramem,
    ${databuffet.functionData.cleanString('mihrecno')} as mihrecno,
    ${databuffet.functionData.parseFlexibleDatetime('mihrecdate')} AS mihrecdate,
    ${databuffet.functionData.cleanString('mihsavetag')} as mihsavetag,
    ${databuffet.functionData.cleanString('mihkeyuser')} as mihkeyuser,
    ${databuffet.functionData.parseFlexibleDatetime('mihkeydate')} AS mihkeydate,
    ${databuffet.functionData.cleanString('mihdocrunno')} as mihdocrunno,
    ${databuffet.functionData.parseFlexibleDatetime('mihdategl')} AS mihdategl,
    ${databuffet.functionData.parseFlexibleDatetime('mihduepo')} AS mihduepo,
    ${databuffet.functionData.parseFlexibleDatetime('miheditlk')} AS miheditlk,
    ${databuffet.functionData.castInt64('mihiscf')} as mihiscf,
    ${databuffet.functionData.castInt64('mihissp')} as mihissp,
    ${databuffet.functionData.parseFlexibleDatetime('mihdates1')} AS mihdates1,
    ${databuffet.functionData.parseFlexibleDatetime('mihdates2')} AS mihdates2,
    ${databuffet.functionData.castInt64('mihnumsi')} as mihnumsi,
    ${databuffet.functionData.castFloat64('mihnumsc')} as mihnumsc,
    ${databuffet.functionData.castFloat64('mihvatpc')} as mihvatpc,
    ${databuffet.functionData.castInt64('mihincluded')} as mihincluded,
    ${databuffet.functionData.cleanString('mihtaxvnos')} as mihtaxvnos,
    ${databuffet.functionData.parseFlexibleDatetime('mihtaxdate')} AS mihtaxdate,
    ${databuffet.functionData.castFloat64('mihtaxsum')} as mihtaxsum,
    ${databuffet.functionData.castInt64('mihload')} as mihload,
    ${databuffet.functionData.parseFlexibleDatetime('mihpaiddate')} AS mihpaiddate,
    ${databuffet.functionData.cleanString('mihbookordernum')} as mihbookordernum,
    ${databuffet.functionData.parseFlexibleDatetime('mihsenddate')} AS mihsenddate,
    ${databuffet.functionData.castInt64('mihbl')} as mihbl,
    ${databuffet.functionData.castInt64('mihrpv')} as mihrpv,
    ${databuffet.functionData.castInt64('mihclearcut')} as mihclearcut,
    ${databuffet.functionData.castInt64('mihsettlecut')} as mihsettlecut,
    ${databuffet.functionData.cleanString('mihdebbranch')} as mihdebbranch,
    ${databuffet.functionData.cleanString('mihdebtaxnos')} as mihdebtaxnos

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
