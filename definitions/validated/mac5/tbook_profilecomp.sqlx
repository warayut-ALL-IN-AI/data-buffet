config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: [],
    bigquery: {
        clusterBy: ["company_id", "docno"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = []

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY dupdate desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.castInt64('docno')} as docno,
    ${databuffet.functionData.castInt64('projectcode')} as projectcode,
    ${databuffet.functionData.cleanString('projectname')} as projectname,
    ${databuffet.functionData.cleanString('statuscomp')} as statuscomp,
    ${databuffet.functionData.cleanString('compname')} as compname,
    ${databuffet.functionData.cleanString('register')} as register,
    ${databuffet.functionData.cleanString('addresscomp')} as addresscomp,
    ${databuffet.functionData.cleanString('province')} as province,
    ${databuffet.functionData.cleanString('district')} as district,
    ${databuffet.functionData.cleanString('country')} as country,
    ${databuffet.functionData.cleanString('status')} as status,
    ${databuffet.functionData.cleanString('capital')} as capital,
    ${databuffet.functionData.cleanString('place')} as place,
    ${databuffet.functionData.cleanString('tel')} as tel,
    ${databuffet.functionData.cleanString('mobile')} as mobile,
    ${databuffet.functionData.cleanString('fax')} as fax,
    ${databuffet.functionData.cleanString('mail')} as mail,
    ${databuffet.functionData.cleanString('namedirector')} as namedirector,
    ${databuffet.functionData.cleanString('nickname')} as nickname,
    ${databuffet.functionData.cleanString('teldirector')} as teldirector,
    ${databuffet.functionData.cleanString('profilecomp')} as profilecomp,
    ${databuffet.functionData.cleanString('typecomp')} as typecomp,
    ${databuffet.functionData.cleanString('startdate')} as startdate,
    ${databuffet.functionData.cleanString('history')} as history,
    ${databuffet.functionData.cleanString('pjstart')} as pjstart,
    ${databuffet.functionData.cleanString('pjend')} as pjend,
    ${databuffet.functionData.cleanString('pjval')} as pjval,
    ${databuffet.functionData.cleanString('pjfor')} as pjfor,
    ${databuffet.functionData.cleanString('compgroup')} as compgroup,
    ${databuffet.functionData.cleanString('acccode')} as acccode,
    ${databuffet.functionData.cleanString('accname')} as accname,
    ${databuffet.functionData.cleanString('closedby')} as closedby,
    ${databuffet.functionData.cleanString('projectfrom')} as projectfrom,
    ${databuffet.functionData.cleanString('ptype')} as ptype,
    ${databuffet.functionData.cleanString('ppc')} as ppc,
    ${databuffet.functionData.cleanString('pecom')} as pecom,
    ${databuffet.functionData.cleanString('uinsert')} as uinsert,
    ${databuffet.functionData.parseFlexibleDatetime('dinsert')} AS dinsert,
    ${databuffet.functionData.cleanString('insertby')} as insertby,
    ${databuffet.functionData.cleanString('uupdate')} as uupdate,
    ${databuffet.functionData.parseFlexibleDatetime('dupdate')} AS dupdate,
    ${databuffet.functionData.cleanString('meccode')} as meccode,
    ${databuffet.functionData.cleanString('contactdebcode')} as contactdebcode,
    ${databuffet.functionData.cleanString('refallkon')} as refallkon

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
