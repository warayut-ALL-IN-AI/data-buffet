config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: [],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "cpsstkid"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = []

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.cleanString('CPSstkID')} AS cpsstkid,
    ${databuffet.functionData.castInt64('CPSlinkID')} AS cpslinkid,
    ${databuffet.functionData.cleanString('CPSvnosID')} AS cpsvnosid,
    ${databuffet.functionData.parseFlexibleDatetime('CPSdateID')} AS cpsdateid,
    ${databuffet.functionData.cleanString('CPScusID')} AS cpscusid,
    ${databuffet.functionData.cleanString('CPSjob')} AS cpsjob,
    ${databuffet.functionData.cleanString('CPSdep')} AS cpsdep,
    ${databuffet.functionData.cleanString('CPSper')} AS cpsper,
    ${databuffet.functionData.cleanString('CPSdoc')} AS cpsdoc,
    ${databuffet.functionData.cleanString('CPSmec')} AS cpsmec,
    ${databuffet.functionData.cleanString('CPSsto')} AS cpssto,
    ${databuffet.functionData.castFloat64('CPSstkREQ')} AS cpsstkreq,
    ${databuffet.functionData.castFloat64('CPSstkCUT1')} AS cpsstkcut1,
    ${databuffet.functionData.castFloat64('CPSstkCUT2')} AS cpsstkcut2,
    ${databuffet.functionData.castFloat64('CPSsumREQ')} AS cpssumreq,
    ${databuffet.functionData.castFloat64('CPSsumCUT1')} AS cpssumcut1,
    ${databuffet.functionData.castFloat64('CPSsumCUT2')} AS cpssumcut2,
    ${databuffet.functionData.castInt64('CPSclearSTK')} AS cpsclearstk,
    ${databuffet.functionData.castInt64('CPSclearSUM')} AS cpsclearsum,
    ${databuffet.functionData.castInt64('CPSclearUSER')} AS cpsclearuser,
    ${databuffet.functionData.castInt64('CPSclearALL')} AS cpsclearall,
    ${databuffet.functionData.castInt64('CPScurC')} AS cpscurc,
    ${databuffet.functionData.castFloat64('CPSexchg')} AS cpsexchg,
    ${databuffet.functionData.castInt64('CPScut')} AS cpscut,
    ${databuffet.functionData.parseFlexibleDatetime('CPSdelvDate')} AS cpsdelvdate,
    ${databuffet.functionData.castInt64('CPSlistNo')} AS cpslistno,
    ${databuffet.functionData.parseAsatDate()} AS asatdate
  FROM
    `${sourceTableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE('Asia/Bangkok')-1)`) }
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
