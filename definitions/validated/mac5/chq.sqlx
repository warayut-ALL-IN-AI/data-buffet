      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqdatec, 1, 19))
    ) AS chqdatec,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(chqdater, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqdater, 1, 19))
    ) AS chqdater,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(chqdatep, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqdatep, 1, 19))
    ) AS chqdatep,
    CAST(chqtype AS INT64) as chqtype,
    CAST(chqstatus AS INT64) as chqstatus,
    CAST(chqtotal AS FLOAT64) as chqtotal,
    NULLIF(CAST(TRIM(chqmemo) AS STRING), '') as chqmemo,
    CAST(chqgl AS INT64) as chqgl,
    CAST(chqmi AS INT64) as chqmi,
    CAST(chqown AS INT64) as chqown,
    CAST(chqtag AS INT64) as chqtag,
    CAST(chqstatusn AS INT64) as chqstatusn,
    CAST(chqlock AS INT64) as chqlock,
    CAST(chqpassgl AS INT64) as chqpassgl,
    NULLIF(CAST(TRIM(chqjob) AS STRING), '') as chqjob,
    NULLIF(CAST(TRIM(chqdep) AS STRING), '') as chqdep,
    NULLIF(CAST(TRIM(chqper) AS STRING), '') as chqper,
    NULLIF(CAST(TRIM(chqzon) AS STRING), '') as chqzon,
    NULLIF(CAST(TRIM(chqrcode) AS STRING), '') as chqrcode,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(chqeditlk, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqeditlk, 1, 19))
    ) AS chqeditlk,
    NULLIF(CAST(TRIM(chqkeyuser) AS STRING), '') as chqkeyuser,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(chqkeydate, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqkeydate, 1, 19))
    ) AS chqkeydate,
    CAST(chqdeduct AS FLOAT64) as chqdeduct,
    NULLIF(CAST(TRIM(chqecode) AS STRING), '') as chqecode,
    NULLIF(CAST(TRIM(chqbranch) AS STRING), '') as chqbranch,
    NULLIF(CAST(TRIM(chqmec) AS STRING), '') as chqmec,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(chqdatev, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqdatev, 1, 19))
    ) AS chqdatev
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AB01}.chq`

  UNION ALL

  SELECT
    'ac02' AS company_id,
    NULLIF(CAST(TRIM(chqno) AS STRING), '') as chqno,
    NULLIF(CAST(TRIM(chqbank) AS STRING), '') as chqbank,
    NULLIF(CAST(TRIM(chqacode) AS STRING), '') as chqacode,
    NULLIF(CAST(TRIM(chqcus) AS STRING), '') as chqcus,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(chqdatec, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqdatec, 1, 19))
    ) AS chqdatec,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(chqdater, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqdater, 1, 19))
    ) AS chqdater,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(chqdatep, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqdatep, 1, 19))
    ) AS chqdatep,
    CAST(chqtype AS INT64) as chqtype,
    CAST(chqstatus AS INT64) as chqstatus,
    CAST(chqtotal AS FLOAT64) as chqtotal,
    NULLIF(CAST(TRIM(chqmemo) AS STRING), '') as chqmemo,
    CAST(chqgl AS INT64) as chqgl,
    CAST(chqmi AS INT64) as chqmi,
    CAST(chqown AS INT64) as chqown,
    CAST(chqtag AS INT64) as chqtag,
    CAST(chqstatusn AS INT64) as chqstatusn,
    CAST(chqlock AS INT64) as chqlock,
    CAST(chqpassgl AS INT64) as chqpassgl,
    NULLIF(CAST(TRIM(chqjob) AS STRING), '') as chqjob,
    NULLIF(CAST(TRIM(chqdep) AS STRING), '') as chqdep,
    NULLIF(CAST(TRIM(chqper) AS STRING), '') as chqper,
    NULLIF(CAST(TRIM(chqzon) AS STRING), '') as chqzon,
    NULLIF(CAST(TRIM(chqrcode) AS STRING), '') as chqrcode,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(chqeditlk, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqeditlk, 1, 19))
    ) AS chqeditlk,
    NULLIF(CAST(TRIM(chqkeyuser) AS STRING), '') as chqkeyuser,
    COALESCE(
      SAFE.PARSE_DATETIME('%b %d %Y %I:%M%p', SUBSTR(chqkeydate, 1, 19)),
      SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqkeydate, 1, 19))
    ) AS chqkeydate,
