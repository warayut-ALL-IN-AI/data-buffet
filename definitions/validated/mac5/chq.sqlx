all_sources AS (
  SELECT * FROM raw_sources
  ${deduplicate_statement}
)

-------------------------------------------------------------------------
-- โจ เน€เธฃเธตเธขเธเนเธเน UDF เธ—เธตเนเน€เธฃเธฒเธฃเธฑเธ Parameter เน€เธเนเธฒเนเธ เธชเธฑเนเธเธเธฃเธดเนเธ! โจ
-------------------------------------------------------------------------
SELECT 
  * EXCEPT(chqmemo, extracted_data),
  chqmemo AS chqmemo_raw,               -- ๐‘ เธ”เธถเธเธเธญเธฅเธฑเธกเธเนเธ”เธดเธเธเธฅเธฑเธเธกเธฒ เนเธฅเนเธงเธ•เธฑเนเธเธเธทเนเธญเน€เธเนเธ _raw
  extracted_data.chqmemo AS chqmemo,    -- ๐‘ เน€เธญเธฒเธเนเธญเธเธงเธฒเธกเธ—เธตเนเธ•เธฑเธ”เนเธฅเนเธง (clean) เธกเธฒเนเธเนเน€เธเนเธ chqmemo เนเธ—เธ
  extracted_data.extract_text,
  extracted_data.extract_value
FROM (
  SELECT 
    *,
    -- เนเธขเธ 3 Parameters เนเธซเน UDF เธ•เธฒเธกเนเธเธฃเธเธชเธฃเนเธฒเธเธ—เธตเนเน€เธฃเธฒเธ•เธฑเนเธเนเธงเนเน€เธฅเธขเธเธฃเธฑเธ
    `${databuffet.DATABASE}.${databuffet.FUNCTION_DATASET}.EXTRACT_CHQ_DATA`(chqmemo, chqdatec, chqtotal) AS extracted_data
  FROM all_sources
)

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}