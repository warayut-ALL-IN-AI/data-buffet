    CAST(chqdeduct AS FLOAT64) as chqdeduct,
    NULLIF(CAST(TRIM(chqecode) AS STRING), '') as chqecode,
    NULLIF(CAST(TRIM(chqbranch) AS STRING), '') as chqbranch,
    NULLIF(CAST(TRIM(chqmec) AS STRING), '') as chqmec,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(chqdatev, 1, 19)) AS chqdatev
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AK02}.chq`
),

all_sources AS (
  SELECT * FROM raw_sources
  ${deduplicate_statement}
),

-------------------------------------------------------------------------
-- 1. ค้นหาจุดตัดข้อความ (Keyword Priority)
-------------------------------------------------------------------------
find_pos AS (
  SELECT 
    *,
    COALESCE(
      NULLIF(
        REGEXP_INSTR(
          LOWER(chqmemo), 
          r'(?:โอน(?:เงิน|เข้า|บางส่วน|ครั้งที่|เช็คเด้ง|\s*\d+\.?|\s*[/.\-]*\s*[a-z]+(?:\s*\+\s*[a-z]+)?|\s*(?:กสิกร|กรุง|ไทย|ทหาร|ออม|บัญชี|ธนาคาร|ยูโอบี|ทิสโก้|ธกส|ธอส|scb|bbl|ktb)(?:\s*\+\s*(?:กสิกร|กรุง|ไทย|ทหาร|ออม|บัญชี|ธนาคาร|ยูโอบี|ทิสโก้|ธกส|ธอส|scb|bbl|ktb|[a-z]+))?)|รับ(?:เงิน)?โอนแทน|\*\*\s*(?:[a-z]+(?:\s*\+\s*[a-z]+)?|(?:กสิกร|กรุง|ไทย|ทหาร|ออม|บัญชี|ธนาคาร|ยูโอบี|ทิสโก้|ธกส|ธอส|scb|bbl|ktb)(?:\s*\+\s*(?:กสิกร|กรุง|ไทย|ทหาร|ออม|บัญชี|ธนาคาร|ยูโอบี|ทิสโก้|ธกส|ธอส|scb|bbl|ktb|[a-z]+))?)|เปลี่ยนเช็ค)'
        ), 0
      ),
      NULLIF(
        REGEXP_INSTR(
          LOWER(chqmemo), 
          r'เช็ค'
        ), 0
      ),
      0
    ) AS transfer_pos
  FROM all_sources
),

-------------------------------------------------------------------------
-- 2. เตรียมข้อความดิบ และลบเครื่องหมาย + ที่ติดกับวันที่ทิ้ง
-------------------------------------------------------------------------
processed_memo AS (
  SELECT 
    * EXCEPT(chqmemo, transfer_pos),
    chqmemo AS chqmemo_raw,

    CASE WHEN transfer_pos > 1 THEN SUBSTR(chqmemo, 1, transfer_pos - 1)
         WHEN transfer_pos = 1 THEN ''
         ELSE chqmemo 
    END AS chqmemo,

    CASE WHEN transfer_pos > 0 THEN 
           REGEXP_REPLACE(
             SUBSTR(chqmemo, transfer_pos), 
             r'\+\s*(\d{1,2}/\d{1,2}|ม\.?ค\.?|ก\.?พ\.?|มี\.?ค\.?|เม\.?ย\.?|พ\.?ค\.?|มิ\.?ย\.?|ก\.?ค\.?|ส\.?ค\.?|ก\.?ย\.?|ต\.?ค\.?|พ\.?ย\.?|ธ\.?ค\.?)', 
             r' \1'
           )
         ELSE NULL 
    END AS chqmemo_extract

  FROM find_pos
),

-------------------------------------------------------------------------
-- 3. สแกนหา "วันที่ + ยอดเงิน" (หรือ เดือน + ยอดเงิน) เฉพาะหลัง Keyword
-------------------------------------------------------------------------
extracted_pairs AS (
  SELECT 
    *,
    ARRAY_CONCAT(
      COALESCE(
        REGEXP_EXTRACT_ALL(
          SPLIT(chqmemo_extract, 'ชำระครบ')[SAFE_OFFSET(0)], 
          r'\d{1,2}/\d{1,2}(?:/\d{2,4})?\s+(?:\d{1,3}(?:,\d{3})+(?:\.\d*)?|\d+\.\d+|\d{3,})(?:\s*\+\s*(?:\d{1,3}(?:,\d{3})+(?:\.\d*)?|\d+\.\d+|\d{3,}))*(?:[^0-9./]|$|บาท|บ\.)'
        ), []
      ),
      COALESCE(
        REGEXP_EXTRACT_ALL(
          SPLIT(chqmemo_extract, 'ชำระครบ')[SAFE_OFFSET(0)], 
          r'(?:ม\.?ค\.?|ก\.?พ\.?|มี\.?ค\.?|เม\.?ย\.?|พ\.?ค\.?|มิ\.?ย\.?|ก\.?ค\.?|ส\.?ค\.?|ก\.?ย\.?|ต\.?ค\.?|พ\.?ย\.?|ธ\.?ค\.?)\s*(?:\d{2,4}\s+)?(?:\d{1,3}(?:,\d{3})+(?:\.\d*)?|\d+\.\d+|\d{3,})(?:\s*\+\s*(?:\d{1,3}(?:,\d{3})+(?:\.\d*)?|\d+\.\d+|\d{3,}))*(?:[^0-9./]|$|บาท|บ\.)'
        ), []
      ),
      COALESCE(
        REGEXP_EXTRACT_ALL(
          SPLIT(chqmemo_extract, 'ชำระครบ')[SAFE_OFFSET(0)], 
          r'(?:ครั้งที่\s*\d+\s*)(?:\d{1,3}(?:,\d{3})+(?:\.\d*)?|\d+\.\d+|\d{3,})(?:[^0-9./]|$|บาท|บ\.)'
        ), []
      )
    ) AS pair_matches,

    COALESCE(
      REGEXP_EXTRACT(SPLIT(chqmemo_extract, 'ชำระครบ')[SAFE_OFFSET(0)], r'(?:=|จำนวน)\s*([\d,]+(?:\.\d*)?)'),
      REGEXP_EXTRACT(
        REGEXP_REPLACE(
          SPLIT(chqmemo_extract, 'ชำระครบ')[SAFE_OFFSET(0)], 
          r'(?:เลขที่|ที่|no\.?|No\.?|เช็ค|chq\.?|CHQ\.?)\s*#?\s*[a-zA-Z0-9\-]+|เปลี่ยนเช็ค[^\d]{0,30}\b\d{6,8}\b', 
          ''
        ), 
        r'(?:\s|^|\(|\[)(\d{1,3}(?:,\d{3})+(?:\.\d*)?|\d+\.\d+|\d{3,})(?:\s|$|\+|[)\]])'
      )
    ) AS fallback_amount,

    REGEXP_EXTRACT(chqmemo_extract, r'(\d{1,2}/\d{1,2}(?:/\d{2,4})?)') AS fallback_date

  FROM processed_memo
)

-------------------------------------------------------------------------
-- 4. ผลลัพธ์สุดท้าย: จัดเก็บลง RECORD แบบ ARRAY
-------------------------------------------------------------------------
SELECT 
  * EXCEPT(chqmemo_extract, pair_matches, fallback_amount, fallback_date), 
  
  TRIM(
    REGEXP_REPLACE(
      REGEXP_REPLACE(
        REGEXP_REPLACE(
          REGEXP_REPLACE(
            REGEXP_REPLACE(
              REPLACE(REPLACE(REPLACE(chqmemo_extract, '**', ''), '(', ' '), ')', ' '), 
              r'[\n\r]+', 
              ' '
            ),
            r'(?i)\b(?:RV|JV)[\s\S]*', 
            ''
          ),
          r'\s*(?:วันที่|ลว\.|ลว|ล/ว|ยกเลิก|จำนวน|=|บาท|(?:ม\.?ค\.?|ก\.?พ\.?|มี\.?ค\.?|เม\.?ย\.?|พ\.?ค\.?|มิ\.?ย\.?|ก\.?ค\.?|ส\.?ค\.?|ก\.?ย\.?|ต\.?ค\.?|พ\.?ย\.?|ธ\.?ค\.?)(?:\s*\d{2,4})?|ชำระครบ|(?:เลขที่|no\.?|No\.?|NO\.?|chq\.?|CHQ\.?)\s*#?\s*[a-zA-Z0-9\-]+|ยอดคงค้าง|คงค้าง|ค้าง|แทน|และ|\d{1,2}/\d{1,2}(?:/\d{2,4})?(?:\s*(?:จำนวน|ยอด|เป็นเงิน|=)?\s*[\d,]+(?:\.\d*)?(?:\s*\+\s*[\d,]+(?:\.\d*)?)*)?|[\d,]+\.\d*|\d{1,3}(?:,\d{3})+|\b\d{4,15}(?:\.\d*)?\b|,|\*)\s*', 
          ' '
        ),
        r'\s+', 
        ' '
      ),
      r'^[/*\s]+|[/*\s]+$', 
      ''
    )
  ) AS extract_text,

  ARRAY(
    -- **ชุดข้อมูลที่ 1: มาจากการจับคู่ (pair_matches)**
    SELECT AS STRUCT
      COALESCE(
        CASE
          WHEN is_thai_month_only THEN LAST_DAY(DATE(EXTRACT(YEAR FROM chqdatec), d.m, 1))
          ELSE SAFE.PARSE_DATE('%Y-%m-%d', CONCAT(
            CASE
              WHEN d.y IS NULL THEN EXTRACT(YEAR FROM chqdatec)
              WHEN d.y > 2400 THEN d.y - 543
              WHEN d.y >= 40 AND d.y <= 99 THEN d.y + 1957
              WHEN d.y >= 0 AND d.y < 40 THEN d.y + 2000
              ELSE d.y
            END, 
            '-', LPAD(CAST(d.m AS STRING), 2, '0'), 
            '-', LPAD(CAST(d.d AS STRING), 2, '0')
          )) 
        END,
        DATE(chqdatec)
      ) AS extract_date,
      
      (
        SELECT SUM(SAFE_CAST(REPLACE(v, ',', '') AS FLOAT64))
        FROM UNNEST(
          REGEXP_EXTRACT_ALL(
            REGEXP_REPLACE(
              p, 
              r'^(\d{1,2}/\d{1,2}(?:/\d{2,4})?|(?:ม\.?ค\.?|ก\.?พ\.?|มี\.?ค\.?|เม\.?ย\.?|พ\.?ค\.?|มิ\.?ย\.?|ก\.?ค\.?|ส\.?ค\.?|ก\.?ย\.?|ต\.?ค\.?|พ\.?ย\.?|ธ\.?ค\.?)(?:\s*\d{2,4})?|(?:ครั้งที่\s*\d+\s*))\s*(?:จำนวน|ยอด|เป็นเงิน|=)?\s*', 
              ''
            ), 
            r'[\d,]+(?:\.\d*)?'
          )
        ) AS v
      ) AS extract_amount
    FROM (
      SELECT 
        p,
        CASE WHEN REGEXP_CONTAINS(p, r'^(?:ม\.?ค\.?|ก\.?พ\.?|มี\.?ค\.?|เม\.?ย\.?|พ\.?ค\.?|มิ\.?ย\.?|ก\.?ค\.?|ส\.?ค\.?|ก\.?ย\.?|ต\.?ค\.?|พ\.?ย\.?|ธ\.?ค\.?)') THEN TRUE ELSE FALSE END AS is_thai_month_only,
        
        CAST(SPLIT(COALESCE(REGEXP_EXTRACT(p, r'^(\d{1,2}/\d{1,2}(?:/\d{2,4})?)'), fallback_date), '/')[SAFE_OFFSET(0)] AS INT64) AS d,
        
        CASE
          WHEN REGEXP_CONTAINS(p, r'^ม\.?ค\.?') THEN 1
          WHEN REGEXP_CONTAINS(p, r'^ก\.?พ\.?') THEN 2
          WHEN REGEXP_CONTAINS(p, r'^มี\.?ค\.?') THEN 3
          WHEN REGEXP_CONTAINS(p, r'^เม\.?ย\.?') THEN 4
          WHEN REGEXP_CONTAINS(p, r'^พ\.?ค\.?') THEN 5
          WHEN REGEXP_CONTAINS(p, r'^มิ\.?ย\.?') THEN 6
          WHEN REGEXP_CONTAINS(p, r'^ก\.?ค\.?') THEN 7
          WHEN REGEXP_CONTAINS(p, r'^ส\.?ค\.?') THEN 8
          WHEN REGEXP_CONTAINS(p, r'^ก\.?ย\.?') THEN 9
          WHEN REGEXP_CONTAINS(p, r'^ต\.?ค\.?') THEN 10
          WHEN REGEXP_CONTAINS(p, r'^พ\.?ย\.?') THEN 11
          WHEN REGEXP_CONTAINS(p, r'^ธ\.?ค\.?') THEN 12
          ELSE CAST(SPLIT(COALESCE(REGEXP_EXTRACT(p, r'^(\d{1,2}/\d{1,2}(?:/\d{2,4})?)'), fallback_date), '/')[SAFE_OFFSET(1)] AS INT64)
        END AS m,
        
        CAST(SPLIT(COALESCE(REGEXP_EXTRACT(p, r'^(\d{1,2}/\d{1,2}(?:/\d{2,4})?)'), fallback_date), '/')[SAFE_OFFSET(2)] AS INT64) AS y
      FROM UNNEST(pair_matches) p
    ) AS d
    
    UNION ALL
    
    -- **ชุดข้อมูลที่ 2: มาจากก้อนสำรอง (Fallback)**
    SELECT AS STRUCT
      COALESCE(
        SAFE.PARSE_DATE('%Y-%m-%d', CONCAT(
          CASE
            WHEN ext_y IS NULL THEN EXTRACT(YEAR FROM chqdatec)
            WHEN ext_y > 2400 THEN ext_y - 543
            WHEN ext_y >= 40 AND ext_y <= 99 THEN ext_y + 1957
            WHEN ext_y >= 0 AND ext_y < 40 THEN ext_y + 2000
            ELSE ext_y
          END, 
          '-', LPAD(CAST(ext_m AS STRING), 2, '0'), 
          '-', LPAD(CAST(ext_d AS STRING), 2, '0')
        )),
        CASE WHEN fallback_amount IS NOT NULL THEN DATE(chqdatec) ELSE NULL END
      ) AS extract_date,
      
      COALESCE(
        SAFE_CAST(REPLACE(fallback_amount, ',', '') AS FLOAT64),
        CASE WHEN fallback_date IS NOT NULL THEN chqtotal ELSE NULL END
      ) AS extract_amount
    FROM (
      SELECT 
        CAST(SPLIT(fallback_date, '/')[SAFE_OFFSET(0)] AS INT64) AS ext_d,
        CAST(SPLIT(fallback_date, '/')[SAFE_OFFSET(1)] AS INT64) AS ext_m,
        CAST(SPLIT(fallback_date, '/')[SAFE_OFFSET(2)] AS INT64) AS ext_y
    )
    WHERE ARRAY_LENGTH(pair_matches) = 0 AND (fallback_amount IS NOT NULL OR fallback_date IS NOT NULL OR (chqmemo_extract IS NOT NULL AND chqmemo_extract != ''))
  ) AS extract_value

FROM extracted_pairs

post_operations {
    ${ when(!incremental(), post_operations_statement) }
    
    INSERT INTO `monitoring_dataset.dataform_all_logs` (
        process_name, data_layer, action_name, status, start_time, end_time, error_message, executed_by
    )
    SELECT 
        'Dataform Pipeline', 'VALIDATED', '${name()}', 'SUCCESS', (SELECT start_ts FROM temp_start_${name()}), CURRENT_TIMESTAMP(), NULL, SESSION_USER();
}