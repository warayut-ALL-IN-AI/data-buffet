    ${databuffet.functionData.cleanString('perdep')} as perdep,
    ${databuffet.functionData.cleanString('pertaxnos')} as pertaxnos,
    ${databuffet.functionData.cleanString('pernamet')} as pernamet,
    ${databuffet.functionData.cleanString('pernamee')} as pernamee,
    ${databuffet.functionData.parseFlexibleDatetime('perbdate')} AS perbdate,
    ${databuffet.functionData.parseFlexibleDatetime('perworks')} AS perworks,
    ${databuffet.functionData.parseFlexibleDatetime('perworkf')} AS perworkf,
    ${databuffet.functionData.cleanString('peradd1')} as peradd1,
    ${databuffet.functionData.cleanString('peradd2')} as peradd2,
    ${databuffet.functionData.cleanString('peradd3')} as peradd3,
    ${databuffet.functionData.cleanString('pertel')} as pertel,
    ${databuffet.functionData.cleanString('perpositn')} as perpositn,
    ${databuffet.functionData.castInt64('perstatus')} as perstatus,
    ${databuffet.functionData.castInt64('pernchild')} as pernchild,
    ${databuffet.functionData.castInt64('percisstudy')} as percisstudy,
    ${databuffet.functionData.castInt64('pernotstudy')} as pernotstudy,
    ${databuffet.functionData.castFloat64('persalary')} as persalary,
    ${databuffet.functionData.castInt64('perhide')} as perhide,
    ${databuffet.functionData.castInt64('perlock')} as perlock,
    ${databuffet.functionData.cleanString('permemo')} as permemo,
    ${databuffet.functionData.parseFlexibleDatetime('pereditlk')} AS pereditlk,
    ${databuffet.functionData.cleanString('perrefwe')} as perrefwe,
    ${databuffet.functionData.parseFlexibleDatetime('pereditdt')} AS pereditdt,
    ${databuffet.functionData.cleanString('pereditmf')} as pereditmf,
    CAST(NULL AS STRING) as perzone
  FROM `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AB01}.per`

  UNION ALL

  SELECT
    'ac02' AS company_id,
    ${databuffet.functionData.cleanString('percode')} as percode,
    ${databuffet.functionData.cleanString('perdep')} as perdep,
    ${databuffet.functionData.cleanString('pertaxnos')} as pertaxnos,
    ${databuffet.functionData.cleanString('pernamet')} as pernamet,
    ${databuffet.functionData.cleanString('pernamee')} as pernamee,
    ${databuffet.functionData.parseFlexibleDatetime('perbdate')} AS perbdate,
    ${databuffet.functionData.parseFlexibleDatetime('perworks')} AS perworks,
