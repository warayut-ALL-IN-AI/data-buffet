config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5", "create_all_table_raw_mac5_aa05", "create_all_table_raw_mac5_ab01", "create_all_table_raw_mac5_ac02", "create_all_table_raw_mac5_ak02"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["company_id", "MIHtype", "MIHvnos"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "MIHtype", "MIHvnos"]
    },
}

js {
    const pk_key = ["company_id", "MIHtype", "MIHvnos"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT
    'ag01' AS company_id,
    ${databuffet.castInt64('MIHday')} AS mihday,
    ${databuffet.castInt64('MIHmonth')} AS mihmonth,
    ${databuffet.castInt64('MIHyear')} AS mihyear,
    ${databuffet.cleanString('MIHtype')} AS mihtype,
    ${databuffet.cleanString('MIHvnos')} AS mihvnos,
    ${databuffet.cleanString('MIHcus')} AS mihcus,
    ${databuffet.cleanString('MIHjob')} AS mihjob,
    ${databuffet.cleanString('MIHdep')} AS mihdep,
    ${databuffet.cleanString('MIHper')} AS mihper,
    ${databuffet.cleanString('MIHdoc')} AS mihdoc,
    ${databuffet.cleanString('MIHmec')} AS mihmec,
    ${databuffet.cleanString('MIHvatNO')} AS mihvatno,
    ${databuffet.cleanString('MIHdesc')} AS mihdesc,
    ${databuffet.cleanString('MIHmemo')} AS mihmemo,
    ${databuffet.cleanString('MIHnotes')} AS mihnotes,
    ${databuffet.cleanString('MIHref1')} AS mihref1,
    ${databuffet.cleanString('MIHref2')} AS mihref2,
    ${databuffet.cleanString('MIHref3')} AS mihref3,
    ${databuffet.cleanString('MIHdiscHT1')} AS mihdischt1,
    ${databuffet.cleanString('MIHdiscHT2')} AS mihdischt2,
    ${databuffet.cleanString('MIHdelvSite')} AS mihdelvsite,
    ${databuffet.parseFlexibleDatetime('MIHdelvDate')} AS mihdelvdate,
    ${databuffet.castInt64('MIHstanding')} AS mihstanding,
    ${databuffet.castInt64('MIHlinkGL')} AS mihlinkgl,
    ${databuffet.castInt64('MIHnoUPLINK')} AS mihnouplink,
    ${databuffet.castInt64('MIHnolist')} AS mihnolist,
    ${databuffet.castInt64('MIHcurC')} AS mihcurc,
    ${databuffet.castInt64('MIHvatInList')} AS mihvatinlist,
    ${databuffet.castInt64('MIHlock')} AS mihlock,
    ${databuffet.castInt64('MIHprintN')} AS mihprintn,
    ${databuffet.castInt64('MIHcheque')} AS mihcheque,
    ${databuffet.castInt64('MIHcancel')} AS mihcancel,
    ${databuffet.castInt64('MIHstatus')} AS mihstatus,
    ${databuffet.castInt64('MIHclearUM')} AS mihclearum,
    ${databuffet.castInt64('MIHctermNO')} AS mihctermno,
    (CASE WHEN ${databuffet.cleanString('MIHtype')} = 'BS' THEN ${databuffet.castFloat64('MIHcog')} * -1 ELSE ${databuffet.castFloat64('MIHcog')} END) AS mihcog,
    ${databuffet.castFloat64('MIHcog')} AS mihcog_raw,
    (CASE WHEN ${databuffet.cleanString('MIHtype')} = 'BS' THEN ${databuffet.castFloat64('MIHvatSUM')} * -1 ELSE ${databuffet.castFloat64('MIHvatSUM')} END) AS mihvatsum,
    ${databuffet.castFloat64('MIHvatSUM')} AS mihvatsum_raw,
    (CASE WHEN ${databuffet.cleanString('MIHtype')} = 'BS' THEN ${databuffet.castFloat64('MIHnetSUM')} * -1 ELSE ${databuffet.castFloat64('MIHnetSUM')} END) AS mihnetsum,
    ${databuffet.castFloat64('MIHnetSUM')} AS mihnetsum_raw,
    (CASE WHEN ${databuffet.cleanString('MIHtype')} = 'BS' THEN ${databuffet.castFloat64('MIHdiscLST')} * -1 ELSE ${databuffet.castFloat64('MIHdiscLST')} END) AS mihdisclst,
    ${databuffet.castFloat64('MIHdiscLST')} AS mihdisclst_raw,
    (CASE WHEN ${databuffet.cleanString('MIHtype')} = 'BS' THEN ${databuffet.castFloat64('MIHdiscHF1')} * -1 ELSE ${databuffet.castFloat64('MIHdiscHF1')} END) AS mihdischf1,
    ${databuffet.castFloat64('MIHdiscHF1')} AS mihdischf1_raw,
    (CASE WHEN ${databuffet.cleanString('MIHtype')} = 'BS' THEN ${databuffet.castFloat64('MIHdiscHF2')} * -1 ELSE ${databuffet.castFloat64('MIHdiscHF2')} END) AS mihdischf2,
    ${databuffet.castFloat64('MIHdiscHF2')} AS mihdischf2_raw,
    ${databuffet.castFloat64('MIHexchg')} AS mihexchg,
    ${databuffet.castFloat64('MIHextraSUM')} AS mihextrasum,
    ${databuffet.castFloat64('MIHextraVAT')} AS mihextravat,
    ${databuffet.castInt64('MIHextraCUT')} AS mihextracut,
    ${databuffet.cleanString('MIHextraMEM')} AS mihextramem,
    ${databuffet.cleanString('MIHrecNO')} AS mihrecno,
    ${databuffet.parseFlexibleDatetime('MIHrecDATE')} AS mihrecdate,
    ${databuffet.cleanString('MIHsaveTAG')} AS mihsavetag,
