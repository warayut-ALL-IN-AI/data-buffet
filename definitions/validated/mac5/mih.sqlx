    ${databuffet.parseFlexibleDatetime('MIHdateS1')} AS mihdates1,
    ${databuffet.parseFlexibleDatetime('MIHdateS2')} AS mihdates2,
    ${databuffet.castInt64('MIHnumSI')} AS mihnumsi,
    ${databuffet.castFloat64('MIHnumSC')} AS mihnumsc,
    ${databuffet.castFloat64('MIHvatPC')} AS mihvatpc,
    ${databuffet.castInt64('MIHincluded')} AS mihincluded,
    ${databuffet.cleanString('MIHtaxvnos')} AS mihtaxvnos,
