config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "frun", "fdocument", "fserial_no"],
    bigquery: {
        clusterBy: ["company_id", "frun", "fdocument", "fserial_no"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["company_id", "frun", "fdocument", "fserial_no"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY fdatetime desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }

}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.cleanString('frun')} as frun,
    ${databuffet.cleanString('fmaster')} as fmaster,
    ${databuffet.cleanString('fdocument')} as fdocument,
    ${databuffet.cleanString('fserial_no')} as fserial_no,
    ${databuffet.cleanString('fitem')} as fitem,
    ${databuffet.cleanString('fusername')} as fusername,
    ${databuffet.cleanString('fdatetime')} as fdatetime,
    ${databuffet.cleanString('fitem2')} as fitem2,
    ${databuffet.cleanString('fdoc_type')} as fdoc_type,
    ${databuffet.cleanString('fcancel')} as fcancel,
    ${databuffet.cleanString('fref1')} as fref1,
    ${databuffet.castInt64('fdocument_rt')} as fdocument_rt,
    ${databuffet.parseFlexibleDatetime('fdocument_rtdate')} as fdocument_rtdate,
    ${databuffet.castInt64('fdocument_ac')} as fdocument_ac,
    ${databuffet.parseFlexibleDatetime('fdocument_acdate')} as fdocument_acdate,
    ${databuffet.cleanString('frepro')} as frepro,
    ${databuffet.castInt64('fqty_order')} as fqty_order,
    ${databuffet.cleanString('fitemdoc')} as fitemdoc,
    ${databuffet.cleanString('fitem3')} as fitem3,
    ${databuffet.castFloat64('fprice')} as fprice,
    ${databuffet.castInt64('fin365')} as fin365,
    ${databuffet.cleanString('im_mac')} as im_mac,
    ${databuffet.cleanString('post')} as post
  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources

${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
