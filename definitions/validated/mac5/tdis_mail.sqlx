config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: [],
    bigquery: {
        clusterBy: ["company_id", "saleid"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = []

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY salename desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.cleanString('saleid')} as saleid,
    ${databuffet.cleanString('spass')} as spass,
    ${databuffet.cleanString('salename')} as salename,
    ${databuffet.cleanString('salemail')} as salemail,
    ${databuffet.cleanString('mail1')} as mail1,
    ${databuffet.cleanString('mail2')} as mail2,
    ${databuffet.cleanString('mail3')} as mail3,
    ${databuffet.cleanString('mail4')} as mail4,
    ${databuffet.cleanString('lv')} as lv,
    ${databuffet.cleanString('cc1')} as cc1,
    ${databuffet.cleanString('cc2')} as cc2,
    ${databuffet.cleanString('cc3')} as cc3,
    ${databuffet.cleanString('cc4')} as cc4,
    ${databuffet.cleanString('cc5')} as cc5,
    ${databuffet.cleanString('cc6')} as cc6,
    ${databuffet.cleanString('cc7')} as cc7,
    ${databuffet.cleanString('cc8')} as cc8,
    ${databuffet.cleanString('cc9')} as cc9,
    ${databuffet.cleanString('passlv1')} as passlv1,
    ${databuffet.cleanString('passlv2')} as passlv2,
    ${databuffet.cleanString('passlv3')} as passlv3,
    ${databuffet.cleanString('passlv4')} as passlv4,
    ${databuffet.cleanString('f1')} as f1,
    ${databuffet.cleanString('f2')} as f2,
    ${databuffet.cleanString('f3')} as f3,
    ${databuffet.cleanString('f4')} as f4,
    ${databuffet.cleanString('f5')} as f5,
    ${databuffet.cleanString('f6')} as f6,
    ${databuffet.cleanString('f7')} as f7,
    ${databuffet.cleanString('f8')} as f8,
    ${databuffet.cleanString('f9')} as f9,
    ${databuffet.cleanString('f10')} as f10,
    ${databuffet.cleanString('pum1')} as pum1,
    ${databuffet.cleanString('pum2')} as pum2,
    ${databuffet.cleanString('pum3')} as pum3,
    ${databuffet.cleanString('ppass1')} as ppass1,
    ${databuffet.cleanString('ppass2')} as ppass2,
    ${databuffet.cleanString('ppass3')} as ppass3,
    ${databuffet.cleanString('ma')} as ma,
    ${databuffet.cleanString('ta')} as ta,
    ${databuffet.cleanString('ceo')} as ceo,
    ${databuffet.cleanString('app')} as app,
    ${databuffet.cleanString('lv_pum')} as lv_pum,
    ${databuffet.cleanString('lv_rp')} as lv_rp,
    ${databuffet.cleanString('rp1')} as rp1,
    ${databuffet.cleanString('rp2')} as rp2,
    ${databuffet.cleanString('rp3')} as rp3,
    ${databuffet.cleanString('rpass1')} as rpass1,
    ${databuffet.cleanString('rpass2')} as rpass2,
    ${databuffet.cleanString('rpass3')} as rpass3,
    ${databuffet.cleanString('lv_ele')} as lv_ele,
    ${databuffet.cleanString('ele1')} as ele1,
    ${databuffet.cleanString('ele2')} as ele2,
    ${databuffet.cleanString('ele3')} as ele3,
    ${databuffet.cleanString('epass1')} as epass1,
    ${databuffet.cleanString('epass2')} as epass2,
    ${databuffet.cleanString('epass3')} as epass3,
    ${databuffet.cleanString('type')} as type,
    ${databuffet.cleanString('menu1')} as menu1,
    ${databuffet.cleanString('download')} as download,
    ${databuffet.cleanString('pic')} as pic,
    ${databuffet.cleanString('lv_boq_lyn')} as lv_boq_lyn,
    ${databuffet.castInt64('active')} as active

  FROM
    `${sourceTableRef}`
)
SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
