config {
    type: "table",
    schema: databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MAC5,
    dependencies: ["validated_schema_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: [],
    bigquery: {
        clusterBy: ["saleid"]
    },
}

js {
    const project_id = databuffet.DATABASE
    const dataset_id = databuffet.RAW_SCHEMA + "_" + databuffet.SOURCE_MAC5
    const table_id = name()
    const pk_key = []

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY salename desc) = 1`;
        post_operations_statement = `EXECUTE IMMEDIATE '''
    ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
    ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
    ''';`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    NULLIF(CAST(TRIM(saleid) AS STRING), '') as saleid,
    NULLIF(CAST(TRIM(spass) AS STRING), '') as spass,
    NULLIF(CAST(TRIM(salename) AS STRING), '') as salename,
    NULLIF(CAST(TRIM(salemail) AS STRING), '') as salemail,
    NULLIF(CAST(TRIM(mail1) AS STRING), '') as mail1,
    NULLIF(CAST(TRIM(mail2) AS STRING), '') as mail2,
    NULLIF(CAST(TRIM(mail3) AS STRING), '') as mail3,
    NULLIF(CAST(TRIM(mail4) AS STRING), '') as mail4,
    NULLIF(CAST(TRIM(lv) AS STRING), '') as lv,
    NULLIF(CAST(TRIM(cc1) AS STRING), '') as cc1,
    NULLIF(CAST(TRIM(cc2) AS STRING), '') as cc2,
    NULLIF(CAST(TRIM(cc3) AS STRING), '') as cc3,
    NULLIF(CAST(TRIM(cc4) AS STRING), '') as cc4,
    NULLIF(CAST(TRIM(cc5) AS STRING), '') as cc5,
    NULLIF(CAST(TRIM(cc6) AS STRING), '') as cc6,
    NULLIF(CAST(TRIM(cc7) AS STRING), '') as cc7,
    NULLIF(CAST(TRIM(cc8) AS STRING), '') as cc8,
    NULLIF(CAST(TRIM(cc9) AS STRING), '') as cc9,
    NULLIF(CAST(TRIM(passlv1) AS STRING), '') as passlv1,
    NULLIF(CAST(TRIM(passlv2) AS STRING), '') as passlv2,
    NULLIF(CAST(TRIM(passlv3) AS STRING), '') as passlv3,
    NULLIF(CAST(TRIM(passlv4) AS STRING), '') as passlv4,
    NULLIF(CAST(TRIM(f1) AS STRING), '') as f1,
    NULLIF(CAST(TRIM(f2) AS STRING), '') as f2,
    NULLIF(CAST(TRIM(f3) AS STRING), '') as f3,
    NULLIF(CAST(TRIM(f4) AS STRING), '') as f4,
    NULLIF(CAST(TRIM(f5) AS STRING), '') as f5,
    NULLIF(CAST(TRIM(f6) AS STRING), '') as f6,
    NULLIF(CAST(TRIM(f7) AS STRING), '') as f7,
    NULLIF(CAST(TRIM(f8) AS STRING), '') as f8,
    NULLIF(CAST(TRIM(f9) AS STRING), '') as f9,
    NULLIF(CAST(TRIM(f10) AS STRING), '') as f10,
    NULLIF(CAST(TRIM(pum1) AS STRING), '') as pum1,
    NULLIF(CAST(TRIM(pum2) AS STRING), '') as pum2,
    NULLIF(CAST(TRIM(pum3) AS STRING), '') as pum3,
    NULLIF(CAST(TRIM(ppass1) AS STRING), '') as ppass1,
    NULLIF(CAST(TRIM(ppass2) AS STRING), '') as ppass2,
    NULLIF(CAST(TRIM(ppass3) AS STRING), '') as ppass3,
    NULLIF(CAST(TRIM(ma) AS STRING), '') as ma,
    NULLIF(CAST(TRIM(ta) AS STRING), '') as ta,
    NULLIF(CAST(TRIM(ceo) AS STRING), '') as ceo,
    NULLIF(CAST(TRIM(app) AS STRING), '') as app,
    NULLIF(CAST(TRIM(lv_pum) AS STRING), '') as lv_pum,
    NULLIF(CAST(TRIM(lv_rp) AS STRING), '') as lv_rp,
    NULLIF(CAST(TRIM(rp1) AS STRING), '') as rp1,
    NULLIF(CAST(TRIM(rp2) AS STRING), '') as rp2,
    NULLIF(CAST(TRIM(rp3) AS STRING), '') as rp3,
    NULLIF(CAST(TRIM(rpass1) AS STRING), '') as rpass1,
    NULLIF(CAST(TRIM(rpass2) AS STRING), '') as rpass2,
    NULLIF(CAST(TRIM(rpass3) AS STRING), '') as rpass3,
    NULLIF(CAST(TRIM(lv_ele) AS STRING), '') as lv_ele,
    NULLIF(CAST(TRIM(ele1) AS STRING), '') as ele1,
    NULLIF(CAST(TRIM(ele2) AS STRING), '') as ele2,
    NULLIF(CAST(TRIM(ele3) AS STRING), '') as ele3,
    NULLIF(CAST(TRIM(epass1) AS STRING), '') as epass1,
    NULLIF(CAST(TRIM(epass2) AS STRING), '') as epass2,
    NULLIF(CAST(TRIM(epass3) AS STRING), '') as epass3,
    NULLIF(CAST(TRIM(type) AS STRING), '') as type,
    NULLIF(CAST(TRIM(menu1) AS STRING), '') as menu1,
    NULLIF(CAST(TRIM(download) AS STRING), '') as download,
    NULLIF(CAST(TRIM(pic) AS STRING), '') as pic,
    NULLIF(CAST(TRIM(lv_boq_lyn) AS STRING), '') as lv_boq_lyn,
    CAST(active AS INT64) as active

FROM
  `${project_id}.${dataset_id}.${table_id}`
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
