config {
    type: "incremental",
    schema: databuffet.VALIDATED_CIS360,
    dependencies: ["validated_schema_cis360", "create_all_table_raw_cis360"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["id"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_CIS360,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    ${databuffet.functionData.cleanString('id')} as id,
    ${databuffet.functionData.cleanString('buyer_id')} as buyer_id,
    ${databuffet.functionData.cleanString('seller_id')} as seller_id,
    CAST(transaction_type_id as INT64) as transaction_type_id,
    CAST(platform_id as INT64) as platform_id,
    CAST(platform_reference_id as INT64) as platform_reference_id,
    ${databuffet.functionData.cleanString('buyer_name')} as buyer_name,
    ${databuffet.functionData.cleanString('seller_name')} as seller_name,
    ${databuffet.functionData.cleanString('transaction_code')} as transaction_code,
    ${databuffet.functionData.castInt64('total_items')} as total_items,
    ${databuffet.functionData.castFloat64('total_amount')} as total_amount,
    ${databuffet.functionData.cleanString('url_reference')} as url_reference,
    CAST(is_delete as BOOL) as is_delete,
    ${databuffet.functionData.parseFlexibleDatetime('transaction_date')} as transaction_date,
    ${databuffet.functionData.parseFlexibleDatetime('create_date')} as create_date,
    ${databuffet.functionData.cleanString('create_by')} as create_by,
    ${databuffet.functionData.cleanString('create_by_platform')} as create_by_platform,
    ${databuffet.functionData.cleanString('update_by_platform')} as update_by_platform,
    ${databuffet.functionData.parseFlexibleDatetime('update_date')} as update_date,
    ${databuffet.functionData.cleanString('update_by')} AS update_by,
    ${databuffet.functionData.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
