config {
    type: "incremental",
    schema: databuffet.VALIDATED_CIS360,
    dependencies: ["validated_schema_cis360", "create_all_table_raw_cis360"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["id"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_CIS360,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    ${databuffet.cleanString('id')} as id,
    ${databuffet.cleanString('allkons_id')} as allkons_id,
    ${databuffet.cleanString('tax_id')} as tax_id,
    ${databuffet.cleanString('customer_id')} as customer_id,    
    ${databuffet.castInt64('customer_type_id')} as customer_type_id,
    ${databuffet.castInt64('customer_profile_type_id')} as customer_profile_type_id,
    ${databuffet.castInt64('customer_status_id')} as customer_status_id,
    ${databuffet.cleanString('image_profile_id')} as image_profile_id,
    ${databuffet.cleanString('customer_code')} as customer_code,
    ${databuffet.castInt64('prefix_id')} as prefix_id,
    ${databuffet.cleanString('first_name')} as first_name,
    ${databuffet.cleanString('middle_name')} as middle_name,
    ${databuffet.cleanString('last_name')} as last_name,
    ${databuffet.cleanString('full_name')} as full_name,
    ${databuffet.cleanString('kyc_status')} as kyc_status,
    CAST(active_status as BOOL) as active_status,
    CAST(is_dopa as BOOL) as is_dopa,
    CAST(is_dbd as BOOL) as is_dbd,
    CAST(is_allow_concern as BOOL) as is_allow_concern,
    CAST(is_delete as BOOL) as is_delete,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(create_date, 1, 19)) as create_date,
    ${databuffet.cleanString('create_by')} as create_by,
    ${databuffet.cleanString('create_by_platform')} as create_by_platform,
    ${databuffet.cleanString('update_by_platform')} as update_by_platform,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(update_date, 1, 19)) as update_date,
    ${databuffet.cleanString('update_by')} AS update_by,
    ${databuffet.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
