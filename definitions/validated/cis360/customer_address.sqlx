config {
    type: "incremental",
    schema: databuffet.VALIDATED_CIS360,
    dependencies: ["validated_schema_cis360", "create_all_table_raw_cis360"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["id"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_CIS360,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    ${databuffet.cleanString('id')} as id,
    ${databuffet.cleanString('customer_profile_id')} as customer_profile_id,
    CAST(address_type_id as INT64) as address_type_id,
    CAST(platform_id as INT64) as platform_id,
    ${databuffet.cleanString('contact_name')} as contact_name,
    CAST(contact_phone_number AS BOOL) as contact_phone_number,
    CAST(contact_email AS BOOL) as contact_email,
    ${databuffet.cleanString('address_detail')} as address_detail,
    ${databuffet.cleanString('address_name')} as address_name,
    CAST(branch as INT64) as branch,
    CAST(tax_invoice_juristic_type as INT64) as tax_invoice_juristic_type,
    ${databuffet.cleanString('tax_invoice_juristic_name')} as tax_invoice_juristic_name,
    ${databuffet.cleanString('tax_invoice_type')} as tax_invoice_type,
    CAST(tax_invoice_customer_type as INT64) as tax_invoice_customer_type,
    ${databuffet.cleanString('tax_invoice_tax_id')} as tax_invoice_tax_id,
    ${databuffet.cleanString('parent')} as parent,
    ${databuffet.cleanString('address_info')} as address_info,
    ${databuffet.cleanString('street')} as street,
    CAST(country_id as INT64) as country_id,
    CAST(province_id as INT64) as province_id,
    CAST(district_id as INT64) as district_id,
    CAST(sub_district_id as INT64) as sub_district_id,
    CAST(zipcode_id as INT64) as zipcode_id,
    ${databuffet.cleanString('country_name')} as country_name,
    ${databuffet.cleanString('province_name')} as province_name,
    ${databuffet.cleanString('district_name')} as district_name,
    ${databuffet.cleanString('sub_district_name')} as sub_district_name,
    ${databuffet.cleanString('zipcode_name')} as zipcode_name,
    ${databuffet.cleanString('latitude')} as latitude,
    ${databuffet.cleanString('longitude')} as longitude,
    CAST(active_status as BOOL) as active_status,
    CAST(is_default as BOOL) as is_default,
    CAST(is_kyc_document as BOOL) as is_kyc_document,
    CAST(is_delete as BOOL) as is_delete,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(create_date, 1, 19)) as create_date,
    ${databuffet.cleanString('create_by')} as create_by,
    ${databuffet.cleanString('create_by_platform')} as create_by_platform,
    ${databuffet.cleanString('update_by_platform')} as update_by_platform,
    PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(update_date, 1, 19)) as update_date,
    ${databuffet.cleanString('update_by')} AS update_by,
    ${databuffet.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
