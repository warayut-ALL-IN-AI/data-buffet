config {
    type: "incremental",
    schema: databuffet.VALIDATED_SALEOUT_MDT,
    dependencies: ["validated_schema_saleout", "create_all_table_raw_saleout_mdt"],
    tags: [databuffet.TAG_VALIDATED],
    uniqueKey: ["vendor_id", "branch", "mch3"],
    bigquery: {
        clusterBy: ["vendor_id", "branch", "mch3"]
    },
}

js {
    const pk_key = ["vendor_id", "branch", "mch3"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY ASATDATE DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    ${databuffet.cleanString('VENDOR_ID')} AS vendor_id,
    ${databuffet.cleanString('VENDOR_NAME')} AS vendor_name,
    ${databuffet.cleanString('BRANCH')} AS branch,
    ${databuffet.cleanString('MCH3')} AS mch3,
    ${databuffet.castFloat64('UR_COST_AMT')} AS ur_cost_amt,
    ${databuffet.castFloat64('T_O')} AS t_o,
    ${databuffet.castFloat64('UR_COST_AMT_DEAD')} AS ur_cost_amt_dead,
    ${databuffet.cleanString('__Dead')} AS dead,
    ${databuffet.castFloat64('T_O_VENDOR')} AS t_o_vendor,
    PARSE_DATE('%Y/%m/%d', TRIM(START_DATE)) AS start_date,
    PARSE_DATE('%Y/%m/%d', TRIM(END_DATE)) AS end_date,
    ${databuffet.parseAsatDate()} as ASATDATE,
FROM `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.turnover`
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
