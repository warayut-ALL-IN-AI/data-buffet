config {
    type: "incremental",
    schema: databuffet.VALIDATED_MASTERSKU,
    dependencies: ["validated_schema_mastersku", "create_all_table_raw_mastersku"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["cat_id"],
    bigquery: {
        partitionBy : "asatdate",
        clusterBy: ["cat_id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MASTERSKU,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["cat_id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  ${databuffet.functionData.cleanString('cat_id')} AS cat_id,
  ${databuffet.functionData.cleanString('cat_code')} AS cat_code,
  ${databuffet.functionData.cleanString('cat_name')} AS cat_name,
  ${databuffet.functionData.cleanString('cat_d365_code')} AS cat_d365_code,
  ${databuffet.functionData.cleanString('cat_description')} AS cat_description,
  ${databuffet.functionData.cleanString('cat_tag')} AS cat_tag,
  ${databuffet.functionData.cleanString('cat_parent_id')} AS cat_parent_id,
  ${databuffet.functionData.castInt64('cat_level')} AS cat_level,
  ${databuffet.functionData.cleanString('cat_img_name')} AS cat_img_name,
  ${databuffet.functionData.cleanString('cat_img_path')} AS cat_img_path,
  ${databuffet.functionData.cleanString('cat_vendor_id')} AS cat_vendor_id,
  CAST(cat_is_active AS BOOL) AS cat_is_active,
  CAST(cat_is_use AS BOOL) AS cat_is_use,
  ${databuffet.functionData.parseFlexibleDatetime('cat_created_date')} AS cat_created_date,
  ${databuffet.functionData.cleanString('cat_created_by')} AS cat_created_by,
  ${databuffet.functionData.parseFlexibleDatetime('cat_updated_date')} AS cat_updated_date,
  ${databuffet.functionData.cleanString('cat_updated_by')} AS cat_updated_by,
  ${databuffet.functionData.cleanString('cat_specific_field')} AS cat_specific_field,
  ${databuffet.functionData.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
