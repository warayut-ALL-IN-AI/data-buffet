config {
    type: "incremental",
    schema: databuffet.VALIDATED_MASTERSKU,
    dependencies: ["validated_schema_mastersku", "create_all_table_raw_mastersku"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["pg_id"],
    bigquery: {
        partitionBy : "asatdate",
        clusterBy: ["pg_id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MASTERSKU,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["pg_id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  ${databuffet.functionData.cleanString('pg_id')} AS pg_id,
  ${databuffet.functionData.cleanString('pg_description')} AS pg_description,
  ${databuffet.functionData.cleanString('pg_dimension1')} AS pg_dimension1,
  ${databuffet.functionData.cleanString('pg_dimension2')} AS pg_dimension2,
  ${databuffet.functionData.cleanString('pg_dimension3')} AS pg_dimension3,
  ${databuffet.functionData.cleanString('pg_dimension4')} AS pg_dimension4,
  ${databuffet.functionData.cleanString('pg_dimension_d365_1')} AS pg_dimension_d365_1,
  ${databuffet.functionData.cleanString('pg_dimension_d365_2')} AS pg_dimension_d365_2,
  ${databuffet.functionData.cleanString('pg_dimension_d365_3')} AS pg_dimension_d365_3,
  ${databuffet.functionData.cleanString('pg_dimension_d365_4')} AS pg_dimension_d365_4,
  ${databuffet.functionData.cleanString('pg_vendor_id')} AS pg_vendor_id,
  CAST(pg_is_system AS BOOL) AS pg_is_system,
  CAST(pg_is_active AS BOOL) AS pg_is_active,
  CAST(pg_is_use AS BOOL) AS pg_is_use,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(pg_created_date, 1, 19)) AS pg_created_date,
  ${databuffet.functionData.cleanString('pg_created_by')} AS pg_created_by,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(pg_updated_date, 1, 19)) AS pg_updated_date,
  ${databuffet.functionData.cleanString('pg_updated_by')} AS pg_updated_by,
  ${databuffet.functionData.cleanString('pg_brand_id')} AS pg_brand_id,
  ${databuffet.functionData.cleanString('pg_code')} AS pg_code,
  ${databuffet.functionData.cleanString('pg_name')} AS pg_name,
  ${databuffet.functionData.cleanString('pg_sku')} AS pg_sku,
  ${databuffet.functionData.cleanString('pg_barcode')} AS pg_barcode,
  ${databuffet.functionData.cleanString('pg_er_source')} AS pg_er_source,
  ${databuffet.functionData.cleanString('pg_tag')} AS pg_tag,
  ${databuffet.functionData.cleanString('pg_file_name')} AS pg_file_name,
  ${databuffet.functionData.cleanString('pg_cg_id')} AS pg_cg_id,
  ${databuffet.functionData.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
