config {
    type: "incremental",
    schema: databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MASTERSKU,
    dependencies: ["validated_schema_mastersku"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["prd_id"],
    bigquery: {
        partitionBy : "asatdate",
        clusterBy: ["prd_id"]
    },
}

js {
    const project_id = databuffet.DATABASE
    const dataset_id = databuffet.RAW_SCHEMA + "_" + databuffet.SOURCE_MASTERSKU
    const table_id = "product"
    const pk_key = ["prd_id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `BEGIN
    EXECUTE IMMEDIATE 'ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS';
    EXECUTE IMMEDIATE 'ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED';
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  NULLIF(CAST(TRIM(prd_id) AS STRING), '') AS prd_id,
  NULLIF(CAST(TRIM(prd_sku) AS STRING), '') AS prd_sku,
  NULLIF(CAST(TRIM(prd_description) AS STRING), '') AS prd_description,
  NULLIF(CAST(TRIM(prd_d365_sku) AS STRING), '') AS prd_d365_sku,
  NULLIF(CAST(TRIM(prd_item_text) AS STRING), '') AS prd_item_text,
  NULLIF(CAST(TRIM(prd_item_code) AS STRING), '') AS prd_item_code,
  NULLIF(CAST(TRIM(prd_stopped_sate) AS STRING), '') AS prd_stopped_sate,
  NULLIF(CAST(TRIM(prd_made_to_order) AS STRING), '') AS prd_made_to_order,
  NULLIF(CAST(TRIM(prd_sale_unite) AS STRING), '') AS prd_sale_unite,
  NULLIF(CAST(TRIM(prd_tag) AS STRING), '') AS prd_tag,
  NULLIF(CAST(TRIM(prd_universal_barcode) AS STRING), '') AS prd_universal_barcode,
  NULLIF(CAST(TRIM(prd_internal_barcode) AS STRING), '') AS prd_internal_barcode,
  NULLIF(CAST(TRIM(prd_cat_id) AS STRING), '') AS prd_cat_id,
  NULLIF(CAST(TRIM(prd_filter1) AS STRING), '') AS prd_filter1,
  NULLIF(CAST(TRIM(prd_filter2) AS STRING), '') AS prd_filter2,
  NULLIF(CAST(TRIM(prd_brand_id) AS STRING), '') AS prd_brand_id,
  NULLIF(CAST(TRIM(prd_size) AS STRING), '') AS prd_size,
  NULLIF(CAST(TRIM(prd_line) AS STRING), '') AS prd_line,
  NULLIF(CAST(TRIM(prd_color) AS STRING), '') AS prd_color,
  NULLIF(CAST(TRIM(prd_model) AS STRING), '') AS prd_model,
  NULLIF(CAST(TRIM(prd_dimension1) AS STRING), '') AS prd_dimension1,
  NULLIF(CAST(TRIM(prd_dimension2) AS STRING), '') AS prd_dimension2,
  NULLIF(CAST(TRIM(prd_dimension3) AS STRING), '') AS prd_dimension3,
  NULLIF(CAST(TRIM(prd_dimension4) AS STRING), '') AS prd_dimension4,
  NULLIF(CAST(TRIM(prd_vendor_id) AS STRING), '') AS prd_vendor_id,
  CAST(prd_is_active AS BOOL) AS prd_is_active,
  CAST(prd_is_use AS BOOL) AS prd_is_use,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(prd_created_date, 1, 19)) AS prd_created_date,
  NULLIF(CAST(TRIM(prd_created_by) AS STRING), '') AS prd_created_by,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(prd_updated_date, 1, 19)) AS prd_updated_date,
  NULLIF(CAST(TRIM(prd_updated_by) AS STRING), '') AS prd_updated_by,
  NULLIF(CAST(TRIM(prd_pg_id) AS STRING), '') AS prd_pg_id,
  NULLIF(CAST(TRIM(prd_ps_id) AS STRING), '') AS prd_ps_id,
  NULLIF(CAST(TRIM(prd_id_source) AS STRING), '') AS prd_id_source,
  NULLIF(CAST(TRIM(prd_mc_id) AS STRING), '') AS prd_mc_id,
  NULLIF(CAST(TRIM(prd_diminsion_data) AS STRING), '') AS prd_diminsion_data,
  NULLIF(CAST(TRIM(prd_pas_id) AS STRING), '') AS prd_pas_id,
  NULLIF(CAST(TRIM(prd_barcode) AS STRING), '') AS prd_barcode,
  NULLIF(CAST(TRIM(prd_reject_remark) AS STRING), '') AS prd_reject_remark,
  NULLIF(CAST(TRIM(prd_ref_mp_id) AS STRING), '') AS prd_ref_mp_id,
  CAST(prd_is_combo AS BOOL) AS prd_is_combo,
  CAST(prd_combo_price AS FLOAT64) AS prd_combo_price,
  CAST(prd_is_time AS BOOL) AS prd_is_time,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(prd_combo_start, 1, 19)) AS prd_combo_start,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(prd_combo_end, 1, 19)) AS prd_combo_end,
  CAST(prd_total_combo_price AS FLOAT64) AS prd_total_combo_price,
  CAST(prd_total_cost_combo_price AS FLOAT64) AS prd_total_cost_combo_price,
  NULLIF(CAST(TRIM(prd_barcode_format) AS STRING), '') AS prd_barcode_format,
  PARSE_DATE('%Y%m%d', ASATDATE) AS asatdate,
FROM
  `${project_id}.${dataset_id}.${table_id}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
