config {
    type: "incremental",
    schema: databuffet.VALIDATED_MASTERSKU,
    dependencies: ["validated_schema_mastersku", "create_all_table_raw_mastersku"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["prd_id"],
    bigquery: {
        partitionBy : "asatdate",
        clusterBy: ["prd_id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MASTERSKU,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["prd_id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  ${databuffet.functionData.cleanString('prd_id')} AS prd_id,
  ${databuffet.functionData.cleanString('prd_sku')} AS prd_sku,
  ${databuffet.functionData.cleanString('prd_description')} AS prd_description,
  ${databuffet.functionData.cleanString('prd_d365_sku')} AS prd_d365_sku,
  ${databuffet.functionData.cleanString('prd_item_text')} AS prd_item_text,
  ${databuffet.functionData.cleanString('prd_item_code')} AS prd_item_code,
  ${databuffet.functionData.cleanString('prd_stopped_sate')} AS prd_stopped_sate,
  ${databuffet.functionData.cleanString('prd_made_to_order')} AS prd_made_to_order,
  ${databuffet.functionData.cleanString('prd_sale_unite')} AS prd_sale_unite,
  ${databuffet.functionData.cleanString('prd_tag')} AS prd_tag,
  ${databuffet.functionData.cleanString('prd_universal_barcode')} AS prd_universal_barcode,
  ${databuffet.functionData.cleanString('prd_internal_barcode')} AS prd_internal_barcode,
  ${databuffet.functionData.cleanString('prd_cat_id')} AS prd_cat_id,
  ${databuffet.functionData.cleanString('prd_filter1')} AS prd_filter1,
  ${databuffet.functionData.cleanString('prd_filter2')} AS prd_filter2,
  ${databuffet.functionData.cleanString('prd_brand_id')} AS prd_brand_id,
  ${databuffet.functionData.cleanString('prd_size')} AS prd_size,
  ${databuffet.functionData.cleanString('prd_line')} AS prd_line,
  ${databuffet.functionData.cleanString('prd_color')} AS prd_color,
  ${databuffet.functionData.cleanString('prd_model')} AS prd_model,
  ${databuffet.functionData.cleanString('prd_dimension1')} AS prd_dimension1,
  ${databuffet.functionData.cleanString('prd_dimension2')} AS prd_dimension2,
  ${databuffet.functionData.cleanString('prd_dimension3')} AS prd_dimension3,
  ${databuffet.functionData.cleanString('prd_dimension4')} AS prd_dimension4,
  ${databuffet.functionData.cleanString('prd_vendor_id')} AS prd_vendor_id,
  ${databuffet.functionData.castBool('prd_is_active')} AS prd_is_active,
  ${databuffet.functionData.castBool('prd_is_use')} AS prd_is_use,
  ${databuffet.functionData.parseFlexibleDatetime('prd_created_date')} AS prd_created_date,
  ${databuffet.functionData.cleanString('prd_created_by')} AS prd_created_by,
  ${databuffet.functionData.parseFlexibleDatetime('prd_updated_date')} AS prd_updated_date,
  ${databuffet.functionData.cleanString('prd_updated_by')} AS prd_updated_by,
  ${databuffet.functionData.cleanString('prd_pg_id')} AS prd_pg_id,
  ${databuffet.functionData.cleanString('prd_ps_id')} AS prd_ps_id,
  ${databuffet.functionData.cleanString('prd_id_source')} AS prd_id_source,
  ${databuffet.functionData.cleanString('prd_mc_id')} AS prd_mc_id,
  ${databuffet.functionData.cleanString('prd_diminsion_data')} AS prd_diminsion_data,
  ${databuffet.functionData.cleanString('prd_pas_id')} AS prd_pas_id,
  ${databuffet.functionData.cleanString('prd_barcode')} AS prd_barcode,
  ${databuffet.functionData.cleanString('prd_reject_remark')} AS prd_reject_remark,
  ${databuffet.functionData.cleanString('prd_ref_mp_id')} AS prd_ref_mp_id,
  ${databuffet.functionData.castBool('prd_is_combo')} AS prd_is_combo,
  ${databuffet.functionData.castFloat64('prd_combo_price')} AS prd_combo_price,
  ${databuffet.functionData.castBool('prd_is_time')} AS prd_is_time,
  ${databuffet.functionData.parseFlexibleDatetime('prd_combo_start')} AS prd_combo_start,
  ${databuffet.functionData.parseFlexibleDatetime('prd_combo_end')} AS prd_combo_end,
  ${databuffet.functionData.castFloat64('prd_total_combo_price')} AS prd_total_combo_price,
  ${databuffet.functionData.castFloat64('prd_total_cost_combo_price')} AS prd_total_cost_combo_price,
  ${databuffet.functionData.cleanString('prd_barcode_format')} AS prd_barcode_format,
  ${databuffet.functionData.parseAsatDate()} AS asatdate,
FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE(\'Asia/Bangkok\'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
