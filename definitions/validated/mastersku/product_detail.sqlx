config {
    type: "incremental",
    schema: databuffet.VALIDATED_MASTERSKU,
    dependencies: ["validated_schema_mastersku", "create_all_table_raw_mastersku"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["pd_id"],
    bigquery: {
        partitionBy : "asatdate",
        clusterBy: ["pd_id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MASTERSKU,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["pd_id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  ${databuffet.cleanString('pd_id')} AS pd_id,
  ${databuffet.cleanString('pd_prd_id')} AS pd_prd_id,
  ${databuffet.cleanString('pd_url_video')} AS pd_url_video,
  ${databuffet.cleanString('pd_detail')} AS pd_detail,
  ${databuffet.cleanString('pd_series')} AS pd_series,
  ${databuffet.cleanString('pd_model')} AS pd_model,
  ${databuffet.cleanString('pd_material')} AS pd_material,
  ${databuffet.cleanString('pd_certificate')} AS pd_certificate,
  ${databuffet.cleanString('pd_garantee')} AS pd_garantee,
  ${databuffet.cleanString('pd_garantee_detail')} AS pd_garantee_detail,
  ${databuffet.cleanString('pd_shape')} AS pd_shape,
  ${databuffet.cleanString('pd_supplier_country')} AS pd_supplier_country,
  ${databuffet.castFloat64('pd_package_wide')} AS pd_package_wide,
  ${databuffet.castFloat64('pd_package_long')} AS pd_package_long,
  ${databuffet.castFloat64('pd_package_hight')} AS pd_package_hight,
  ${databuffet.castFloat64('pd_size_wide')} AS pd_size_wide,
  ${databuffet.castFloat64('pd_size_long')} AS pd_size_long,
  ${databuffet.cleanString('pd_sl_id')} AS pd_sl_id,
  ${databuffet.castFloat64('pd_size_hight')} AS pd_size_hight,
  ${databuffet.cleanString('pd_sh_id')} AS pd_sh_id,
  ${databuffet.castFloat64('pd_net_weight')} AS pd_net_weight,
  ${databuffet.castFloat64('pd_gross_weight')} AS pd_gross_weight,
  ${databuffet.cleanString('pd_uw_id')} AS pd_uw_id,
  ${databuffet.cleanString('pd_ul_id')} AS pd_ul_id,
  ${databuffet.cleanString('pd_uh_id')} AS pd_uh_id,
  ${databuffet.cleanString('pd_sw_id')} AS pd_sw_id,
  ${databuffet.cleanString('pd_net_unit_id')} AS pd_net_unit_id,
  ${databuffet.cleanString('pd_gross_unit_id')} AS pd_gross_unit_id,
  ${databuffet.cleanString('pd_how_to')} AS pd_how_to,
  ${databuffet.cleanString('pd_how_to_url')} AS pd_how_to_url,
  ${databuffet.cleanString('pd_how_to_path')} AS pd_how_to_path,
  ${databuffet.cleanString('pd_suggest')} AS pd_suggest,
  ${databuffet.cleanString('pd_suggest_url')} AS pd_suggest_url,
  ${databuffet.cleanString('pd_suggest_path')} AS pd_suggest_path,
  ${databuffet.cleanString('pd_caution')} AS pd_caution,
  ${databuffet.cleanString('pd_caution_url')} AS pd_caution_url,
  ${databuffet.cleanString('pd_caution_path')} AS pd_caution_path,
  ${databuffet.cleanString('pd_file_name')} AS pd_file_name,
  ${databuffet.cleanString('pd_file_path')} AS pd_file_path,
  CAST(pd_is_system AS BOOL) AS pd_is_system,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(pd_created_date, 1, 19)) AS pd_created_date,
  ${databuffet.cleanString('pd_created_by')} AS pd_created_by,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(pd_updated_date, 1, 19)) AS pd_updated_date,
  ${databuffet.cleanString('pd_updated_by')} AS pd_updated_by,
  ${databuffet.cleanString('pd_product_name')} AS pd_product_name,
  ${databuffet.cleanString('pd_vendor_code')} AS pd_vendor_code,
  ${databuffet.cleanString('pd_barcode')} AS pd_barcode,
  ${databuffet.cleanString('pd_sale_unit')} AS pd_sale_unit,
  ${databuffet.cleanString('pd_spacific_fields')} AS pd_spacific_fields,
  ${databuffet.cleanString('pd_remark_inactive')} AS pd_remark_inactive,
  ${databuffet.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
