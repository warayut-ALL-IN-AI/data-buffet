config {
    type: "incremental",
    schema: databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MASTERSKU,
    dependencies: [...databuffet.dependencies[databuffet.VALIDATED_SCHEMA + "_" + databuffet.SOURCE_MASTERSKU]],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: [...databuffet.primaryKeys[databuffet.SOURCE_MASTERSKU]["product_detail"]],
    bigquery: {
        clusterBy: []
    },
}

js {
    const project_id = databuffet.DATABASE
    const dataset_id = databuffet.RAW_SCHEMA + "_" + databuffet.SOURCE_MASTERSKU
    const table_id = name()
    const pk_key = databuffet.primaryKeys[databuffet.SOURCE_MASTERSKU]["product_detail"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY ASATDATE DESC) = 1`;
        post_operations_statement = `ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
    ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  CAST(TRIM(pd_id) AS STRING) AS pd_id,
  CAST(TRIM(pd_prd_id) AS STRING) AS pd_prd_id,
  CAST(TRIM(pd_url_video) AS STRING) AS pd_url_video,
  CAST(TRIM(pd_detail) AS STRING) AS pd_detail,
  CAST(TRIM(pd_series) AS STRING) AS pd_series,
  CAST(TRIM(pd_model) AS STRING) AS pd_model,
  CAST(TRIM(pd_material) AS STRING) AS pd_material,
  CAST(TRIM(pd_certificate) AS STRING) AS pd_certificate,
  CAST(TRIM(pd_garantee) AS STRING) AS pd_garantee,
  CAST(TRIM(pd_garantee_detail) AS STRING) AS pd_garantee_detail,
  CAST(TRIM(pd_shape) AS STRING) AS pd_shape,
  CAST(TRIM(pd_supplier_country) AS STRING) AS pd_supplier_country,
  CAST(pd_package_wide AS FLOAT64) AS pd_package_wide,
  CAST(pd_package_long AS FLOAT64) AS pd_package_long,
  CAST(pd_package_hight AS FLOAT64) AS pd_package_hight,
  CAST(pd_size_wide AS FLOAT64) AS pd_size_wide,
  CAST(pd_size_long AS FLOAT64) AS pd_size_long,
  CAST(TRIM(pd_sl_id) AS STRING) AS pd_sl_id,
  CAST(pd_size_hight AS FLOAT64) AS pd_size_hight,
  CAST(TRIM(pd_sh_id) AS STRING) AS pd_sh_id,
  CAST(pd_net_weight AS FLOAT64) AS pd_net_weight,
  CAST(pd_gross_weight AS FLOAT64) AS pd_gross_weight,
  CAST(TRIM(pd_uw_id) AS STRING) AS pd_uw_id,
  CAST(TRIM(pd_ul_id) AS STRING) AS pd_ul_id,
  CAST(TRIM(pd_uh_id) AS STRING) AS pd_uh_id,
  CAST(TRIM(pd_sw_id) AS STRING) AS pd_sw_id,
  CAST(TRIM(pd_net_unit_id) AS STRING) AS pd_net_unit_id,
  CAST(TRIM(pd_gross_unit_id) AS STRING) AS pd_gross_unit_id,
  CAST(TRIM(pd_how_to) AS STRING) AS pd_how_to,
  CAST(TRIM(pd_how_to_url) AS STRING) AS pd_how_to_url,
  CAST(TRIM(pd_how_to_path) AS STRING) AS pd_how_to_path,
  CAST(TRIM(pd_suggest) AS STRING) AS pd_suggest,
  CAST(TRIM(pd_suggest_url) AS STRING) AS pd_suggest_url,
  CAST(TRIM(pd_suggest_path) AS STRING) AS pd_suggest_path,
  CAST(TRIM(pd_caution) AS STRING) AS pd_caution,
  CAST(TRIM(pd_caution_url) AS STRING) AS pd_caution_url,
  CAST(TRIM(pd_caution_path) AS STRING) AS pd_caution_path,
  CAST(TRIM(pd_file_name) AS STRING) AS pd_file_name,
  CAST(TRIM(pd_file_path) AS STRING) AS pd_file_path,
  CAST(pd_is_system AS BOOL) AS pd_is_system,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(pd_created_date, 1, 19)) AS pd_created_date,
  CAST(TRIM(pd_created_by) AS STRING) AS pd_created_by,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(pd_updated_date, 1, 19)) AS pd_updated_date,
  CAST(TRIM(pd_updated_by) AS STRING) AS pd_updated_by,
  CAST(TRIM(pd_product_name) AS STRING) AS pd_product_name,
  CAST(TRIM(pd_vendor_code) AS STRING) AS pd_vendor_code,
  CAST(TRIM(pd_barcode) AS STRING) AS pd_barcode,
  CAST(TRIM(pd_sale_unit) AS STRING) AS pd_sale_unit,
  CAST(TRIM(pd_spacific_fields) AS STRING) AS pd_spacific_fields,
  CAST(TRIM(pd_remark_inactive) AS STRING) AS pd_remark_inactive,
  PARSE_DATE('%Y%m%d', ASATDATE) AS asatdate,

FROM
  `${project_id}.${dataset_id}.${table_id}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
