config {
    type: "incremental",
    schema: databuffet.VALIDATED_MASTERSKU,
    dependencies: ["validated_schema_mastersku", "create_all_table_raw_mastersku"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["vd_id"],
    bigquery: {
        partitionBy : "asatdate",
        clusterBy: ["vd_id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MASTERSKU,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["vd_id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  ${databuffet.cleanString('vd_id')} AS vd_id,
  ${databuffet.cleanString('vd_api_id')} AS vd_api_id,
  ${databuffet.cleanString('vd_code')} AS vd_code,
  ${databuffet.cleanString('vd_name')} AS vd_name,
  ${databuffet.cleanString('vd_coporate_no')} AS vd_coporate_no,
  ${databuffet.cleanString('vd_tel')} AS vd_tel,
  ${databuffet.cleanString('vd_country_name')} AS vd_country_name,
  ${databuffet.cleanString('vd_province_name')} AS vd_province_name,
  ${databuffet.cleanString('vd_district_name')} AS vd_district_name,
  ${databuffet.cleanString('vd_sub_district_name')} AS vd_sub_district_name,
  ${databuffet.cleanString('vd_zipcode')} AS vd_zipcode,
  ${databuffet.cleanString('vd_email')} AS vd_email,
  ${databuffet.cleanString('vd_address')} AS vd_address,
  ${databuffet.cleanString('vd_organize_name')} AS vd_organize_name,
  ${databuffet.cleanString('vd_business_type_name')} AS vd_business_type_name,
  ${databuffet.cleanString('vd_document_id')} AS vd_document_id,
  ${databuffet.cleanString('vd_document_path')} AS vd_document_path,
  CAST(vd_is_dbd AS BOOL) AS vd_is_dbd,
  ${databuffet.cleanString('vd_account_type')} AS vd_account_type,
  ${databuffet.cleanString('vd_kyc_status')} AS vd_kyc_status,
  CAST(vd_is_active AS BOOL) AS vd_is_active,
  CAST(vd_is_use AS BOOL) AS vd_is_use,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(vd_created_date, 1, 19)) AS vd_created_date,
  PARSE_DATETIME('%Y-%m-%d %H:%M:%S', SUBSTR(vd_updated_date, 1, 19)) AS vd_updated_date,
  ${databuffet.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
