config {
    type: "incremental",
    schema: databuffet.VALIDATED_MASTERSKU,
    dependencies: ["validated_schema_mastersku", "create_all_table_raw_mastersku"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["bra_id"],
    bigquery: {
        partitionBy : "asatdate",
        clusterBy: ["bra_id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MASTERSKU,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["bra_id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  ${databuffet.functionData.cleanString('bra_id')} AS bra_id,
  ${databuffet.functionData.cleanString('bra_name')} AS bra_name,
  ${databuffet.functionData.cleanString('bra_name_th')} AS bra_name_th,
  ${databuffet.functionData.cleanString('bra_detail')} AS bra_detail,
  ${databuffet.functionData.cleanString('bra_vendor_id')} AS bra_vendor_id,
  ${databuffet.functionData.cleanString('bra_logo_name')} AS bra_logo_name,
  ${databuffet.functionData.cleanString('bra_logo_path')} AS bra_logo_path,
  CAST(bra_is_use AS BOOL) AS bra_is_use,
  CAST(bra_is_active AS BOOL) AS bra_is_active,
  ${databuffet.functionData.parseFlexibleDatetime('bra_created_date')} AS bra_created_date,
  ${databuffet.functionData.cleanString('bra_created_by')} AS bra_created_by,
  ${databuffet.functionData.parseFlexibleDatetime('bra_updated_date')} AS bra_updated_date,
  ${databuffet.functionData.cleanString('bra_updated_by')} AS bra_updated_by,
  ${databuffet.functionData.parseAsatDate()} AS asatdate,
FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", CURRENT_DATE(\'Asia/Bangkok\')-1)`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
